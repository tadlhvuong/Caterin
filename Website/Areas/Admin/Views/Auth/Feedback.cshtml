@using Shared.Enums
@using Website.Areas.Admin.Models
@model FeedbackViewModel

@{
    ViewData["Title"] = Model.Title;

    var (color, icon) = Model.Type switch
    {
        FeedbackType.Success => ("success", "fas fa-check-circle"),
        FeedbackType.Danger => ("danger", "fas fa-times-circle"),
        FeedbackType.Warning => ("warning", "fas fa-exclamation-triangle"),
        _ => ("info", "fas fa-info-circle")
    };
}

<div class="text-center">
    <h3 class="text-@color">
        <i class="@icon"></i>
        <b>@Model.Title</b>
    </h3>

    <p class="mb-6">@Model.Message</p>

    <a href="@Model.ButtonUrl"
       class="btn btn-primary">
        @Model.ButtonText
    </a>

    @if (!string.IsNullOrWhiteSpace(Model.SecondaryButtonUrl))
    {
        <a href="@Model.SecondaryButtonUrl"
           class="btn btn-outline-secondary ms-2">
            @Model.SecondaryButtonText
        </a>
    }
</div>