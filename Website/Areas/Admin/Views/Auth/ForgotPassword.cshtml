@using Website.Areas.Admin.Models
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<h4 class="mb-1">Quên mật khẩu? 🔒</h4>
<p class="mb-6">Nhập địa chỉ email của bạn và chúng tôi sẽ gửi hướng dẫn để bạn đặt lại mật khẩu.</p>
<form href="/admin/auth/forgot-password" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <div class="mb-6">
        <label for="email" class="form-label">Email</label>
        <input type="text" asp-for="Email" class="form-control" placeholder="email" autofocus />
    </div>
    <button class="btn btn-primary d-grid w-100 mb-6 waves-effect waves-light">Gửi</button>
</form>
<div class="text-center">
    <a href="/admin/auth/login" class="d-flex justify-content-center">
        <i class="ti ti-chevron-left scaleX-n1-rtl me-1_5"></i>
        Quay lại
    </a>
</div>