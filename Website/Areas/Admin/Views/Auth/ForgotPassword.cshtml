@using Website.Areas.Admin.Models
@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}
<h4 class="mb-1">Quên mật khẩu? 🔒</h4>
<p class="mb-6">Nhập địa chỉ email của bạn và chúng tôi sẽ gửi hướng dẫn để bạn đặt lại mật khẩu.</p>
<form id="forgotPasswordForm" asp-controller="Auth" asp-action="ForgotPassword" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <div class="mb-6">
        <label for="email" class="form-label">Email</label>
        <input type="text" asp-for="Email" class="form-control" placeholder="email" autofocus />
    </div>
    <button id="btnSubmit" class="btn btn-primary w-100">Gửi</button>
</form>
<div class="text-center">
    <a href="/admin/auth/login" class="d-flex justify-content-center">
        <i class="ti ti-chevron-left scaleX-n1-rtl me-1_5"></i>
        Quay lại
    </a>
</div>

@section Scripts {
    <script>
        document.getElementById("forgotPasswordForm").addEventListener("submit", function () {
            const btn = document.getElementById("btnSubmit");

            btn.disabled = true;
                    btn.innerHTML = btn.innerHTML = `
        <span class="d-flex align-items-center justify-content-center">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            <span>Đang gửi...</span>
        </span>`;
        });
    </script>
}