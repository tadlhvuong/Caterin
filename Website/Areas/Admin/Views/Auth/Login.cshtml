@using Website.Areas.Admin.Models
@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

@section Styles {
    <style type="text/css">
        .validation-summary-errors {
            color: red;
        }
    </style>
}

<h4 class="mb-1">Trang quản trị CATERIN! 👋</h4>
<p class="mb-6">Đăng nhập tài khoản có quyền hạn quản lý</p>

<form id="loginForm" class="mb-4" asp-controller="Auth" asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-6">
        <label asp-for="Email" class="form-label">Email or Username</label>
        <input type="text"
               class="form-control"
               asp-for="Email"
               placeholder="Nhập email"
               autofocus />
    </div>
    <div class="mb-6 form-password-toggle">
        <label class="form-label" asp-for="Password">Password</label>
        <div class="input-group input-group-merge">
            <input type="password"
                   asp-for="Password"
                   class="form-control"
                   placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                   aria-describedby="password" />
            <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
        </div>
    </div>
    <div class="my-8">
        <div class="d-flex justify-content-between">
            <div class="form-check mb-0 ms-2">
                <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                <label class="form-check-label" asp-for="RememberMe"> Remember Me </label>
            </div>
            <a asp-area="Admin" asp-controller="Auth" asp-action="ForgotPassword">
                <p class="mb-0">Quên mật khẩu?</p>
            </a>
        </div>
    </div>
    <div class="mb-6">
        <button id="btnLogin" class="btn btn-primary w-100" type="submit">Đăng nhập</button>
    </div>
</form>

<p class="text-center">
    <span>Bạn chưa có tài khoản?</span>
    <a href="/admin/auth/register">
        <span>Tạo tài khoản mới</span>
    </a>
</p>

<div class="divider my-6">
    <div class="divider-text">or</div>
</div>
@await Html.PartialAsync("_LoginEx", new ExternalLoginListViewModel { ReturnUrl = ViewBag.ReturnUrl, RememberMe = Model.RememberMe })

        @section Scripts{
            <script>
                               document.getElementById("loginForm").addEventListener("submit", function () {
            const btn = document.getElementById("btnLogin");

            btn.disabled = true;
                    btn.innerHTML = `
        <span class="d-flex align-items-center justify-content-center">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            <span>Đang đăng nhập...</span>
        </span>`;
        });

                        document.addEventListener("DOMContentLoaded", function () {
            const rememberMe = document.getElementById("RememberMe");
                const facebookRememberMe = document.getElementById("facebookRememberMe");
        const googleRememberMe = document.getElementById("googleRememberMe");

        function syncRememberMe() {
            facebookRememberMe.value = rememberMe.checked;
            googleRememberMe.value = rememberMe.checked;
        }

            // Giá trị ban đầu
            syncRememberMe();

            // Khi người dùng thay đổi checkbox
            rememberMe.addEventListener("change", syncRememberMe);
        });
            </script>
        }