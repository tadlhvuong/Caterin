@using Website.Areas.Admin.Models
@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}
@section Styles {
    <style type="text/css">
        .validation-summary-errors {
            color: red;
        }
    </style>
}
<div class="card-body">
    <p class="login-box-msg" >Đổi mật khẩu</p>
    <form asp-area="Admin" asp-controller="Auth" asp-action="ResetPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All"></div>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />
        @* <div class="input-group mb-3">
            <input asp-for="Password" type="password" class="form-control" placeholder="mật khẩu">
            <div class="input-group-append">
                <div class="input-group-text">
                    <span class="fas fa-lock"></span>
                </div>
            </div>
        </div>
        <div class="input-group mb-3">
            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu">
            <div class="input-group-append">
                <div class="input-group-text">
                    <span class="fas fa-lock"></span>
                </div>
            </div>
        </div> *@
        <div class="mb-6 form-password-toggle">
            <label class="form-label" asp-for="Password">Mật khẩu mới</label>
            <div class="input-group input-group-merge">
                <input type="password"
                       asp-for="Password"
                       class="form-control"
                       placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                       aria-describedby="password" />
                <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
            </div>
        </div>
        <div class="mb-6 form-password-toggle">
            <label class="form-label" asp-for="Password">Nhập lại mật khẩu mới</label>
            <div class="input-group input-group-merge">
                <input type="password"
                       asp-for="ConfirmPassword"
                       class="form-control"
                       placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                       aria-describedby="password" />
                <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <button type="submit" class="btn btn-primary btn-block" >Đổi mật khẩu</button>
            </div>
        </div>
    </form>

    <p class="mt-3 mb-1">
        <a href="/admin/auth/login">Đăng nhập</a>
    </p>
</div>