@using Website.Areas.Admin.Models
@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    <style>
        .validation-summary-errors,
        .field-validation-error {
            color: red;
        }
    </style>
}

<div class="card-body">
    <p class="login-box-msg">Đặt lại mật khẩu</p>

    <form asp-area="Admin"
          asp-controller="Auth"
          asp-action="ResetPassword"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <input asp-for="Key" type="hidden" />

        <div class="mb-6 form-password-toggle">
            <label class="form-label" asp-for="Password">
                Mật khẩu mới
            </label>

            <div class="input-group input-group-merge">
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Nhập mật khẩu mới"
                       autocomplete="new-password" />

                <span class="input-group-text cursor-pointer">
                    <i class="ti ti-eye-off"></i>
                </span>
            </div>

            <span asp-validation-for="Password"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-6 form-password-toggle">
            <label class="form-label" asp-for="ConfirmPassword">
                Nhập lại mật khẩu mới
            </label>

            <div class="input-group input-group-merge">
                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control"
                       placeholder="Nhập lại mật khẩu mới"
                       autocomplete="new-password" />

                <span class="input-group-text cursor-pointer">
                    <i class="ti ti-eye-off"></i>
                </span>
            </div>

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="row">
            <div class="col-12">
                <button type="submit"
                        class="btn btn-primary btn-block">
                    Đặt lại mật khẩu
                </button>
            </div>
        </div>
    </form>

    <p class="mt-3 mb-1">
        <a asp-area="Admin"
           asp-controller="Auth"
           asp-action="Login">
            Đăng nhập
        </a>
    </p>
</div>