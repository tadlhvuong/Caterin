@using Website.Areas.Admin.Models
@model ChatWorkspaceViewModel

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/css/hk.chat-workspace.css" />
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="app-chat card overflow-hidden" id="chatWorkspace" data-inbox-id="@Model.InboxId">

        <div class="chat-workspace">

            <!-- =====================================================
                 FILTER SIDEBAR
            ====================================================== -->
            <partial name="_MessageSidebar" />

            <!-- =====================================================
                 MAIN CONTENT
            ====================================================== -->
            <main class="chat-main" id="chatMain">

                <!-- =================================================
                     CONVERSATION LIST
                ================================================== -->
                <section class="conversation-panel"
                         id="conversationPanel">

                    <div class="conversation-header border-bottom">

                        <div class="d-flex align-items-center">

                            <button type="button"
                                    class="btn btn-icon btn-text-secondary rounded-pill d-lg-none me-2"
                                    id="openChatFilters">
                                <i class="ti ti-menu-2"></i>
                            </button>

                            <div>
                                <h5 class="mb-0">
                                    All Conversations
                                </h5>

                                <small class="text-muted"
                                       id="conversationTotal">
                                    12 conversations
                                </small>
                            </div>

                        </div>

                        <div class="d-flex align-items-center">

                            <button type="button"
                                    class="btn btn-icon btn-text-secondary rounded-pill"
                                    id="refreshConversations">
                                <i class="ti ti-refresh"></i>
                            </button>

                            <div class="dropdown ms-1">

                                <button class="btn btn-icon btn-text-secondary rounded-pill"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <i class="ti ti-dots-vertical"></i>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <button class="dropdown-item">
                                            Mark all as read
                                        </button>
                                    </li>

                                    <li>
                                        <button class="dropdown-item">
                                            Archive all
                                        </button>
                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>

                    @* <partial name="_ConversationList" /> *@

                    <div id="conversationList"
                         class="conversation-list"
                         data-perfect-scrollbar>
                    </div>
                </section>

                <!-- =================================================
                     CHAT DETAIL
                ================================================== -->
                <partial name="_MessageDetails"></partial>

            </main>

            <partial name="_ContactDrawer"></partial>
            <div class="chat-workspace-overlay" id="chatWorkspaceOverlay"></div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/admin/assets/js/core/hk.chat-workspace.js"></script>
}