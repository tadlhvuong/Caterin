@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@section Styles {
    <link rel="stylesheet" href="~/admin/assets/css/hk.chat-workspace.css" />
}

<div class="container-xxl flex-grow-1 container-p-y">

    <div class="app-chat card overflow-hidden" id="chatWorkspace" data-inbox-id="@Model.InboxId">

        <div class="chat-workspace">

            <!-- =====================================================
                 FILTER SIDEBAR
            ====================================================== -->
            <aside class="chat-filter-sidebar border-end"
                   id="chatFilterSidebar">

                <div class="chat-filter-header">
                    <h5 class="mb-0">Conversations</h5>

                    <button type="button"
                            class="btn btn-icon btn-text-secondary rounded-pill d-lg-none"
                            id="chatFilterClose">
                        <i class="ti ti-x"></i>
                    </button>
                </div>

                <div class="chat-filter-body">

                    <!-- Search -->
                    <div class="chat-filter-search mb-4">
                        <div class="input-group input-group-merge">
                            <span class="input-group-text">
                                <i class="ti ti-search"></i>
                            </span>

                            <input type="text"
                                   class="form-control"
                                   id="conversationSearch"
                                   placeholder="Search conversations..."
                                   autocomplete="off" />
                        </div>
                    </div>

                    <!-- Inbox -->
                    <div class="chat-filter-section">

                        <div class="chat-filter-title">
                            <span>INBOX</span>
                        </div>

                        <ul class="chat-filter-list">

                            <li class="active"
                                data-filter-type="inbox"
                                data-filter-value="all">

                                <a href="javascript:void(0);">
                                    <i class="ti ti-inbox"></i>

                                    <span>All</span>

                                    <span class="chat-filter-count">
                                        12
                                    </span>
                                </a>
                            </li>

                            <li data-filter-type="inbox"
                                data-filter-value="mine">

                                <a href="javascript:void(0);">
                                    <i class="ti ti-user-check"></i>

                                    <span>Mine</span>

                                    <span class="chat-filter-count">
                                        4
                                    </span>
                                </a>
                            </li>

                            <li data-filter-type="inbox"
                                data-filter-value="unassigned">

                                <a href="javascript:void(0);">
                                    <i class="ti ti-user-x"></i>

                                    <span>Unassigned</span>

                                    <span class="chat-filter-count">
                                        3
                                    </span>
                                </a>
                            </li>

                        </ul>

                    </div>

                    <!-- Status -->
                    <div class="chat-filter-section">

                        <div class="chat-filter-title">
                            <span>STATUS</span>
                        </div>

                        <ul class="chat-filter-list">

                            <li data-filter-type="status"
                                data-filter-value="open">

                                <a href="javascript:void(0);">
                                    <i class="ti ti-message-circle-2"></i>
                                    <span>Open</span>
                                    <span class="chat-filter-count">8</span>
                                </a>
                            </li>

                            <li data-filter-type="status"
                                data-filter-value="pending">

                                <a href="javascript:void(0);">
                                    <i class="ti ti-clock"></i>
                                    <span>Pending</span>
                                    <span class="chat-filter-count">3</span>
                                </a>
                            </li>

                            <li data-filter-type="status"
                                data-filter-value="resolved">

                                <a href="javascript:void(0);">
                                    <i class="ti ti-circle-check"></i>
                                    <span>Resolved</span>
                                </a>
                            </li>

                        </ul>

                    </div>

                    <!-- Labels -->
                    <div class="chat-filter-section">

                        <div class="chat-filter-title d-flex justify-content-between align-items-center">
                            <span>LABELS</span>

                            <button type="button"
                                    class="btn btn-icon btn-text-secondary btn-sm">
                                <i class="ti ti-plus"></i>
                            </button>
                        </div>

                        <ul class="chat-filter-list">

                            <li data-filter-type="label"
                                data-filter-value="new">

                                <a href="javascript:void(0);">
                                    <span class="chat-label-dot bg-success"></span>
                                    <span>New</span>
                                </a>
                            </li>

                            <li data-filter-type="label"
                                data-filter-value="order">

                                <a href="javascript:void(0);">
                                    <span class="chat-label-dot bg-primary"></span>
                                    <span>Order</span>
                                </a>
                            </li>

                            <li data-filter-type="label"
                                data-filter-value="product">

                                <a href="javascript:void(0);">
                                    <span class="chat-label-dot bg-warning"></span>
                                    <span>Product</span>
                                </a>
                            </li>

                            <li data-filter-type="label"
                                data-filter-value="complaint">

                                <a href="javascript:void(0);">
                                    <span class="chat-label-dot bg-danger"></span>
                                    <span>Complaint</span>
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>
            </aside>


            <!-- =====================================================
                 MAIN CONTENT
            ====================================================== -->
            <main class="chat-main" id="chatMain">

                <!-- =================================================
                     CONVERSATION LIST
                ================================================== -->
                <section class="conversation-panel"
                         id="conversationPanel">

                    <div class="conversation-header border-bottom">

                        <div class="d-flex align-items-center">

                            <button type="button"
                                    class="btn btn-icon btn-text-secondary rounded-pill d-lg-none me-2"
                                    id="openChatFilters">
                                <i class="ti ti-menu-2"></i>
                            </button>

                            <div>
                                <h5 class="mb-0">
                                    All Conversations
                                </h5>

                                <small class="text-muted"
                                       id="conversationTotal">
                                    12 conversations
                                </small>
                            </div>

                        </div>

                        <div class="d-flex align-items-center">

                            <button type="button"
                                    class="btn btn-icon btn-text-secondary rounded-pill"
                                    id="refreshConversations">
                                <i class="ti ti-refresh"></i>
                            </button>

                            <div class="dropdown ms-1">

                                <button class="btn btn-icon btn-text-secondary rounded-pill"
                                        type="button"
                                        data-bs-toggle="dropdown">

                                    <i class="ti ti-dots-vertical"></i>

                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>
                                        <button class="dropdown-item">
                                            Mark all as read
                                        </button>
                                    </li>

                                    <li>
                                        <button class="dropdown-item">
                                            Archive all
                                        </button>
                                    </li>

                                </ul>

                            </div>

                        </div>

                    </div>


                    <!-- Conversation List -->
                    <div class="conversation-list"
                         id="conversationList">

                        <!-- Conversation -->
                        <article class="conversation-item active"
                                 data-conversation-id="1"
                                 data-status="open"
                                 data-inbox="mine"
                                 data-label="order">

                            <div class="conversation-avatar">

                                <div class="avatar avatar-sm avatar-online">

                                    <img src="~/admin/assets/img/avatars/4.png"
                                         alt="Nguyễn Văn A"
                                         class="rounded-circle" />

                                </div>

                            </div>

                            <div class="conversation-content">

                                <div class="conversation-top">

                                    <h6 class="conversation-name">
                                        Nguyễn Văn A
                                    </h6>

                                    <time class="conversation-time">
                                        10:32
                                    </time>

                                </div>

                                <div class="conversation-bottom">

                                    <p class="conversation-preview">
                                        Cho mình hỏi đơn hàng này bao giờ giao?
                                    </p>

                                    <span class="conversation-unread">
                                        2
                                    </span>

                                </div>

                                <div class="conversation-meta">

                                    <span class="chat-label badge bg-label-primary">
                                        Order
                                    </span>

                                    <span class="conversation-status">
                                        Open
                                    </span>

                                </div>

                            </div>

                        </article>


                        <article class="conversation-item"
                                 data-conversation-id="2"
                                 data-status="open"
                                 data-inbox="unassigned"
                                 data-label="product">

                            <div class="conversation-avatar">

                                <div class="avatar avatar-sm avatar-online">

                                    <img src="~/admin/assets/img/avatars/5.png"
                                         alt="Trần Thị B"
                                         class="rounded-circle" />

                                </div>

                            </div>

                            <div class="conversation-content">

                                <div class="conversation-top">

                                    <h6 class="conversation-name">
                                        Trần Thị B
                                    </h6>

                                    <time class="conversation-time">
                                        10:18
                                    </time>

                                </div>

                                <div class="conversation-bottom">

                                    <p class="conversation-preview">
                                        Nước rửa chén loại nào thơm nhất vậy shop?
                                    </p>

                                </div>

                                <div class="conversation-meta">

                                    <span class="chat-label badge bg-label-warning">
                                        Product
                                    </span>

                                    <span class="conversation-status">
                                        Open
                                    </span>

                                </div>

                            </div>

                        </article>


                        <article class="conversation-item"
                                 data-conversation-id="3"
                                 data-status="pending"
                                 data-inbox="mine"
                                 data-label="complaint">

                            <div class="conversation-avatar">

                                <div class="avatar avatar-sm">

                                    <span class="avatar-initial rounded-circle bg-label-danger">
                                        LH
                                    </span>

                                </div>

                            </div>

                            <div class="conversation-content">

                                <div class="conversation-top">

                                    <h6 class="conversation-name">
                                        Lê Hoàng
                                    </h6>

                                    <time class="conversation-time">
                                        09:45
                                    </time>

                                </div>

                                <div class="conversation-bottom">

                                    <p class="conversation-preview">
                                        Shop kiểm tra giúp mình đơn hôm qua với.
                                    </p>

                                </div>

                                <div class="conversation-meta">

                                    <span class="chat-label badge bg-label-danger">
                                        Complaint
                                    </span>

                                    <span class="conversation-status">
                                        Pending
                                    </span>

                                </div>

                            </div>

                        </article>


                        <article class="conversation-item"
                                 data-conversation-id="4"
                                 data-status="resolved"
                                 data-inbox="all"
                                 data-label="new">

                            <div class="conversation-avatar">

                                <div class="avatar avatar-sm avatar-offline">

                                    <img src="~/admin/assets/img/avatars/6.png"
                                         alt="Phạm Minh"
                                         class="rounded-circle" />

                                </div>

                            </div>

                            <div class="conversation-content">

                                <div class="conversation-top">

                                    <h6 class="conversation-name">
                                        Phạm Minh
                                    </h6>

                                    <time class="conversation-time">
                                        Yesterday
                                    </time>

                                </div>

                                <div class="conversation-bottom">

                                    <p class="conversation-preview">
                                        Cảm ơn shop nhé!
                                    </p>

                                </div>

                                <div class="conversation-meta">

                                    <span class="chat-label badge bg-label-success">
                                        New
                                    </span>

                                    <span class="conversation-status">
                                        Resolved
                                    </span>

                                </div>

                            </div>

                        </article>

                    </div>

                </section>


                <!-- =================================================
                     CHAT DETAIL
                ================================================== -->
                <section class="chat-detail-panel d-none" id="chatDetailPanel">

                    <div class="chat-history-wrapper">
                        <!-- Header -->
                        <header class="chat-history-header border-bottom">
                            <div class="d-flex align-items-center overflow-hidden">

                                <button type="button"
                                        class="btn btn-icon btn-text-secondary rounded-pill me-2"
                                        id="backToConversations">

                                    <i class="ti ti-arrow-left"></i>

                                </button>

                                <div class="flex-shrink-0 avatar avatar-sm avatar-online">

                                    <img src="~/admin/assets/img/avatars/4.png"
                                         alt="Nguyễn Văn A"
                                         class="rounded-circle" />

                                </div>

                                <div class="chat-contact-info flex-grow-1 ms-3">

                                    <h6 class="m-0 fw-normal"
                                        id="chatContactName">
                                        Nguyễn Văn A
                                    </h6>

                                    <small class="text-muted"
                                           id="chatContactStatus">
                                        Online
                                    </small>

                                </div>

                            </div>


                            <div class="d-flex align-items-center">

                                <button type="button"
                                        class="btn btn-sm btn-text-secondary rounded-pill me-1"
                                        id="chatContactButton">

                                    <i class="ti ti-user-circle me-1"></i>

                                    <span class="d-none d-md-inline">
                                        Contact
                                    </span>

                                </button>

                                <div class="dropdown">

                                    <button class="btn btn-sm btn-icon btn-text-secondary rounded-pill"
                                            data-bs-toggle="dropdown">

                                        <i class="ti ti-dots-vertical"></i>

                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">

                                        <li>
                                            <button class="dropdown-item">
                                                <i class="ti ti-check me-2"></i>
                                                Mark as resolved
                                            </button>
                                        </li>

                                        <li>
                                            <button class="dropdown-item">
                                                <i class="ti ti-clock me-2"></i>
                                                Snooze
                                            </button>
                                        </li>

                                        <li>
                                            <button class="dropdown-item">
                                                <i class="ti ti-user-plus me-2"></i>
                                                Assign conversation
                                            </button>
                                        </li>

                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>

                                        <li>
                                            <button class="dropdown-item text-danger">
                                                <i class="ti ti-trash me-2"></i>
                                                Delete
                                            </button>
                                        </li>

                                    </ul>

                                </div>

                            </div>

                        </header>


                        <!-- Messages -->
                        <div class="chat-history-body"
                             id="chatHistoryBody">

                            <ul class="list-unstyled chat-history" id="chatHistory">
                                <li class="chat-message">
                                    <div class="d-flex overflow-hidden">
                                        <div class="user-avatar flex-shrink-0 me-3">

                                            <div class="avatar avatar-sm">

                                                <img src="~/admin/assets/img/avatars/4.png"
                                                     alt="Avatar"
                                                     class="rounded-circle" />

                                            </div>

                                        </div>

                                        <div class="chat-message-wrapper">

                                            <div class="chat-message-text">

                                                <p class="mb-0">
                                                    Cho mình hỏi đơn hàng này bao giờ giao?
                                                </p>

                                            </div>

                                            <div class="text-muted mt-1">
                                                <small>10:30 AM</small>
                                            </div>

                                        </div>

                                    </div>

                                </li>


                                <li class="chat-message chat-message-right">

                                    <div class="d-flex overflow-hidden">

                                        <div class="chat-message-wrapper">

                                            <div class="chat-message-text">

                                                <p class="mb-0">
                                                    Dạ em kiểm tra đơn hàng giúp anh/chị ngay ạ.
                                                </p>

                                            </div>

                                            <div class="text-end text-muted mt-1">

                                                <i class="ti ti-checks ti-16px text-success me-1"></i>

                                                <small>10:31 AM</small>

                                            </div>

                                        </div>

                                        <div class="user-avatar flex-shrink-0 ms-3">

                                            <div class="avatar avatar-sm">

                                                <img src="~/admin/assets/img/avatars/1.png"
                                                     alt="Avatar"
                                                     class="rounded-circle" />

                                            </div>

                                        </div>

                                    </div>

                                </li>

                            </ul>

                        </div>


                        <!-- Composer -->
                        <footer class="chat-history-footer">

                            <form class="form-send-message d-flex align-items-center"
                                  id="sendMessageForm">

                                <input type="text"
                                       class="form-control message-input border-0 shadow-none"
                                       id="messageInput"
                                       placeholder="Type your message here..."
                                       autocomplete="off" />

                                <div class="message-actions d-flex align-items-center">

                                    <label for="attach-doc"
                                           class="btn btn-sm btn-icon btn-text-secondary rounded-pill">

                                        <i class="ti ti-paperclip"></i>

                                    </label>

                                    <input type="file"
                                           id="attach-doc"
                                           hidden
                                           multiple />

                                    <button type="submit"
                                            class="btn btn-primary send-msg-btn">

                                        <span class="d-none d-md-inline">
                                            Send
                                        </span>

                                        <i class="ti ti-send ms-md-2"></i>

                                    </button>

                                </div>

                            </form>

                        </footer>

                    </div>

                </section>

            </main>


            <!-- =====================================================
                 CONTACT DRAWER
            ====================================================== -->
            <aside class="chat-contact-drawer"
                   id="chatContactDrawer">

                <div class="chat-contact-drawer-header border-bottom">

                    <div>
                        <h5 class="mb-0">
                            Contact
                        </h5>

                        <small class="text-muted">
                            Customer information
                        </small>
                    </div>

                    <button type="button"
                            class="btn btn-icon btn-text-secondary rounded-pill"
                            id="closeContactDrawer">

                        <i class="ti ti-x"></i>

                    </button>

                </div>


                <div class="chat-contact-drawer-body">

                    <!-- Profile -->
                    <div class="contact-profile text-center">

                        <div class="avatar avatar-xl avatar-online mx-auto">

                            <img src="~/admin/assets/img/avatars/4.png"
                                 alt="Nguyễn Văn A"
                                 class="rounded-circle" />

                        </div>

                        <h5 class="mt-3 mb-1">
                            Nguyễn Văn A
                        </h5>

                        <span class="text-muted">
                            Customer
                        </span>

                    </div>


                    <!-- Information -->
                    <div class="contact-section">

                        <p class="contact-section-title">
                            CUSTOMER INFORMATION
                        </p>

                        <ul class="list-unstyled contact-info-list">

                            <li>
                                <i class="ti ti-mail"></i>

                                <div>
                                    <small>Email</small>
                                    <span>nguyenvana@email.com</span>
                                </div>
                            </li>

                            <li>
                                <i class="ti ti-phone"></i>

                                <div>
                                    <small>Phone</small>
                                    <span>0901 234 567</span>
                                </div>
                            </li>

                            <li>
                                <i class="ti ti-calendar"></i>

                                <div>
                                    <small>Customer since</small>
                                    <span>12/06/2026</span>
                                </div>
                            </li>

                        </ul>

                    </div>


                    <!-- Labels -->
                    <div class="contact-section">

                        <div class="d-flex justify-content-between align-items-center">

                            <p class="contact-section-title mb-0">
                                LABELS
                            </p>

                            <button type="button"
                                    class="btn btn-icon btn-sm btn-text-secondary rounded-pill">

                                <i class="ti ti-plus"></i>

                            </button>

                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-3">

                            <span class="badge bg-label-primary">
                                Order
                            </span>

                            <span class="badge bg-label-success">
                                Returning
                            </span>

                        </div>

                    </div>


                    <!-- Orders -->
                    <div class="contact-section">

                        <p class="contact-section-title">
                            RECENT ORDERS
                        </p>

                        <div class="contact-order">

                            <div>
                                <strong>
                                    #CTN-10231
                                </strong>

                                <small>
                                    15/09/2026
                                </small>
                            </div>

                            <span class="badge bg-label-success">
                                Delivered
                            </span>

                        </div>

                        <div class="contact-order">

                            <div>
                                <strong>
                                    #CTN-10192
                                </strong>

                                <small>
                                    10/09/2026
                                </small>
                            </div>

                            <span class="badge bg-label-warning">
                                Shipping
                            </span>

                        </div>

                    </div>


                    <!-- Notes -->
                    <div class="contact-section">

                        <p class="contact-section-title">
                            NOTES
                        </p>

                        <textarea class="form-control"
                                  rows="4"
                                  placeholder="Add customer note..."></textarea>

                    </div>

                </div>

            </aside>


            <div class="chat-workspace-overlay"
                 id="chatWorkspaceOverlay"></div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/admin/assets/js/core/hk.chat-workspace.js"></script>
}