@{
}
<aside class="chat-filter-sidebar border-end"
       id="chatFilterSidebar">

    <div class="chat-filter-header">
        <h5 class="mb-0">Conversations</h5>

        <button type="button"
                class="btn btn-icon btn-text-secondary rounded-pill d-lg-none"
                id="chatFilterClose">
            <i class="ti ti-x"></i>
        </button>
    </div>

    <div class="chat-filter-body" id="chatFilterBody" data-perfect-scrollbar>

        <!-- Search -->
        <div class="chat-filter-search mb-4">
            <div class="input-group input-group-merge">
                <span class="input-group-text">
                    <i class="ti ti-search"></i>
                </span>

                <input type="text"
                       class="form-control"
                       id="conversationSearch"
                       placeholder="Search conversations..."
                       autocomplete="off" />
            </div>
        </div>

        <!-- Inbox -->
        <div class="chat-filter-section">

            <div class="chat-filter-title">
                <span>INBOX</span>
            </div>

            <ul class="chat-filter-list">

                <li class="active"
                    data-filter-type="inbox"
                    data-filter-value="all">

                    <a href="javascript:void(0);">
                        <i class="ti ti-inbox"></i>

                        <span>Tất cả</span>

                        <span class="chat-filter-count">
                            0
                        </span>
                    </a>
                </li>

                <li data-filter-type="inbox"
                    data-filter-value="1">

                    <a href="javascript:void(0);">
                        <i class="ti ti-user-check"></i>

                        <span>Website</span>

                        <span class="chat-filter-count">
                            0
                        </span>
                    </a>
                </li>

                <li data-filter-type="inbox"
                    data-filter-value="2">
                    <a href="javascript:void(0);">
                        <i class="ti ti-user-x"></i>

                        <span>Facebook</span>

                        <span class="chat-filter-count">
                            0
                        </span>
                    </a>
                </li>

            </ul>

        </div>

        <!-- Status -->
        <div class="chat-filter-section">

            <div class="chat-filter-title">
                <span>STATUS</span>
            </div>

            <ul class="chat-filter-list">

                <li data-filter-type="status"
                    data-filter-value="open">

                    <a href="javascript:void(0);">
                        <i class="ti ti-message-circle-2"></i>
                        <span>Open</span>
                        <span class="chat-filter-count" data-status-count="open">0</span>
                    </a>
                </li>

                <li data-filter-type="status"
                    data-filter-value="pending">

                    <a href="javascript:void(0);">
                        <i class="ti ti-clock"></i>
                        <span>Pending</span>
                        <span class="chat-filter-count" data-status-count="pending">0</span>
                    </a>
                </li>

                <li data-filter-type="status"
                    data-filter-value="resolved">

                    <a href="javascript:void(0);">
                        <i class="ti ti-circle-check"></i>
                        <span>Resolved</span>
                        <span class="chat-filter-count"
                                   data-status-count="resolved">0</span>
                    </a>
                </li>

            </ul>

        </div>

        <!-- Labels -->
        <div class="chat-filter-section">

            <div class="chat-filter-title d-flex justify-content-between align-items-center">
                <span>LABELS</span>

                <button type="button"
                        class="btn btn-icon btn-text-secondary btn-sm"
                        id="btn-create-chat-label"
                        title="Thêm label">
                    <i class="ti ti-plus"></i>
                </button>
            </div>

            <ul class="chat-filter-list">

               @*  <li data-filter-type="label"
                    data-filter-value="new">

                    <a href="javascript:void(0);">
                        <span class="chat-label-dot bg-success"></span>
                        <span>New</span>
                    </a>
                </li>

                <li data-filter-type="label"
                    data-filter-value="order">

                    <a href="javascript:void(0);">
                        <span class="chat-label-dot bg-primary"></span>
                        <span>Order</span>
                    </a>
                </li>

                <li data-filter-type="label"
                    data-filter-value="product">

                    <a href="javascript:void(0);">
                        <span class="chat-label-dot bg-warning"></span>
                        <span>Product</span>
                    </a>
                </li>

                <li data-filter-type="label"
                    data-filter-value="complaint">

                    <a href="javascript:void(0);">
                        <span class="chat-label-dot bg-danger"></span>
                        <span>Complaint</span>
                    </a>
                </li>
 *@
            </ul>

        </div>
        <div class="offcanvas offcanvas-end"
             tabindex="-1"
             id="chatLabelOffcanvas"
             aria-labelledby="chatLabelOffcanvasTitle">

            <div class="offcanvas-header py-6">
                <h5 id="chatLabelOffcanvasTitle" class="offcanvas-title">
                    Thêm label
                </h5>

                <button type="button"
                        class="btn-close text-reset"
                        data-bs-dismiss="offcanvas"
                        aria-label="Close"></button>
            </div>

            <div class="offcanvas-body border-top">

                <form class="pt-0"
                      id="form-create-chat-label"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="ChatLabelId"
                           name="Id"
                           value="0" />

                    <!-- Name -->
                    <div class="mb-6">
                        <label class="form-label" for="chat-label-name">
                            Tên label
                        </label>

                        <input type="text"
                               class="form-control"
                               id="chat-label-name"
                               name="Name"
                               maxlength="100"
                               placeholder="Nhập tên label"
                               autocomplete="off"
                               required />

                        <span class="text-danger field-validation-error"
                              data-valmsg-for="Name"></span>
                    </div>

                    <!-- Color -->
                    <div class="mb-6">
                        <label class="form-label" for="chat-label-color">
                            Màu sắc
                        </label>

                        <div class="d-flex align-items-center gap-3">

                            <input type="color"
                                   class="form-control form-control-color"
                                   id="chat-label-color"
                                   name="Color"
                                   value="#7367F0"
                                   title="Chọn màu label" />

                            <input type="text"
                                   class="form-control"
                                   id="chat-label-color-value"
                                   value="#7367F0"
                                   maxlength="50"
                                   placeholder="#7367F0"
                                   autocomplete="off" />

                        </div>
                    </div>

                    <!-- Status -->
                    <div class="mb-6">
                        <div class="form-check form-switch">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="chat-label-is-active"
                                   name="IsActive"
                                   value="true"
                                   checked />

                            <label class="form-check-label"
                                   for="chat-label-is-active">
                                Hoạt động
                            </label>
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="mb-6">
                        <button type="submit"
                                class="btn btn-primary me-sm-3 me-1"
                                id="btn-submit-chat-label">
                            Xác nhận
                        </button>

                        <button type="button"
                                class="btn btn-label-danger"
                                id="btn-reset-chat-label"
                                data-bs-dismiss="offcanvas">
                            Hủy
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</aside>