@{
    ViewData["Title"] = "Danh sách khách hàng";
}
@section Styles {
    <link rel="stylesheet" href="~/admin/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="card mb-6">
        <div class="card-widget-separator-wrapper">
            <div class="card-body card-widget-separator">
                <div class="row gy-4 gy-sm-1">
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-4 pb-sm-0">
                            <div>
                                <p class="mb-1">Tổng khách hàng</p>
                                <h4 class="mb-1">2,845</h4>
                                <p class="mb-0">
                                    <span class="badge bg-label-success">+5.7%</span>
                                    <span class="me-2"> so với tháng trước</span>
                                </p>
                            </div>
                            <span class="avatar me-sm-6">
                                <span class="avatar-initial rounded">
                                    <i class="ti-28px ti ti-user text-heading"></i>
                                </span>
                            </span>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none me-6" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-4 pb-sm-0">
                            <div>
                                <p class="mb-1">Khách hàng mới</p>
                                <h4 class="mb-1">186</h4>
                                <p class="mb-0">
                                    <span class="badge bg-label-success">+12.4%</span><span class="me-2"> trong tháng này</span>
                                </p>
                            </div>
                            <span class="avatar p-2 me-lg-6">
                                <span class="avatar-initial rounded">
                                    <i class="ti-28px ti ti-user-plus text-heading"></i>
                                </span>
                            </span>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start border-end pb-4 pb-sm-0 card-widget-3">
                            <div>
                                <p class="mb-1">Khách mua mới</p>
                                <h4 class="mb-1">1,240</h4>
                                <p class="mb-0">Có mua hàng trong 30 ngày</p>
                            </div>
                            <span class="avatar p-2 me-sm-6">
                                <span class="avatar-initial rounded"><i class="ti-28px ti ti-user-check text-heading"></i></span>
                            </span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <p class="mb-1">Khách quay lại</p>
                                <h4 class="mb-1">684</h4>
                                <p class="mb-0">
                                    <span class="badge bg-label-danger">-3.5%</span>
                                    <span class="me-2"> khách quay lại</span>
                                </p>
                            </div>
                            <span class="avatar p-2">
                                <span class="avatar-initial rounded">
                                    <i class="ti-28px ti ti-user-down text-heading"></i>
                                </span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Product List Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Lọc</h5>
            <div class="d-flex justify-content-between align-items-center row pt-4 gap-6 gap-md-0">
                <div class="col-md-4 customer_status"></div>
                @* <div class="col-md-4 product_category"></div> *@
                @* <div class="col-md-4 product_stock"></div> *@
            </div>
        </div>
        <form id="antiForgeryForm">
            @Html.AntiForgeryToken()
        </form>
        <div class="card-datatable table-responsive">
            <table class="datatables-customers table">
                <thead class="border-top">
                    <tr>
                        <th></th>
                        <th></th>
                        <th>Khách hàng</th>
                        <th>Đơn hàng</th>
                        <th>Tổng chi tiêu</th>
                        <th>Đơn gần nhất</th>
                        <th>Trạng thái</th>
                        <th>Ngày tham gia</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/admin/assets/js/customer/hk.customer-list.js"></script>

    @if (TempData["SuccessMessage"] is string message)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: '@Html.Raw(message)',
                    confirmButtonText: 'OK'
                });
            });
        </script>
    }
}