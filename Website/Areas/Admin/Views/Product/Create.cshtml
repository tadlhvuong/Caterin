@using Shared.Requests.Product
@using Website.Areas.Admin.Models.Product
@model ProductRequest
@{
    ViewData["Title"] = "Tạo sản phẩm";
}

@section styles {
    <link rel="stylesheet" href="~/admin/assets/vendor/css/quill.snow.css" />
    <link rel="stylesheet" href="~/admin/assets/vendor/css/flatpickr.css" />
    <link rel="stylesheet" href="~/admin/assets/vendor/css/tagify.css" />

    <!-- =====================================================
          FILEPOND
      ====================================================== -->

    <link rel="stylesheet" href="https://unpkg.com/filepond@@4/dist/filepond.css">


    <!-- IMAGE PREVIEW -->

    <link rel="stylesheet" href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css">


    <!-- =====================================================
        CROPPER.JS
    ====================================================== -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">

    <link rel="stylesheet" href="~/admin/assets/css/hk.product-add.css">
    <style>
        /* =========================================================
           FILEPOND VALIDATION
           ========================================================= */

        .filepond--root.is-invalid {
            border: 1px solid var(--bs-danger) !important;
            border-radius: .375rem;
        }


        /* =========================================================
           OPTION VALUES / TAGIFY
           ========================================================= */

        .option-values {
            min-height: 38px;
        }

        .tagify {
            width: 100%;
            min-height: 38px;
        }

        .tagify__input {
            min-width: 100px;
        }


        /* =========================================================
           VARIANT TABLE - OPTION CELL
           ========================================================= */

        #product-variants-table .variant-option-cell {
            vertical-align: middle;
        }


        /* =========================================================
           VARIANT OPTION WRAPPER
           ========================================================= */

        #product-variants-table .variant-option-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            gap: 6px;
            text-align: center;
        }


        /* =========================================================
           VARIANT OPTION VALUE
           ========================================================= */

        #product-variants-table .variant-option-value {
            width: 100%;
            text-align: center;
            font-weight: 500;
            line-height: 1.4;
        }


        #product-variants-table .variant-option-value-only {
            width: 100%;
            text-align: center;
        }


        /* =========================================================
           VARIANT OPTION IMAGE CONTAINER
           ========================================================= */

        #product-variants-table .variant-option-image {
            width: 70px;
            margin: 0 auto;
            flex-shrink: 0;
        }


            /* =========================================================
           FILEPOND - VARIANT
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--root {
                width: 70px;
                height: 70px;
                margin: 0 auto;
                font-size: 11px;
            }


            /* =========================================================
           FILEPOND PANEL
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--panel-root {
                border-radius: 8px;
            }


            /* =========================================================
           FILEPOND DROP LABEL
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--drop-label {
                width: 70px;
                height: 70px;
                min-height: 70px;
                font-size: 11px;
                text-align: center;
            }


                #product-variants-table .variant-option-image .filepond--drop-label label {
                    padding: 5px;
                    font-size: 10px;
                    line-height: 1.3;
                    text-align: center;
                }


            /* =========================================================
           FILEPOND LABEL ACTION
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--label-action {
                font-size: 10px;
            }


            /* =========================================================
           FILEPOND IMAGE ITEM
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--item {
                width: 100% !important;
                height: 100% !important;
                min-width: 100% !important;
                min-height: 100% !important;
            }


            /* =========================================================
           FILEPOND IMAGE PREVIEW
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--image-preview-wrapper {
                width: 100%;
                height: 100%;
            }


            #product-variants-table .variant-option-image .filepond--image-preview {
                width: 100%;
                height: 100%;
            }


            /* =========================================================
           HIDE FILE NAME / SIZE / STATUS
           Chỉ áp dụng cho Variant FilePond
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--file-info,
            #product-variants-table .variant-option-image .filepond--file-status,
            #product-variants-table .variant-option-image .filepond--file-status-main,
            #product-variants-table .variant-option-image .filepond--file-status-sub {
                display: none !important;
            }


            /* =========================================================
           FILEPOND REMOVE BUTTON
           ========================================================= */

            .filepond--file-action-button {
                font-size: 12px;
                color: red;
            }


            /* =========================================================
           FILEPOND ROOT INVALID
           ========================================================= */

            #product-variants-table .variant-option-image .filepond--root.is-invalid {
                border: 1px solid var(--bs-danger) !important;
                border-radius: .375rem;
            }

        /* =========================================================
           TAGIFY SORTABLE
           ========================================================= */

        .form-repeater .tagify__tag {
            cursor: grab;
        }

            .form-repeater .tagify__tag:active {
                cursor: grabbing;
            }


            /* Tag đang được kéo */
            .form-repeater .tagify__tag.sortable-ghost {
                opacity: 0.35;
            }


            /* Tag đang được chọn */
            .form-repeater .tagify__tag.sortable-chosen {
                cursor: grabbing;
            }


        /* Container khi đang drag */
        .form-repeater .tagify.tagify-sortable-active {
            cursor: grabbing;
        }


        /* Không ảnh hưởng input của Tagify */
        .form-repeater .tagify__input {
            cursor: text;
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="app-ecommerce">
        <form id="productForm" asp-controller="Product" asp-action="Create" method="post">
            @* @Html.ValidationSummary() *@
            @Html.AntiForgeryToken()
            <!-- Add Product -->
           <partial name="_ProductForm"  model="Model"  />

        </form>
    </div>
</div>

<!-- =========================================================
        CROP MODAL
    ========================================================= -->

<div id="cropModal"
     class="crop-modal">

    <div class="crop-dialog">


        <!-- HEADER -->

        <div class="crop-header">

            <h3 id="cropTitle">
                Chỉnh sửa ảnh  <span></span>
            </h3>


            <button type="button"
                    id="closeCrop"
                    class="crop-close">

                ×

            </button>

        </div>


        <!-- CROP -->

        <div class="crop-area">

            <img id="cropImage"
                 src=""
                 alt="Crop">

        </div>


        <!-- TOOLBAR -->

        <div class="crop-toolbar">


            <button type="button"
                    id="rotateLeft">

                ↶ Xoay trái

            </button>


            <button type="button"
                    id="rotateRight">

                ↷ Xoay phải

            </button>


            <button type="button"
                    id="zoomIn">

                ＋ Zoom

            </button>


            <button type="button"
                    id="zoomOut">

                − Zoom

            </button>


            <button type="button"
                    id="resetCrop">

                Reset

            </button>

        </div>


        <!-- FOOTER -->

        <div class="crop-footer">


            <button type="button"
                    id="cancelCrop"
                    class="btn btn-cancel">

                Hủy

            </button>


            <button type="button"
                    id="saveCrop"
                    class="btn btn-save">

                Lưu thay đổi

            </button>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/admin/assets/vendor/js/quill.js"></script>
    <script src="~/admin/assets/vendor/js/jquery-repeater.min.js"></script>
    <script src="~/admin/assets/vendor/js/flatpickr.min.js"></script>
    <script src="~/admin/assets/vendor/js/tagify.min.js"></script>

    <script src="https://unpkg.com/filepond@@4/dist/filepond.js"></script>


    <script src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.min.js"></script>


    <script src="https://unpkg.com/filepond-plugin-file-validate-size/dist/filepond-plugin-file-validate-size.min.js"></script>


    <script src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.js"></script>


    <script src="https://unpkg.com/filepond-plugin-image-resize/dist/filepond-plugin-image-resize.min.js"></script>


    <script src="https://unpkg.com/filepond-plugin-image-transform/dist/filepond-plugin-image-transform.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/dragsort@@1.3.1/dist/dragsort.js"></script>

    <script src="~/admin/assets/js/product/hk.product-editor.js"></script>
    <script src="~/admin/assets/js/product/hk.product-create.js"></script>
}