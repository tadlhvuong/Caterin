@using AttributeEnity = Shared.Data.Entities.Product.Attribute
@model AttributeEnity
@{
    ViewData["Title"] = "Danh sách danh mục";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="app-ecommerce-category">
        <div class="card">
            <div class="card-datatable table-responsive">
                <table class="datatables-attribute-list table border-top">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Tên</th>
                            <th>Đường dẫn</th>
                            <th>SL Sản phẩm</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <!-- Offcanvas to add new customer -->
        <div class="offcanvas offcanvas-end"
             tabindex="-1"
             id="offcanvasAttributeList"
             aria-labelledby="offcanvasAttributeListLabel">
            <!-- Offcanvas Header -->
            <div class="offcanvas-header py-6">
                <h5 id="attributeOffcanvasTitle" class="offcanvas-title">Thêm mới</h5>
                <button type="button"
                        class="btn-close text-reset"
                        data-bs-dismiss="offcanvas"
                        aria-label="Close"></button>
            </div>
            <!-- Offcanvas Body -->
            <div class="offcanvas-body border-top">
                <form class="pt-0" id="form-create-attribute" asp-controller="Product" asp-action="CreateProductAttribute" method="post">
                    @Html.AntiForgeryToken()
                    @* <div data-validation-summary  class="text-danger d-none"> </div> *@
                    <input type="hidden" id="Id" name="Id" value="0" />
                    <!-- Title -->
                    <div class="mb-6">
                        <label class="form-label" for="ecommerce-attribute-title">Title</label>
                        <input type="text"
                               class="form-control"
                               asp-for="Name"
                               placeholder="Enter attribute title"
                               aria-label="attribute title" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <!-- Slug -->
                    <div class="mb-6">
                        <label class="form-label" for="ecommerce-attribute-title">Code</label>
                        <input type="text"
                               asp-for="Code"
                               class="form-control"
                               placeholder="Enter code"
                               aria-label="code" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <!-- Status -->
                    @* <div class="mb-6 ecommerce-select2-dropdown">
                        <label class="form-label">Select category status</label>
                        <select class="form-select"
                                asp-for="IsActive"
                                asp-items="@(ViewData["Statuses"] as IEnumerable<SelectListItem>)">
                        </select>
                    </div> *@
                    <!-- Submit and reset -->
                    <div class="mb-6">
                        <button type="submit" class="btn btn-primary me-sm-3 me-1 data-submit">Xác nhận</button>
                        <button type="reset" class="btn btn-label-danger" id="btn-reset-attribute" data-bs-dismiss="offcanvas">Hủy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/assets/js/product/hk.attribute-list.js"></script>
}