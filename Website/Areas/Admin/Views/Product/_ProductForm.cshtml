                                            <div class="col">
                                                <label class="form-label" for="product-id-1">
                                                    <span class="mb-1 h6">Product ID</span>
                                                </label>
                                                <input type="number"
                                                       id="product-id-1"
                                                       class="form-control"
                                                       placeholder="ISBN Number" />
                                            </div>
                                        </div>
                                    </div>
                                    <!-- /Advanced Tab -->
                                </div>
                            </div>
                            <!-- /Options-->
                        </div>
                    </div>
                </div> *@
        <!-- /Inventory -->
    </div>
    <!-- /Second column -->
</div>