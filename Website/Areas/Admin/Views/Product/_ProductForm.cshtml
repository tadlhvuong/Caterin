                                                    <span class="mb-1 h6">Product ID Type</span>
                                                </label>
                                                <select id="product-id" class="select2 form-select" data-placeholder="ISBN">
                                                    <option value="">ISBN</option>
                                                    <option value="ISBN">ISBN</option>
