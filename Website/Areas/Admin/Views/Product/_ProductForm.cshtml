@using Shared.Requests.Product
@model CreateProductRequest
@{
}
<style>
    .product-form-actions {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1030;
        padding: 1rem 0;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-top: 1px solid var(--bs-border-color);
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    }
</style>
<div class="d-flex flex-column flex-md-row justify-content-between align-items-end align-items-md-center row-gap-4 product-form-actions">
   @*  <div class="d-flex flex-column justify-content-center">
        <h4 class="mb-1">Chỉnh sửa sản phẩm</h4>
        <p class="mb-0">Orders placed across your store</p>
    </div> *@
    <div class="d-flex align-content-center flex-wrap gap-4 offset-8">
        <div class="d-flex gap-4">
            <button type="button"
                    id="btnDiscard"
                    class="btn btn-label-secondary">
                Hủy bỏ
            </button>
            <button type="submit"
                    id="btnSaveDraft"
                    data-action="draft"
                    class="btn btn-label-primary">
                Ẩn
            </button>
        </div>
        <button type="submit"
                id="btnPublish"
                data-action="publish"
                class="btn btn-primary">
            Hiện
        </button>
    </div>
</div>

<div class="row">
    <!-- First column-->
    <div class="col-12 col-md-10 offset-md-1">
        <!-- Media -->
        
        <!-- /Media -->
        <!-- Product Information -->
        <div class="card mb-6">
            <div class="card-header">
                <h5 class="card-tile mb-0">Thông tin cơ bản</h5>
            </div>
            <div class="card-body">
                <div class="mb-6">
                    <label class="mb-0 card-title">Hình ảnh sản phẩm</label><span> Chọn tối đa 10 ảnh. mỗi ảnh không quá 5MB</span>
                    <div id="productForm">
                        <!-- FILEPOND -->
                        <input type="file" id="productImages" data-filepond multiple accept="image/jpeg,image/png,image/webp">
                    </div>
                </div>
                <div class="mb-6">
                    <label class="form-label" for="ecommerce-product-name">Name</label>
                    <input type="text"
                           class="form-control"
                           asp-for="Name"
                           placeholder="Product title"
                           aria-label="Product title" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>
                <div class="row mb-6">
                    <div class="col">
                        <label class="form-label" for="ecommerce-product-sku">SKU</label>
                        <input type="text"
                               class="form-control"
                               asp-for="SKU"
                               placeholder="SKU"
                               aria-label="Product SKU" />
                        <span asp-validation-for="SKU"
                              class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label class="form-label" for="ecommerce-product-barcode">Slug</label>
                        <a href="javascript:void(0);"
                           id="btn-generate-slug"
                           class="small text-primary text-decoration-none">
                            <i class="ti ti-wand me-1"></i>
                            Generate Slug
                        </a>
                        <input type="text"
                               class="form-control"
                               asp-for="Slug"
                               placeholder="Slug"
                               aria-label="Slug" />
                        <span asp-validation-for="Slug"
                              class="text-danger"></span>
                    </div>
                </div>
                <!-- Description -->
                <div>
                    <label class="mb-1">Description (Optional)</label>
                    <div class="form-control p-0">
                        <div class="comment-toolbar border-0 border-bottom">
                            <div class="d-flex justify-content-start">
                                <span class="ql-formats me-0">
                                    <button class="ql-bold"></button>
                                    <button class="ql-italic"></button>
                                    <button class="ql-underline"></button>
                                    <button class="ql-list" value="ordered"></button>
                                    <button class="ql-list" value="bullet"></button>
                                    <button class="ql-link"></button>
                                    <button class="ql-image"></button>
                                </span>
                            </div>
                        </div>
                        <div class="comment-editor border-0 pb-6" id="comment-description"></div>
                        <!-- Quill content -->
                        @*  <input type="hidden"
                                           id="Description"
                                           name="Description" /> *@

                    </div>
                </div>

                <div class="row mb-6">
                    <div class="col">

                        <label class="form-label mb-1" for="vendor"> Vendor </label>
                        <select id="vendor" class="form-select" data-placeholder="Select Vendor">
                            <option value="">Select Vendor</option>
                            <option value="men-clothing">Caterin</option>
                            <option value="women-clothing">Women's-clothing</option>
                            <option value="kid-clothing">Kid's-clothing</option>
                        </select>
                    </div>
                    <div class="col">
                        <!-- Category -->
                        <label class="form-label mb-1" for="CategoryId">
                            Category
                        </label>
                        <select asp-for="CategoryId"
                                class="form-select"
                                data-placeholder="Select Category">
                            <option value="0">
                                Select Category
                            </option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-6">
                    <div class="col">
                        <label class="form-label mb-1" for="collection">Collection </label>
                        <select class="form-select" data-placeholder="Collection">
                            <option value="">Collection</option>
                            <option value="men-clothing">Men's Clothing</option>
                            <option value="women-clothing">Women's-clothing</option>
                            <option value="kid-clothing">Kid's-clothing</option>
                        </select>
                    </div>
                    <div class="col">
                        <label for="ecommerce-product-tags" class="form-label mb-1">Tags</label>
                        <input asp-for="Tags"
                               class="form-control"
                               value=""
                               aria-label="Product Tags" />
                    </div>



                </div>
            </div>
        </div>
        <!-- /Product Information -->
        <!-- Variants -->
        <div class="card mb-6">
            <div class="card-header">
                <h5 class="card-title mb-0">Thông tin bán hàng</h5>
            </div>
            <div class="card-body">
                <!-- ========================================================= -->
                <!-- GROUP 1: PRODUCT OPTIONS                                  -->
                <!-- ========================================================= -->

                <label class="form-label fw-semibold">
                    Phân loại sản phẩm
                </label>

                <div class="mb-6">

                    <div class="form-repeater">

                        <div data-repeater-list="Options">

                            <!-- Empty repeater item -->
                            <div data-repeater-item class="product-option">

                                <div class="row align-items-start mb-4">

                                    <!-- Option Name -->
                                    <div class="col-md-4">

                                        <label class="form-label">
                                            Phân loại
                                        </label>

                                        <select name="Name"
                                                class="form-select option-name select2"
                                                data-placeholder="Chọn phân loại">

                                            <option value="">
                                                Chọn phân loại
                                            </option>

                                            <option value="Size">
                                                Size
                                            </option>

                                            <option value="Color">
                                                Color
                                            </option>

                                            <option value="Weight">
                                                Weight
                                            </option>

                                            <option value="Smell">
                                                Smell
                                            </option>

                                        </select>

                                        <span data-valmsg-for="Name"
                                              class="text-danger field-validation-valid">
                                        </span>

                                    </div>


                                    <!-- Option Values -->
                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Giá trị
                                        </label>

                                        <input type="text"
                                               name="Values"
                                               class="form-control option-values"
                                               placeholder="Nhập giá trị..." />

                                        <span data-valmsg-for="Values"
                                              class="text-danger field-validation-valid">
                                        </span>

                                    </div>


                                    <!-- Delete -->
                                    <div class="col-md-2 pt-6">

                                        <button type="button"
                                                class="btn btn-icon btn-label-danger"
                                                data-repeater-delete
                                                title="Xóa phân loại">

                                            <i class="ti ti-trash"></i>

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Add Option -->
                        <div>

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    data-repeater-create>

                                <i class="ti ti-plus ti-xs me-2"></i>

                                Thêm phân loại

                            </button>

                        </div>

                    </div>

                </div>
                <!-- ========================================================= -->
                <!-- GROUP 2: DEFAULT PRICE / STOCK                            -->
                <!-- ========================================================= -->

                <div class="mb-6">

                    <div class="row align-items-end">

                        <!-- Price -->
                        <div class="col-md-4">

                            <label class="form-label"
                                   for="variant-default-price">
                                Price
                            </label>

                            <input type="number"
                                   asp-for="Price"
                                   class="form-control"
                                   min="0"
                                   step="1000"
                                   placeholder="Nhập giá" />

                        </div>


                        <!-- Stock -->
                        <div class="col-md-4">

                            <label class="form-label"
                                   for="variant-default-stock">

                                Stock

                            </label>

                            <input type="number"
                                   asp-for="Stock"
                                   class="form-control"
                                   min="0"
                                   placeholder="Nhập tồn kho" />

                        </div>


                        <!-- Apply -->
                        <div class="col-md-4 mt-2">

                            <button type="button"
                                    id="btn-apply-all"
                                    class="btn btn-primary d-none">

                                <i class="ti ti-check me-1"></i>

                                Áp dụng tất cả

                            </button>

                        </div>

                    </div>

                </div>
                <!-- ========================================================= -->
                <!-- GROUP 3: PRODUCT VARIANTS                                 -->
                <!-- ========================================================= -->

                <label class="form-label fw-semibold">
                    Danh sách biến thể
                </label>

                <div id="variantList" class="mb-6">

                    <div class="table-responsive">
                        <table id="product-variants-table"
                               class="table table-bordered align-middle w-100">

                            <thead></thead>

                            <tbody></tbody>

                        </table>
                    </div>

                </div>
            </div>
        </div>
        <!-- /Variants -->
        <!-- Inventory -->
        @* <div class="card mb-6">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Inventory</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <!-- Navigation -->
                            <div class="col-12 col-md-4 col-xl-5 col-xxl-4 mx-auto card-separator">
                                <div class="d-flex justify-content-between flex-column mb-4 mb-md-0 pe-md-4">
