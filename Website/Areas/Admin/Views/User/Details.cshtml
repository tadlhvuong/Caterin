@using Website.Areas.Admin.Models
@using Website.Areas.Admin.Models.User
@model UserDetailsViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản";
    // var currentTab = (ViewData["CurrentTab"] as string ?? "personal").ToLower();
    var curent = Model.CurrentTab;
    var initAction = Model.CurrentTab switch
    {
        "security" => "details-security",
        "billing" => "details-billing",
        "notification" => "details-notification",
        "connection" => "details-connection",
        "personal" => "details-personal"
    };
}
@section Styles {
    <link rel="stylesheet" href="~/admin/assets/vendor/libs/sweetalert2/sweetalert2.css" />
    <style>
        .user-avatar-wrapper {
            width: 128px;
            height: 128px;
            padding: 4px;
            border: 1px solid var(--bs-border-color);
            border-radius: 50%;
            overflow: hidden;
        }

        .user-avatar-image {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .user-avatar-actions .btn {
            min-width: 180px;
        }
    </style>
}

<div class="container-xxl flex-grow-1 container-p-y" id="userDetails"
     data-user-id="@Model.Id">
    <div class="row">
        <!-- User Sidebar -->
        <div class="col-xl-4 col-lg-5 order-0 order-md-0">
            <!-- User Card -->
            <div class="card mb-6">
                <div class="card-body pt-12">
                    <div class="user-avatar-section">
                        <div class="d-flex align-items-center flex-column">

                            <div class="user-avatar-wrapper mb-3">
                                <img id="userAvatar"
                                     class="user-avatar-image rounded"
                                     src="@(Model.AvatarUrl ?? Url.Content("~/images/Default/default-user.png"))"
                                     alt="User avatar"
                                     width="120"
                                     height="120" />
                            </div>

                            <div class="user-avatar-actions text-center mb-4">
                                <label for="upload"
                                       class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2 mb-2"
                                       style="cursor: pointer;">
                                    <i class="ti ti-camera"></i>
                                    <span>Đổi ảnh đại diện</span>

                                    <input type="file"
                                           id="upload"
                                           class="account-file-input"
                                           accept=".jpg,.jpeg,.png,.webp"
                                           hidden />
                                </label>

                                <div class="text-muted small">
                                    JPG, JPEG, PNG hoặc WEBP · Tối đa 2 MB
                                </div>
                            </div>

                            <div class="user-info text-center">
                                <h5 id="detailUserName" class="mb-2">@Model.UserName</h5>
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    @if (Model.Roles != null && Model.Roles.Any())
                                    {
                                        foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-label-secondary">@role</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có vai trò</span>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                    <form id="avatarAntiForgeryForm" class="d-none">
                        @Html.AntiForgeryToken()
                    </form>
                    <div class="my-6">

                        <!-- Email -->
                        <div class="d-flex align-items-center py-3 border-bottom">
                            <div class="avatar me-3">
                                <div class="avatar-initial bg-label-primary rounded">
                                    <i class="ti ti-mail ti-lg"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="text-muted small">Email</div>
                                <div class="fw-semibold">@Model.Email</div>
                            </div>
                            @if (Model.ConfirmEmail)
                            {
                                <span class="badge bg-label-success">Đã xác minh</span>
                            }
                            else
                            {
                                <span class="badge bg-label-warning">Chưa xác minh</span>
                            }
                        </div>

                        <!-- Phone -->
                        <div class="d-flex align-items-center py-3 border-bottom">
                            <div class="avatar me-3">
                                <div class="avatar-initial bg-label-primary rounded">
                                    <i class="ti ti-phone ti-lg"></i>
                                </div>
                            </div>

                            <div class="flex-grow-1">
                                <div class="text-muted small">Số điện thoại</div>
                                <div class="fw-semibold" id="detailPhoneNumber">
                                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                                                        ? "Chưa cập nhật"
                                                                        : Model.PhoneNumber)
                                </div>
                            </div>
                        </div>

                        <!-- Role -->
                        <div class="d-flex align-items-center py-3 border-bottom">
                            <div class="avatar me-3">
                                <div class="avatar-initial bg-label-primary rounded">
                                    <i class="ti ti-rosette-discount-check ti-lg"></i>
                                </div>
                            </div>

                            <div class="flex-grow-1">
                                <div class="text-muted small">Vai trò</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (Model.Roles.Any())
                                    {
                                        foreach (var role in Model.Roles)
                                        {
                                            <span class="badge bg-label-primary">@role</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Chưa có vai trò</span>
                                    }
                                    <a href="@Url.Action("Role", "RolePermission", new { area = "Admin" })"
                                       class="btn btn-sm btn-label-secondary">
                                        <i class="ti ti-shield-cog me-1"></i>
                                        Quản lý vai trò
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Created -->
                        <div class="d-flex align-items-center py-3 border-bottom">
                            <div class="avatar me-3">
                                <div class="avatar-initial bg-label-primary rounded">
                                    <i class="ti ti-calendar ti-lg"></i>
                                </div>
                            </div>

                            <div class="flex-grow-1">
                                <div class="text-muted small">Thành viên từ</div>
                                <div class="fw-semibold">@Model.CreatedAt?.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>

                        <!-- Last Login -->
                        <div class="d-flex align-items-center py-3">
                            <div class="avatar me-3">
                                <div class="avatar-initial bg-label-primary rounded">
                                    <i class="ti ti-clock ti-lg"></i>
                                </div>
                            </div>

                            <div class="flex-grow-1">
                                <div class="text-muted small">Đăng nhập gần nhất</div>
                                <div class="fw-semibold">
                                    @(Model.LastLoginAt?.ToString("HH:mm dd/MM/yyyy") ?? "Chưa có")
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-center">
                            <a href="javascript:;"
                               class="btn btn-primary me-4"
                               data-bs-target="#editUser"
                               data-bs-toggle="modal">Edit</a>
                            @if (Model.IsActive)
                            {
                                <a href="javascript:;"
                                   class="btn btn-label-danger suspend-user"
                                   data-user-id="@Model.Id"
                                   data-active="true">
                                    Suspend
                                </a>
                            }
                            else
                            {
                                <a href="javascript:;"
                                   class="btn btn-label-success suspend-user"
                                   data-user-id="@Model.Id"
                                   data-active="false">
                                    Activate
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <!-- /User Card -->
        </div>
        <!--/ User Sidebar -->

        <div class="col-xl-8 col-lg-7 order-1 order-md-1">
            <partial name="_DetailsNav" model="@Model"  />
            <div id="tab-content"
                 hx-get="@Url.Action(initAction, "User", new { id = Model.Id })"
                 hx-trigger="load" class="2xl:w-9/12 xl:w-8/12 flex-grow-0 flex-shrink-0 basis-auto">
            </div>
            @* <div id="profile-content"
                 hx-get="/profile/@url" hx-trigger="load"
                 class="2xl:w-9/12 xl:w-8/12 flex-grow-0 flex-shrink-0 basis-auto">
            </div> *@
        </div>
    </div>
    <partial name="_UpdateUser"
             model="@ViewData["UpdateUserModel"]" />
</div>

                          @section Scripts {

    <script src="~/admin/assets/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/admin/assets/js/modal-edit-user.js"></script>
    <script src="~/admin/assets/js/hk.user-view.js"></script>
    <script>
            document.body.addEventListener("htmx:afterRequest", function (e) {
            const url = new URL(window.location.href);
            const currentTab = url.searchParams.get("tab") || "personal";

            document.querySelectorAll("[data-tab]").forEach(el => {
                el.classList.toggle("active", el.dataset.tab === currentTab);
            });
        });
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const shouldOpenEditModal =
                @System.Text.Json.JsonSerializer.Serialize(ViewData["OpenEditModal"] is true);

            if (!shouldOpenEditModal) return;

            const modalElement = document.getElementById('editUser');

            if (!modalElement) {
                console.error('Không tìm thấy modal #editUser.');
                return;
            }

            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        });
    </script>


                          }