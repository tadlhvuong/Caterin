@using Website.Areas.Admin.Models.User
@model UserConnectionViewModel

<div class="card">
    <div class="card-header border-bottom">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h5 class="mb-1">Connected accounts</h5>
                <p class="text-muted mb-0">
                    Các tài khoản bên ngoài được liên kết với tài khoản Caterin này.
                </p>
            </div>

            <span class="badge bg-label-success">
                @Model.Providers.Count(x => x.IsConnected) liên kết
            </span>
        </div>
    </div>

    <div class="card-body">
        <div class="d-flex flex-column gap-3">

            @foreach (var provider in Model.Providers)
            {
                <div class="d-flex align-items-center justify-content-between
                                border rounded p-3 gap-3">

                    <div class="d-flex align-items-center gap-3 min-w-0">
                        <div class="avatar">
                            <div class="avatar-initial bg-label-secondary rounded">
                                <i class="@provider.Icon ti-lg"></i>
                            </div>
                        </div>

                        <div class="min-w-0">
                            <h6 class="mb-1">@provider.DisplayName</h6>

                            <div class="text-muted small">
                                @if (provider.IsConnected)
                                {
                                    <span>Tài khoản đăng nhập đã được liên kết</span>
                                }
                                else
                                {
                                    <span>Chưa liên kết với tài khoản Caterin</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="flex-shrink-0">
                        @if (provider.IsConnected)
                        {
                            <span class="badge bg-label-success">
                                <i class="ti ti-check me-1"></i>
                                Connected
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-label-secondary">
                                Not connected
                            </span>
                        }
                    </div>
                </div>
            }

        </div>

        <div class="alert alert-info d-flex align-items-start gap-2 mt-4 mb-0"
             role="alert">
            <i class="ti ti-info-circle ti-lg mt-1"></i>
            <div>
                <div class="fw-semibold mb-1">Thông tin liên kết</div>
                <div class="small">
                    Đây là thông tin chỉ đọc. Người dùng tự quản lý việc
                    liên kết và ngắt liên kết trong phần cài đặt tài khoản.
                </div>
            </div>
        </div>
    </div>
</div>