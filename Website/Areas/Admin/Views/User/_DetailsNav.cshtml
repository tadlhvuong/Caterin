@using Website.Areas.Admin.Models
@model UserDetailsViewModel
@{
    Layout = null;
}

<!-- User Pills -->
<div class="nav-align-top">
    <ul class="nav nav-pills flex-column flex-md-row flex-wrap mb-6 row-gap-2">
        <li class="nav-item">
            <a class="nav-link"
               hx-get="/admin/user/details-personal?id=@Model.Id"
               hx-target="#tab-content"
               hx-push-url="/admin/user/user-details/@Model.Id?tab=personal" data-tab="personal" data-i18n="Personal">
                Account
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               hx-get="/admin/user/details-security?id=@Model.Id"
               hx-target="#tab-content"
               hx-push-url="/admin/user/user-details/@Model.Id?tab=security" data-tab="security" data-i18n="Security">
                Security
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" hx-get="/admin/user/details-billing?id=@Model.Id"
               hx-target="#tab-content"
               hx-push-url="/admin/user/user-details/@Model.Id?tab=billing" data-tab="billing" data-i18n="Billing"><i class="ti ti-bookmark ti-sm me-1_5"></i>Billing & Plans</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" hx-get="/admin/user/details-notification?id=@Model.Id" hx-target="#tab-content"
               hx-push-url="/admin/user/user-details/@Model.Id?tab=notification" data-tab="notification" data-i18n="Notification"><i class="ti ti-bell ti-sm me-1_5"></i>Notifications</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" hx-get="/admin/user/details-connection?id=@Model.Id" hx-target="#tab-content"
               hx-push-url="/admin/user/user-details/@Model.Id?tab=connection" data-tab="connection" data-i18n="Connection"><i class="ti ti-link ti-sm me-1_5"></i>Connections</a>
        </li>
    </ul>
</div>
<!--/ User Pills -->
