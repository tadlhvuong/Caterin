    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
<style>
    .device-session-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
        background: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        font-size: 1.5rem;
    }

    .device-session-item h6 {
        font-size: 0.9375rem;
        font-weight: 600;
    }

    .device-session-item:last-child {
        border-bottom: 0 !important;
    }

    .device-session-item {
        min-width: 0;
    }


    /* MODAL */
    .device-session-row {
        min-width: 0;
        transition: background-color 0.15s ease;
    }

        .device-session-row:hover {
            background-color: var(--bs-tertiary-bg);
        }

        .device-session-row .device-session-icon {
            width: 44px;
            height: 44px;
            flex: 0 0 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            background: var(--bs-tertiary-bg);
            color: var(--bs-body-color);
            font-size: 1.5rem;
        }

    .device-session-meta {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-top: 0.375rem;
        color: var(--bs-secondary-color);
        font-size: 0.8125rem;
        overflow-wrap: anywhere;
    }

        .device-session-meta i {
            flex: 0 0 auto;
            font-size: 1rem;
            margin-top: 1px;
        }

    #allDevicesModal .modal-body {
        max-height: 65vh;
    }

    @@media (max-width: 575.98px) {
        #allDevicesModal .modal-dialog

    {
        margin: 0.75rem;
    }

    .device-session-row {
        padding: 1rem !important;
        gap: 0.75rem !important;
    }

        .device-session-row .device-session-icon {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            font-size: 1.25rem;
        }

    }
</style>
<!-- Change Password -->
<div class="card mb-6" data-page="security">
    <h5 class="card-header" data-i18n="Change Password">Change Password</h5>
    <div class="card-body">
        <form id="formChangePassword" method="POST" action="@Url.Action("ResetPassword", "User", new { area = "Admin", userId = Model.Id })">
            @Html.AntiForgeryToken()
            <div class="alert alert-warning alert-dismissible" role="alert">
                <h5 class="alert-heading mb-1">Ensure that these requirements are met</h5>
                <ul>
                    <li>At least 12 characters long</li>
                    <li>At least 4 unique characters</li>
                    <li>At least one uppercase letter (A-Z)</li>
                    <li>At least one lowercase letter (a-z)</li>
                    <li>At least one digit (0-9)</li>
                    <li>At least one symbol (e.g. !, #, $)</li>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <div class="row gx-6">
                <div class="mb-4 col-12 col-sm-6 form-password-toggle">
                    <label class="form-label" for="newPassword">New Password</label>
                    <div class="input-group input-group-merge">
                        <input class="form-control"
                               type="password"
                               id="newPassword"
                               name="newPassword"
                               placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" />
                        <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
                    </div>

                    <div class="invalid-feedback"></div>
                </div>

                <div class="mb-4 col-12 col-sm-6 form-password-toggle">
                    <label class="form-label" for="confirmPassword">Confirm New Password</label>
                    <div class="input-group input-group-merge">
                        <input class="form-control"
                               type="password"
                               name="confirmPassword"
                               id="confirmPassword"
                               placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" />
                        <span class="input-group-text cursor-pointer"><i class="ti ti-eye-off"></i></span>
                    </div>
                    <div class="invalid-feedback"></div>
                </div>
                <div>
                    <button class="btn btn-primary me-2" type="button" id="btnGeneratePassword">
                        <i class="ti ti-wand "></i> Tạo mật khẩu
                    </button>
                    <button type="submit" class="btn btn-primary me-2">Change Password</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--/ Change Password -->
<!-- Recent Devices -->
<div class="card mb-6" id="userDevicesSection" data-user-id="@Model.Id">
    @Html.AntiForgeryToken()
    <div class="card-header d-flex align-items-center justify-content-between">
        <div>
            <h5 class="mb-1">Recent Devices</h5>
            <p class="text-muted mb-0">
                Manage devices that are signed in to this account.
            </p>
        </div>
        <i class="ti ti-devices fs-3 text-muted"></i>
    </div>

    <div class="card-body">
        <div id="recentDevicesList">

            <!-- Device 1 -->
            <div class="device-session-item d-flex align-items-start gap-3 py-3 border-bottom">
                <div class="device-session-icon">
                    <i class="ti ti-device-desktop"></i>
                </div>

                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h6 class="mb-0">Windows · Chrome</h6>
                        <span class="badge bg-label-success">Current device</span>
                    </div>
                    <div class="text-muted small mb-1">
                        IP: 192.168.1.10
                    </div>
                    <div class="text-muted small">
                        Last active: Just now
                    </div>
                </div>
            </div>

            <!-- Device 2 -->
            <div class="device-session-item d-flex align-items-start gap-3 py-3">
                <div class="device-session-icon">
                    <i class="ti ti-device-mobile"></i>
                </div>

                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h6 class="mb-0">Android · Chrome</h6>
                    </div>
                    <div class="text-muted small mb-1">
                        IP: 113.xxx.xxx.xxx
                    </div>
                    <div class="text-muted small">
                        Last active: 2 hours ago
                    </div>
                </div>

                <button type="button"
                        class="btn btn-sm btn-icon btn-text-secondary"
                        aria-label="Device actions"
                        title="Device actions">
                    <i class="ti ti-dots-vertical"></i>
                </button>
            </div>

        </div>

        <!-- Only show when session count > 2 -->
        <button type="button"
                id="btnViewAllDevices"
                class="btn btn-outline-secondary w-100 mt-3"
                data-bs-toggle="modal"
                data-bs-target="#allDevicesModal"
                hidden>
            <i class="ti ti-devices me-1"></i>
            View all devices
        </button>
    </div>
</div>

<!--/ Recent Devices -->

<!-- Deactivate -->
<div class="card mb-12">
    <div class="card-header">

        <h5 class="card-header">Delete Account</h5>
    </div>
    <div class="card-body pt-0">
        <div class="mb-4">
            <div class="alert alert-warning alert-dismissible">
                <h5 class="alert-heading mb-1">Are you sure you want to delete your account?</h5>
                <p class="mb-0">Once you delete your account, there is no going back. Please be certain.</p>
            </div>
            <form id="formAccountDeactivation" onsubmit="return false">
                <div class="form-check my-8">
                    <input class="form-check-input"
                           type="checkbox"
                           name="accountActivation"
                           id="accountActivation" />
                    <label class="form-check-label" for="accountActivation">I confirm my account deactivation</label>
                </div>
                <button type="submit" class="btn btn-danger deactivate-account" disabled>
                    Deactivate Account
                </button>
            </form>
        </div>
    </div>
</div>
<!--/ Deactivate -->


<div class="modal fade"
     id="allDevicesModal"
     tabindex="-1"
     aria-labelledby="allDevicesModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="allDevicesModalLabel">
                        <i class="ti ti-devices me-2"></i>
                        All Devices
                    </h5>
                    <p class="text-muted small mb-0 mt-1">
                        Review devices currently signed in to this account.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body p-0">
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                    <span class="fw-medium">Signed-in devices</span>
                    <span class="badge bg-label-primary" id="allDevicesCount">
                        3 sessions
                    </span>
                </div>

                <div id="allDevicesList">

                    <!-- Current device -->
                    <div class="device-session-row d-flex align-items-start gap-3 p-4 border-bottom">
                        <div class="device-session-icon">
                            <i class="ti ti-device-desktop"></i>
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h6 class="mb-0">Windows · Chrome</h6>
                                <span class="badge bg-label-success">
                                    Current device
                                </span>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-map-pin"></i>
                                <span>Ho Chi Minh City, Vietnam</span>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-world"></i>
                                <span>192.168.1.10</span>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-clock"></i>
                                <span>Last active: Just now</span>
                            </div>
                        </div>
                    </div>

                    <!-- Other device -->
                    <div class="device-session-row d-flex align-items-start gap-3 p-4 border-bottom">
                        <div class="device-session-icon">
                            <i class="ti ti-device-mobile"></i>
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h6 class="mb-0">Android · Chrome</h6>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-map-pin"></i>
                                <span>Location unavailable</span>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-world"></i>
                                <span>113.xxx.xxx.xxx</span>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-clock"></i>
                                <span>Last active: 2 hours ago</span>
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger flex-shrink-0"
                                data-session-id="session-2"
                                data-device-name="Android · Chrome"
                                data-action="revoke-session">
                            <i class="ti ti-logout me-sm-1"></i>
                            <span class="d-none d-sm-inline">Log out</span>
                        </button>
                    </div>

                    <!-- Other device -->
                    <div class="device-session-row d-flex align-items-start gap-3 p-4">
                        <div class="device-session-icon">
                            <i class="ti ti-device-laptop"></i>
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <h6 class="mb-0">macOS · Safari</h6>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-map-pin"></i>
                                <span>Location unavailable</span>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-world"></i>
                                <span>203.xxx.xxx.xxx</span>
                            </div>

                            <div class="device-session-meta">
                                <i class="ti ti-clock"></i>
                                <span>Last active: Yesterday</span>
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger flex-shrink-0"
                                data-session-id="session-3"
                                data-device-name="macOS · Safari"
                                data-action="revoke-session">
                            <i class="ti ti-logout me-sm-1"></i>
                            <span class="d-none d-sm-inline">Log out</span>
                        </button>
                    </div>

                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-label-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>
    

<script src="~/admin/assets/js/user/hk.user-security.js"></script>