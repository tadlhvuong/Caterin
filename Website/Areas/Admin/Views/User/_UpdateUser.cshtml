@using Website.Areas.Admin.Models.User
@model UpdateUserViewModel

<div class="modal fade" id="editUser" tabindex="-1"
     aria-labelledby="editUserLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="updateUserForm" method="POST" action="@Url.Action("Update", "User", new { area = "Admin", id = Model.Id })">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="modal-header">
                    <h5 class="modal-title" id="editUserLabel">
                        Chỉnh sửa tài khoản
                    </h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">
                            Tên đăng nhập
                        </label>
                        <input asp-for="UserName"
                               class="form-control"
                               readonly />
                        <div class="form-text">
                            Tên đăng nhập không thể thay đổi.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            Email
                        </label>
                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               readonly />

                        <div class="d-flex align-items-center gap-2 mt-2">
                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge bg-label-success">
                                    Đã xác thực email
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-label-warning">
                                    Chưa xác thực email
                                </span>

                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        id="btnResendEmailVerification"
                                        data-url="@Url.Action(
                                                    "ResendConfirmEmail",
                                                    "User",
                                                    new { area = "Admin", id = Model.Id })">
                                    Gửi lại email xác thực
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">
                            Số điện thoại
                        </label>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               type="tel"
                               autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber"
                              class="text-danger"></span>

                        @* <div class="mt-2">
                            @if (Model.PhoneNumberConfirmed)
                            {
                                <span class="badge bg-label-success">
                                    Đã xác thực số điện thoại
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-label-warning">
                                    Chưa xác thực số điện thoại
                                </span>
                            }
                        </div> *@
                    </div>

                    <div class="mb-3">
                        <label class="form-label d-block">
                            Trạng thái tài khoản
                        </label>

                        <div class="form-check form-switch">
                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />
                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Tài khoản đang hoạt động
                            </label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-label-secondary"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit"
                            class="btn btn-primary"
                            id="btnUpdateUser">
                        <i class="ti ti-device-floppy me-1"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>