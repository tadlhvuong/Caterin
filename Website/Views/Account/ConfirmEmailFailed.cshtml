@{
    ViewData["Title"] = "Xác nhận email thất bại | Caterin";

    var message = ViewBag.ErrorMessage as string
                  ?? "Liên kết xác nhận không hợp lệ hoặc đã hết hạn.";
}

<!-- Confirm Email Error -->
<section class="flex min-h-[70vh] items-center bg-[#FAFCF9] px-4 py-12 sm:py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl">

        <div class="mx-auto max-w-xl">

            <!-- Error Card -->
            <div class="rounded-2xl border border-gray-200 bg-white px-5 py-9 text-center shadow-sm sm:px-10 sm:py-12">

                <!-- Error Icon -->
                <div class="mx-auto flex size-20 items-center justify-center rounded-full bg-red-50 text-4xl text-red-500">
                    <i class="ph ph-warning-circle"></i>
                </div>

                <!-- Heading -->
                <div class="mt-7">
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-600">
                        <i class="ph ph-warning-circle"></i>
                        Xác thực không thành công
                    </span>

                    <h1 class="mt-4 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
                        Không thể xác nhận email
                    </h1>

                    <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-gray-500 sm:text-base">
                        Rất tiếc, chúng tôi không thể xác nhận địa chỉ email của bạn.
                    </p>
                </div>

                <!-- Error Message -->
                <div class="mt-7 rounded-xl border border-red-100 bg-red-50/70 p-4 text-left sm:p-5">
                    <div class="flex items-start gap-3">
                        <i class="ph ph-info mt-0.5 shrink-0 text-xl text-red-500"></i>

                        <div>
                            <p class="text-sm font-semibold text-gray-800">
                                Chi tiết
                            </p>

                            <p class="mt-1.5 break-words text-sm leading-6 text-gray-600">
                                @message
                            </p>
                        </div>
                    </div>
                </div>

                <p class="mt-6 text-sm leading-6 text-gray-500">
                    Liên kết xác thực có thể đã hết hạn hoặc không còn hợp lệ.
                    Bạn có thể yêu cầu gửi lại email xác thực.
                </p>

                <!-- Actions -->
                <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">

                    <a asp-controller="Account"
                       asp-action="ResendConfirmEmail"
                       class="inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 text-sm font-semibold text-white shadow-sm transition hover:bg-[#187A38] hover:shadow-md focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20">
                        <i class="ph ph-paper-plane-tilt text-lg"></i>
                        Gửi lại email xác thực
                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="inline-flex h-12 items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-6 text-sm font-semibold text-gray-700 transition hover:border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-4 focus:ring-gray-100">
                        <i class="ph ph-arrow-left text-lg"></i>
                        Quay lại đăng nhập
                    </a>

                </div>

            </div>

            <!-- Footer -->
            <p class="mt-5 text-center text-xs text-gray-400">
                Caterin – An toàn cho mọi nhà
            </p>

        </div>
    </div>
</section>
