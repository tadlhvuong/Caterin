@using Website.Models.Account
@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu | Caterin";
}

<!-- Breadcrumb -->
<section class="border-b border-gray-100 bg-[#F7FAF6]">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-lg font-semibold text-gray-900">
                Tài khoản
            </h1>

            <nav aria-label="Breadcrumb">
                <ol class="flex items-center gap-2 text-sm">
                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="flex items-center gap-1.5 text-gray-500 transition hover:text-[#1F9345]">
                            <i class="ph ph-house"></i>
                            Trang chủ
                        </a>
                    </li>

                    <li class="text-gray-300">
                        <i class="ph ph-caret-right"></i>
                    </li>

                    <li class="font-medium text-[#1F9345]" aria-current="page">
                        Quên mật khẩu
                    </li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<!-- Forgot Password -->
<section class="flex min-h-[65vh] items-center bg-[#FAFCF9] px-4 py-12 sm:py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl">

        <div class="mx-auto max-w-xl">

            <!-- Form Card -->
            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8 lg:p-10">

                <!-- Heading -->
                <div class="mb-8 text-center">

                    <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-[#F1F8EF] text-3xl text-[#1F9345]">
                        <i class="ph ph-lock-key"></i>
                    </div>

                    <p class="mt-5 text-sm font-semibold text-[#1F9345]">
                        Hỗ trợ tài khoản Caterin
                    </p>

                    <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
                        Quên mật khẩu?
                    </h2>

                    <p class="mx-auto mt-3 max-w-sm text-sm leading-6 text-gray-500 sm:text-base">
                        Đừng lo lắng! Hãy nhập địa chỉ email đã đăng ký.
                        Chúng tôi sẽ gửi hướng dẫn giúp bạn đặt lại mật khẩu.
                    </p>
                </div>

                <!-- Form -->
                <form asp-controller="Account"
                      asp-action="ForgotPassword"
                      method="post"
                      autocomplete="on"
                      data-auth-form
                      data-ajax="true">

                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         data-valmsg-summary
                         class="mb-5 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-600 empty:hidden">
                    </div>

                    <!-- Email -->
                    <div>
                        <label asp-for="Email"
                               class="mb-2 block text-sm font-semibold text-gray-800">
                            Địa chỉ email
                            <span class="text-red-500">*</span>
                        </label>

                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-lg text-gray-400">
                                <i class="ph ph-envelope-simple"></i>
                            </span>

                            <input asp-for="Email"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="Nhập email đã đăng ký"
                                   class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/70 pl-11 pr-4 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />
                        </div>

                        <span asp-validation-for="Email"
                              class="mt-1.5 block text-sm text-red-600">
                        </span>
                    </div>

                    <!-- Information -->
                    <div class="mt-5 rounded-xl border border-gray-100 bg-gray-50/80 p-4">
                        <div class="flex items-start gap-3">
                            <i class="ph ph-info mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>

                            <p class="text-sm leading-6 text-gray-500">
                                Nếu email hợp lệ, bạn sẽ nhận được hướng dẫn đặt lại mật khẩu.
                                Vui lòng kiểm tra cả thư mục Spam hoặc Quảng cáo.
                            </p>
                        </div>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="mt-7 flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#187A38] hover:shadow-md focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20 disabled:cursor-not-allowed disabled:opacity-60">
                        <i class="ph ph-paper-plane-tilt text-lg"></i>
                        Gửi yêu cầu đặt lại mật khẩu
                    </button>

                    <!-- Back to Login -->
                    <div class="mt-6 text-center">
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="inline-flex items-center gap-2 text-sm font-semibold text-[#1F9345] transition hover:text-[#176F35]">
                            <i class="ph ph-arrow-left"></i>
                            Quay lại đăng nhập
                        </a>
                    </div>

                </form>
            </div>

            <!-- Footer -->
            <p class="mt-5 text-center text-xs text-gray-400">
                Caterin – An toàn cho mọi nhà
            </p>

        </div>
    </div>
</section>
