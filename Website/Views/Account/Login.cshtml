@using Website.Models.Account
@model LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập | Caterin";
}

<!-- Breadcrumb -->
<section class="border-b border-gray-100 bg-[#F7FAF6]">
    <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h1 class="text-lg font-semibold text-gray-900">
                Tài khoản
            </h1>

            <nav aria-label="Breadcrumb">
                <ol class="flex items-center gap-2 text-sm">
                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="flex items-center gap-1.5 text-gray-500 transition hover:text-[#1F9345]">
                            <i class="ph ph-house"></i>
                            Trang chủ
                        </a>
                    </li>
                    <li class="text-gray-300">
                        <i class="ph ph-caret-right"></i>
                    </li>
                    <li class="font-medium text-[#1F9345]" aria-current="page">
                        Đăng nhập
                    </li>
                </ol>
            </nav>
        </div>
    </div>
</section>

<!-- Login -->
<section class="bg-[#FAFCF9] py-10 sm:py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-12 lg:gap-8">

            <!-- Login form -->
            <div class="min-w-0 lg:col-span-6">
                <div class="h-full rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-7 lg:p-9">

                    <!-- Heading -->
                    <div class="mb-8">
                        <div class="mb-5 flex size-12 items-center justify-center rounded-xl bg-[#F1F8EF] text-2xl text-[#1F9345]">
                            <i class="ph ph-user-circle"></i>
                        </div>

                        <p class="mb-2 text-sm font-semibold text-[#1F9345]">
                            Kính chào quý khách 👋
                        </p>

                        <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
                            Đăng nhập tài khoản
                        </h2>

                        <p class="mt-3 max-w-lg text-sm leading-6 text-gray-500 sm:text-base">
                            Đăng nhập để theo dõi đơn hàng, quản lý địa chỉ giao hàng
                            và nhận ưu đãi thành viên.
                        </p>
                    </div>

                    <!-- Login form -->
                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          autocomplete="on"
                          data-auth-form
                          data-ajax="true">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly"
                             data-valmsg-summary
                             class="mb-5 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-600 empty:hidden">
                        </div>

                        <!-- Email -->
                        <div class="mb-5">
                            <label asp-for="Email"
                                   class="mb-2 block text-sm font-semibold text-gray-800">
                                Email <span class="text-red-500">*</span>
                            </label>

                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-lg text-gray-400">
                                    <i class="ph ph-envelope-simple"></i>
                                </span>

                                <input asp-for="Email"
                                       type="email"
                                       autocomplete="username"
                                       placeholder="Nhập địa chỉ email"
                                       class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/70 pl-11 pr-4 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />
                            </div>

                            <span asp-validation-for="Email"
                                  class="mt-1.5 block text-sm text-red-600">
                            </span>
                        </div>

                        <!-- Password -->
                        <div class="mb-5">
                            <label asp-for="Password"
                                   class="mb-2 block text-sm font-semibold text-gray-800">
                                Mật khẩu <span class="text-red-500">*</span>
                            </label>

                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-lg text-gray-400">
                                    <i class="ph ph-lock-simple"></i>
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       autocomplete="current-password"
                                       placeholder="Nhập mật khẩu"
                                       class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/70 pl-11 pr-12 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />

                                <button type="button"
                                        class="absolute inset-y-0 right-0 flex w-12 items-center justify-center rounded-r-xl text-xl text-gray-400 transition hover:text-[#1F9345] focus:outline-none focus:text-[#1F9345]"
                                        data-target="#Password"
                                        aria-label="Hiện mật khẩu"
                                        aria-pressed="false">
                                    <i class="ph ph-eye-slash"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Password"
                                  class="mt-1.5 block text-sm text-red-600">
                            </span>
                        </div>

                        <!-- Remember / Forgot password -->
                        <div class="mb-7 flex flex-wrap items-center justify-between gap-3">
                            <label asp-for="RememberMe"
                                   class="inline-flex cursor-pointer items-center gap-2.5 text-sm text-gray-600">
                                <input asp-for="RememberMe"
                                       class="size-4 rounded border-gray-300 accent-[#1F9345] focus:ring-[#1F9345]" />

                                <span>Ghi nhớ đăng nhập</span>
                            </label>

                            <a asp-controller="Account"
                               asp-action="ForgotPassword"
                               class="text-sm font-semibold text-[#1F9345] transition hover:text-[#176F35] hover:underline">
                                Quên mật khẩu?
                            </a>
                        </div>

                        <!-- Submit -->
                        <button type="submit"
                                class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#187A38] hover:shadow-md focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20 disabled:cursor-not-allowed disabled:opacity-60">
                            <i class="ph ph-sign-in text-lg"></i>
                            Đăng nhập
                        </button>
                    </form>

                    <!-- Register -->
                    <div class="mt-6 text-center text-sm text-gray-500">
                        Chưa có tài khoản?

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="ml-1 font-semibold text-[#1F9345] transition hover:text-[#176F35] hover:underline">
                            Đăng ký ngay
                        </a>
                    </div>

                    <!-- Divider -->
                    <div class="relative my-7">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-100"></div>
                        </div>

                        <div class="relative flex justify-center">
                            <span class="bg-white px-4 text-xs font-medium text-gray-400">
                                HOẶC ĐĂNG NHẬP BẰNG
                            </span>
                        </div>
                    </div>

                    <!-- Google -->
                    <form asp-controller="Account"
                          asp-action="ExternalLogin"
                          method="post"
                          data-auth-form
                          data-ajax="false"
                          class="mb-3">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="provider" value="Google" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                        <button type="submit"
                                class="flex h-12 w-full items-center justify-center gap-3 rounded-xl border border-gray-200 bg-white px-4 text-sm font-semibold text-gray-700 transition hover:border-gray-300 hover:bg-gray-50 hover:shadow-sm focus:outline-none focus:ring-4 focus:ring-gray-100">
                            <img src="~/images/Default/icon/icon-google.png"
                                 alt=""
                                 class="size-5 object-contain" />

                            <span>Tiếp tục với Google</span>
                        </button>
                    </form>

                    <!-- Facebook -->
                    <form asp-controller="Account"
                          asp-action="ExternalLogin"
                          method="post"
                          data-auth-form
                          data-ajax="false">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="provider" value="Facebook" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                        <button type="submit"
                                class="flex h-12 w-full items-center justify-center gap-3 rounded-xl border border-gray-200 bg-white px-4 text-sm font-semibold text-gray-700 transition hover:border-gray-300 hover:bg-gray-50 hover:shadow-sm focus:outline-none focus:ring-4 focus:ring-gray-100">
                            <img src="~/images/Default/icon/icon-fb.png"
                                 alt=""
                                 class="size-5 object-contain" />

                            <span>Tiếp tục với Facebook</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Featured products -->
            <partial name ="_Featured" />

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/account/account-auth.js" asp-append-version="true"></script>
}
