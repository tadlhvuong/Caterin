@using Website.Models.Account

@model LoginViewModel
@section Styles {
    <style>
        .btn-oauth {
            height: 56px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border: 1px solid #E5E7EB;
            border-radius: 12px;
            background: #fff;
            color: #374151;
            font-size: 15px;
            font-weight: 600;
            transition: .25s ease;
        }

            .btn-oauth img {
                width: 20px;
                height: 20px;
                object-fit: contain;
            }

            .btn-oauth:hover {
                background: #F8F9FA;
                border-color: var(--main-600);
                color: var(--main-600);
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(0,0,0,.08);
            }


        .toggle-password {
            border: 0;
            background: transparent;
            color: #6B7280;
            padding: 4px;
        }

            .toggle-password:hover {
                color: var(--main-600);
            }

            .toggle-password i {
                font-size: 20px;
            }
    </style>
}

