    <div class="container container-lg">
        <div class="breadcrumb-wrapper flex-between flex-wrap gap-16">
            <h6 class="mb-0">My Account</h6>
            <ul class="flex items-center gap-8 flex-wrap">
                <li class="text-sm">
                    <a href="index.html"
                       class="text-gray-900 flex items-center gap-8 hover-text-main-600">
                        <i class="ph ph-house"></i> Home
                    </a>
                </li>
                <li class="flex items-center"><i class="ph ph-caret-right"></i></li>
                <li class="text-sm text-main-600">Account</li>
            </ul>
        </div>
    </div>
</div>
<section class="account py-80">
    <div class="container">
        <div class="row g-4">

            <div class="md:w-6/12 flex-grow-0 flex-shrink-0 basis-auto">
                <div class="border border-gray-100 hover-border-main-600 transition-1 rounded-16 px-24 py-40 h-full">

                    <span class="text-main-600 text-sm font-[600] mb-12 block">
                        Kính chào quý khách 👋
                    </span>

                    <h3 class="mb-12">Đăng nhập tài khoản</h3>

                    <p class="text-gray-500 mb-40">
                        Đăng nhập để theo dõi đơn hàng, quản lý địa chỉ giao hàng và nhận ưu đãi thành viên.
                    </p>

                    @* LOGIN FORM *@
                    <form asp-controller="Account"
                          asp-action="Login"
                          method="post"
                          autocomplete="on">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger-600 mb-24">
                        </div>

                        <div class="mb-24">
                            <label asp-for="Email"
                                   class="text-neutral-900 text-lg mb-8 font-[500]">
                                Email <span class="text-danger-600">*</span>
                            </label>

                            <input asp-for="Email"
                                   class="common-input"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="Nhập địa chỉ email" />

                            <span asp-validation-for="Email"
                                  class="text-danger-600 text-sm">
                            </span>
                        </div>

                        <div class="mb-24">
                            <label asp-for="Password"
                                   class="text-neutral-900 text-lg mb-8 font-[500]">
                                Mật khẩu <span class="text-danger-600">*</span>
                            </label>

                            <div class="relative">
                                <input asp-for="Password"
                                       class="common-input"
                                       type="password"
                                       autocomplete="current-password"
                                       placeholder="Nhập mật khẩu" />

                                <button type="button"
                                        class="toggle-password absolute top-[50%] right-0 me-16 translate-y-[-50%] cursor-pointer"
                                        data-target="#Password"
                                        aria-label="Hiện mật khẩu"
                                        aria-pressed="false">
                                    <i class="ph ph-eye-slash"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger-600 text-sm">
                            </span>
                        </div>

                        <div class="mb-24 mt-32">
                            <div class="flex items-center flex-wrap gap-24">

                                <button type="submit"
                                        class="btn btn-main py-18 px-40">
                                    Đăng nhập
                                </button>

                                <div class="form-check common-check">
                                    <input asp-for="RememberMe"
                                           class="form-check-input" />

                                    <label asp-for="RememberMe"
                                           class="form-check-label flex-grow">
                                        Ghi nhớ đăng nhập
                                    </label>
                                </div>

                                <div class="ms-auto">
                                    <a asp-controller="Account"
                                       asp-action="ForgotPassword"
                                       class="text-main-600 text-sm font-[500]">
                                        Quên mật khẩu?
                                    </a>
                                </div>

                            </div>
                        </div>

                    </form>

