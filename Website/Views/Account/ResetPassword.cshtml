@using Website.Models.Account
@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu | Caterin";
}

<!-- Reset Password -->
<section class="flex min-h-[70vh] items-center bg-[#FAFCF9] px-4 py-12 sm:py-16 lg:py-20">
    <div class="mx-auto w-full max-w-7xl">

        <div class="mx-auto max-w-xl">

            <!-- Reset Password Card -->
            <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm sm:p-8 lg:p-10">

                <!-- Heading -->
                <div class="mb-8 text-center">

                    <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-[#F1F8EF] text-3xl text-[#1F9345]">
                        <i class="ph ph-lock-key-open"></i>
                    </div>

                    <span class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-[#F1F8EF] px-3 py-1 text-xs font-semibold text-[#1F9345]">
                        <i class="ph ph-shield-check"></i>
                        Bảo mật tài khoản
                    </span>

                    <h1 class="mt-4 text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">
                        Đặt lại mật khẩu
                    </h1>

                    <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-gray-500 sm:text-base">
                        Vui lòng tạo mật khẩu mới để tiếp tục sử dụng tài khoản Caterin.
                    </p>
                </div>

                <!-- Form -->
                <form asp-controller="Account"
                      asp-action="ResetPassword"
                      method="post"
                      data-auth-form
                      data-ajax="true">

                    @Html.AntiForgeryToken()

                    <input asp-for="Key" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         data-valmsg-summary="true"
                         class="mb-5 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-600">
                    </div>

                    <!-- New Password -->
                    <div class="mb-5">
                        <label asp-for="Password"
                               class="mb-2 block text-sm font-semibold text-gray-800">
                            Mật khẩu mới <span class="text-red-500">*</span>
                        </label>

                        <div class="relative">
                            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-lg text-gray-400">
                                <i class="ph ph-lock"></i>
                            </span>

                            <input asp-for="Password"
                                   type="password"
                                   class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/70 pl-11 pr-12 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10"
                                   placeholder="Nhập mật khẩu mới"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 cursor-pointer text-xl text-gray-400 transition hover:text-[#1F9345]"
                                    data-target="#Password"
                                    aria-label="Hiện mật khẩu"
                                    aria-pressed="false">
                                <i class="ph ph-eye-slash"></i>
                            </button>
                        </div>

                        <span asp-validation-for="Password"
                              class="mt-1.5 block text-sm text-red-600"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="mb-6">
                        <label asp-for="ConfirmPassword"
                               class="mb-2 block text-sm font-semibold text-gray-800">
                            Xác nhận mật khẩu <span class="text-red-500">*</span>
                        </label>

                        <div class="relative">
                            <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-lg text-gray-400">
                                <i class="ph ph-lock-key"></i>
                            </span>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/70 pl-11 pr-12 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10"
                                   placeholder="Nhập lại mật khẩu mới"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="toggle-password absolute right-4 top-1/2 -translate-y-1/2 cursor-pointer text-xl text-gray-400 transition hover:text-[#1F9345]"
                                    data-target="#ConfirmPassword"
                                    aria-label="Hiện mật khẩu"
                                    aria-pressed="false">
                                <i class="ph ph-eye-slash"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="mt-1.5 block text-sm text-red-600"></span>
                    </div>

                    <!-- Security Note -->
                    <div class="mb-7 rounded-xl border border-[#DCEBDD] bg-[#F7FAF6] p-4">
                        <div class="flex items-start gap-3">
                            <i class="ph ph-shield-check mt-0.5 shrink-0 text-xl text-[#1F9345]"></i>

                            <div>
                                <p class="text-sm font-semibold text-gray-800">
                                    Bảo vệ tài khoản của bạn
                                </p>

                                <p class="mt-1 text-xs leading-5 text-gray-500 sm:text-sm">
                                    Hãy sử dụng mật khẩu đủ mạnh và không chia sẻ mật khẩu với người khác.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Submit -->
                    <button type="submit"
                            class="inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 text-sm font-semibold text-white shadow-sm transition hover:bg-[#187A38] hover:shadow-md focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20">
                        <i class="ph ph-check-circle text-lg"></i>
                        Cập nhật mật khẩu
                    </button>

                </form>

            </div>

            <!-- Footer -->
            <p class="mt-5 text-center text-xs text-gray-400">
                Caterin – An toàn cho mọi nhà
            </p>

        </div>
    </div>
</section>
