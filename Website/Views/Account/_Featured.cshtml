@{
    Layout = null;
}

<div class="min-w-0 lg:col-span-6"
     data-aos="fade-up"
     data-aos-duration="600">

    <!-- Main card -->
    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

        <!-- Heading -->
        <div class="border-b border-[#E5EDE2] bg-[#F1F8EF] px-5 py-5 sm:px-7">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-[#1F9345]">
                        Caterin Selection
                    </p>

                    <h3 class="text-xl font-bold tracking-tight text-gray-900">
                        Sản phẩm nổi bật
                    </h3>
                </div>

                <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white text-2xl text-[#1F9345] shadow-sm">
                    <i class="ph ph-sparkle"></i>
                </span>
            </div>
        </div>

        <!-- Product list background -->
        <div class="bg-[#F7FAF6] p-4 sm:p-5">

            <div class="space-y-3">

                <!-- Product 1 -->
                <article class="group flex gap-4 rounded-xl border border-gray-200 bg-white p-3 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-[#1F9345]/30 hover:shadow-md sm:p-4">
                    <a href="product-details.html"
                       class="flex size-20 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-100 bg-gray-50 sm:size-24">
                        <img src="~/images/Demos/short-product-img1.png"
                             alt="Sản phẩm nổi bật"
                             class="size-full object-contain transition duration-300 group-hover:scale-105" />
                    </a>

                    <div class="min-w-0 flex-1 self-center">
                        <div class="mb-2 flex items-center gap-1.5 text-xs">
                            <span class="font-semibold text-gray-600">4.8</span>
                            <i class="ph-fill ph-star text-amber-400"></i>
                            <span class="text-gray-400">(17k)</span>
                        </div>

                        <h4 class="line-clamp-2 text-sm font-semibold leading-5 text-gray-900">
                            <a href="product-details.html"
                               class="transition group-hover:text-[#1F9345]">
                                Taylor Farms Broccoli Florets Vegetables
                            </a>
                        </h4>

                        <div class="mt-2 flex flex-wrap items-center gap-2">
                            <span class="text-sm font-bold text-[#1F9345]">
                                $1500.00
                            </span>
                            <span class="text-xs text-gray-400 line-through">
                                $1500.00
                            </span>
                        </div>
                    </div>
                </article>

