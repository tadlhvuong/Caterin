
@{
    ViewData["Title"] = "Blog - Chia sẻ cùng Caterin";

    var posts = new[]
    {
        new {
            Image = "/images/Demos/blog-img1.png",
            Category = "Mẹo vệ sinh",
            Title = "5 mẹo giữ cho căn bếp luôn sạch sẽ và thơm mát",
            Description = "Khám phá những thói quen đơn giản giúp căn bếp luôn gọn gàng, sạch sẽ và dễ chịu mỗi ngày.",
            Date = "12/07/2026",
            Comments = 0
        },
        new {
            Image = "/images/Demos/blog-img2.png",
            Category = "Chăm sóc gia đình",
            Title = "Bí quyết chăm sóc không gian sống cho cả gia đình",
            Description = "Một không gian sống sạch sẽ không chỉ tạo cảm giác thoải mái mà còn góp phần nâng cao chất lượng cuộc sống.",
            Date = "08/07/2026",
            Comments = 3
        },
        new {
            Image = "/images/Demos/blog-img3.png",
            Category = "Sống xanh",
            Title = "Bắt đầu lối sống xanh từ những điều giản dị",
            Description = "Những thay đổi nhỏ trong thói quen vệ sinh và sinh hoạt có thể giúp bạn hướng đến một không gian sống bền vững hơn.",
            Date = "02/07/2026",
            Comments = 2
        }
    };

    var recentPosts = new[]
    {
        new {
            Image = "/images/Demos/recent-post1.png",
            Title = "Cách giữ nhà cửa sạch thơm trong những ngày mưa",
            Date = "12/07/2026"
        },
        new {
            Image = "/images/Demos/recent-post2.png",
            Title = "Mẹo làm sạch căn bếp nhanh chóng mỗi ngày",
            Date = "08/07/2026"
        },
        new {
            Image = "/images/Demos/recent-post3.png",
            Title = "Chăm sóc tổ ấm với những thói quen nhỏ",
            Date = "05/07/2026"
        },
        new {
            Image = "/images/Demos/recent-post4.png",
            Title = "Không gian sống xanh bắt đầu từ đâu?",
            Date = "02/07/2026"
        }
    };

    var categories = new[]
    {
        new { Name = "Mẹo vệ sinh", Count = 12 },
        new { Name = "Chăm sóc gia đình", Count = 8 },
        new { Name = "Sống xanh", Count = 5 },
        new { Name = "Hướng dẫn sử dụng", Count = 9 },
        new { Name = "Tin tức Caterin", Count = 4 },
        new { Name = "Chia sẻ kinh nghiệm", Count = 6 }
    };

    var benefits = new[]
    {
        new {
            Icon = "ph-truck",
            Title = "Giao hàng toàn quốc",
            Description = "Đưa sản phẩm đến tận nhà bạn."
        },
        new {
            Icon = "ph-hand-heart",
            Title = "Chăm sóc tận tâm",
            Description = "Luôn đặt trải nghiệm khách hàng lên hàng đầu."
        },
        new {
            Icon = "ph-shield-check",
            Title = "Thanh toán an toàn",
            Description = "Hỗ trợ nhiều phương thức thanh toán."
        },
        new {
            Icon = "ph-chats-circle",
            Title = "Hỗ trợ khách hàng",
            Description = "Luôn sẵn sàng giải đáp thắc mắc."
        }
    };
}

@* ========================= BREADCRUMB ========================= *@
<section class="border-b border-gray-100 bg-gradient-to-r from-[#f2f9ed] to-[#f7fbf6] py-5">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-xl font-bold text-gray-900 sm:text-2xl">
                    Blog Caterin
                </h1>
                <p class="mt-1 text-sm text-gray-500">
                    Chia sẻ kiến thức chăm sóc gia đình và không gian sống.
                </p>
            </div>

            <nav aria-label="Breadcrumb">
                <ol class="flex flex-wrap items-center gap-2 text-sm">
                    <li>
                        <a href="/"
                           class="inline-flex items-center gap-2 text-gray-500 transition hover:text-[#1F9345]">
                            <i class="ph ph-house text-lg"></i>
                            Trang chủ
                        </a>
                    </li>
                    <li class="text-gray-300">
                        <i class="ph ph-caret-right"></i>
                    </li>
                    <li class="font-semibold text-[#1F9345]" aria-current="page">
                        Blog
                    </li>
                </ol>
            </nav>
        </div>
    </div>
</section>

@* ========================= BLOG CONTENT ========================= *@
<section class="py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-12">

            @* ========================= POST LIST ========================= *@
            <div class="min-w-0 lg:col-span-8">
                <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#1F9345]">
                            Our Blog
                        </span>
                        <h2 class="mt-2 text-2xl font-extrabold text-gray-900 sm:text-3xl">
                            Bài viết mới nhất
                        </h2>
                    </div>

                    <span class="rounded-full bg-[#eaf6e9] px-4 py-2 text-xs font-semibold text-[#1F9345]">
                        <i class="ph ph-article mr-1"></i>
                        Kiến thức & chia sẻ
                    </span>
                </div>

                <div class="space-y-8">
                    @foreach (var post in posts)
                    {
                        <article class="group overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-[#8CC63F]/40 hover:shadow-xl">

                            <a href="/blog-details"
                               class="relative block aspect-[16/9] overflow-hidden bg-[#f2f8ef]">
                                <img src="@post.Image"
                                     alt="@post.Title"
                                     class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                                     loading="lazy">

                                <span class="absolute left-5 top-5 rounded-full bg-white/95 px-4 py-2 text-xs font-bold text-[#1F9345] shadow-sm backdrop-blur">
                                    @post.Category
                                </span>
                            </a>

                            <div class="p-5 sm:p-7 lg:p-8">
                                <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-500">
                                    <span class="inline-flex items-center gap-2">
                                        <i class="ph ph-calendar-dots text-lg text-[#1F9345]"></i>
                                        @post.Date
                                    </span>

                                    <span class="inline-flex items-center gap-2">
                                        <i class="ph ph-chats-circle text-lg text-[#1F9345]"></i>
                                        @post.Comments bình luận
                                    </span>
                                </div>

                                <h3 class="mt-4 text-xl font-bold leading-snug text-gray-900 transition group-hover:text-[#1F9345] sm:text-2xl">
                                    <a href="/blog-details">
                                        @post.Title
                                    </a>
                                </h3>

                                <p class="mt-3 line-clamp-2 text-sm leading-7 text-gray-500 sm:text-base">
                                    @post.Description
                                </p>

                                <div class="mt-6 flex items-center justify-between border-t border-gray-100 pt-5">
                                    <a href="/blog-details"
                                       class="inline-flex items-center gap-2 text-sm font-bold text-[#1F9345] transition hover:gap-3">
                                        Đọc tiếp
                                        <i class="ph-bold ph-arrow-right text-lg"></i>
                                    </a>

                                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#f2f8ef] text-lg text-[#1F9345] transition group-hover:bg-[#1F9345] group-hover:text-white">
                                        <i class="ph ph-arrow-up-right"></i>
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                @* ========================= PAGINATION ========================= *@
                <nav class="mt-12 flex flex-wrap items-center justify-center gap-2"
                     aria-label="Phân trang">
                    <a href="#"
                       aria-label="Trang trước"
                       class="flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-500 transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white">
                        <i class="ph-bold ph-arrow-left"></i>
                    </a>

                    <a href="#"
                       aria-current="page"
                       class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#1F9345] bg-[#1F9345] text-sm font-bold text-white shadow-md shadow-green-800/15">
                        01
                    </a>

                    @for (var pageNumber = 2; pageNumber <= 5; pageNumber++)
                    {
                        <a href="#"
                           class="flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-white text-sm font-semibold text-gray-600 transition hover:border-[#1F9345] hover:bg-[#eaf6e9] hover:text-[#1F9345]">
                            @pageNumber.ToString("00")
                        </a>
                    }

                    <a href="#"
                       aria-label="Trang tiếp theo"
                       class="flex h-11 w-11 items-center justify-center rounded-xl border border-gray-200 bg-white text-gray-500 transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white">
                        <i class="ph-bold ph-arrow-right"></i>
                    </a>
                </nav>
            </div>

            @* ========================= SIDEBAR ========================= *@
            <aside class="space-y-6 lg:col-span-4">

                @* SEARCH *@
                <div class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm sm:p-7">
                    <h3 class="border-b border-gray-100 pb-5 text-lg font-bold text-gray-900">
                        Tìm kiếm bài viết
                    </h3>

                    <form action="/blog" method="get" class="mt-5">
                        <label for="blogKeyword" class="sr-only">Từ khóa tìm kiếm</label>

                        <div class="flex items-center gap-2 rounded-xl border border-gray-200 bg-gray-50 p-1.5 transition focus-within:border-[#1F9345] focus-within:bg-white">
                            <input id="blogKeyword"
                                   type="search"
                                   name="keyword"
                                   placeholder="Bạn đang tìm gì?"
                                   class="min-w-0 flex-1 border-0 bg-transparent px-3 py-3 text-sm text-gray-700 outline-none placeholder:text-gray-400 focus:ring-0">

                            <button type="submit"
                                    aria-label="Tìm kiếm"
                                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[#1F9345] text-xl text-white transition hover:bg-[#16783a]">
                                <i class="ph ph-magnifying-glass"></i>
                            </button>
                        </div>
                    </form>
                </div>

                @* RECENT POSTS *@
                <div class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm sm:p-7">
                    <h3 class="border-b border-gray-100 pb-5 text-lg font-bold text-gray-900">
                        Bài viết gần đây
                    </h3>

                    <div class="mt-5 space-y-5">
                        @foreach (var post in recentPosts)
                        {
                            <article class="group flex gap-4">
                                <a href="/blog-details"
                                   class="h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-[#f2f8ef]">
                                    <img src="@post.Image"
                                         alt="@post.Title"
                                         class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
                                         loading="lazy">
                                </a>

                                <div class="min-w-0 flex-1">
                                    <h4 class="line-clamp-2 text-sm font-bold leading-6 text-gray-800 transition group-hover:text-[#1F9345]">
                                        <a href="/blog-details">
                                            @post.Title
                                        </a>
                                    </h4>

                                    <span class="mt-2 inline-flex items-center gap-2 text-xs text-gray-400">
                                        <i class="ph ph-calendar-dots text-[#1F9345]"></i>
                                        @post.Date
                                    </span>
                                </div>
                            </article>
                        }
                    </div>
                </div>

                @* CATEGORIES *@
                <div class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm sm:p-7">
                    <h3 class="border-b border-gray-100 pb-5 text-lg font-bold text-gray-900">
                        Danh mục bài viết
                    </h3>

                    <ul class="mt-5 space-y-3">
                        @foreach (var category in categories)
                        {
                            <li>
                                <a href="/blog"
                                   class="group flex items-center justify-between gap-3 rounded-xl border border-gray-100 p-3 transition hover:border-[#8CC63F]/40 hover:bg-[#f5faf2]">
                                    <span class="flex items-center gap-3 text-sm font-medium text-gray-600 transition group-hover:text-[#1F9345]">
                                        <i class="ph ph-folder text-lg text-[#1F9345]"></i>
                                        @category.Name
                                    </span>

                                    <span class="flex h-8 min-w-8 items-center justify-center rounded-lg bg-[#eaf6e9] px-2 text-xs font-bold text-[#1F9345]">
                                        @category.Count
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                @* BRAND CTA *@
                <div class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-[#16783a] to-[#249e63] p-7 text-white shadow-lg">
                    <div class="pointer-events-none absolute -right-12 -top-12 h-40 w-40 rounded-full border border-white/15"></div>
                    <div class="pointer-events-none absolute -bottom-16 -left-12 h-48 w-48 rounded-full bg-white/5 blur-2xl"></div>

                    <div class="relative">
                        <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/15 text-2xl">
                            <i class="ph-fill ph-leaf"></i>
                        </span>

                        <h3 class="mt-5 text-xl font-extrabold">
                            Chăm sóc tổ ấm cùng Caterin
                        </h3>

                        <p class="mt-3 text-sm leading-7 text-white/80">
                            Khám phá các sản phẩm chăm sóc gia đình,
                            hướng đến không gian sống sạch sẽ và thơm mát.
                        </p>

                        <a href="/shop"
                           class="mt-6 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-[#1F9345] transition hover:-translate-y-1 hover:bg-[#eaf6e9]">
                            Khám phá sản phẩm
                            <i class="ph-bold ph-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

@* ========================= SERVICE BENEFITS ========================= *@
<section class="mb-12 sm:mb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var item in benefits)
            {
                <div class="group flex items-center gap-4 rounded-2xl border border-gray-100 bg-[#f7faf6] p-5 transition duration-300 hover:-translate-y-1 hover:border-[#8CC63F]/40 hover:bg-[#f0f8ed] hover:shadow-md">
                    <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-2xl text-white shadow-md shadow-green-800/15 transition group-hover:scale-105">
                        <i class="ph-fill @item.Icon"></i>
                    </span>

                    <div class="min-w-0">
                        <h3 class="text-sm font-bold text-gray-900 sm:text-base">
                            @item.Title
                        </h3>
                        <p class="mt-1 text-xs leading-5 text-gray-500">
                            @item.Description
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
