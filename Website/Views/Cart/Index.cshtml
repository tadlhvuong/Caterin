@{
    ViewData["Title"] = "Giỏ hàng | Caterin";
}

<div class="bg-[#F7FAF6]">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-500"
             aria-label="Breadcrumb">
            <a href="/" class="transition hover:text-[#1F9345]">
                Trang chủ
            </a>

            <i class="ph ph-caret-right text-xs"></i>

            <span class="font-medium text-gray-900">
                Giỏ hàng
            </span>
        </nav>

        <!-- Heading -->
        <div class="mt-8 flex flex-wrap items-end justify-between gap-4">
            <div>
                <span class="text-sm font-semibold text-[#1F9345]">
                    CATERIN SHOP
                </span>

                <h1 class="mt-1 text-2xl font-bold text-gray-900 sm:text-3xl">
                    Giỏ hàng của bạn
                </h1>

                <p class="mt-2 text-sm text-gray-500">
                    Kiểm tra sản phẩm và số lượng trước khi đặt hàng.
                </p>
            </div>

            <a href="/shop"
               class="inline-flex items-center gap-2 text-sm font-semibold text-[#1F9345] transition hover:text-[#18783A]">
                <i class="ph ph-arrow-left"></i>
                Tiếp tục mua sắm
            </a>
        </div>

        <!-- Cart content -->
        <div class="mt-8 grid grid-cols-1 items-start gap-6 lg:grid-cols-3">

            <!-- Cart items -->
            <section class="min-w-0 lg:col-span-2">
                <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">

                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 px-5 py-4 sm:px-6">
                        <div>
                            <h2 class="font-bold text-gray-900">
                                Sản phẩm đã chọn
                            </h2>

                            <p class="mt-1 text-sm text-gray-500">
                                <span id="cartItemCount">0</span> sản phẩm
                            </p>
                        </div>

                        <button type="button"
                                id="clearCartButton"
                                class="hidden text-sm font-medium text-red-500 transition hover:text-red-700">
                            <i class="ph ph-trash mr-1"></i>
                            Xóa tất cả
                        </button>
                    </div>

                    <!-- Loading -->
                    <div id="cartLoading"
                         class="px-6 py-16 text-center">
                        <i class="ph ph-spinner-gap animate-spin text-3xl text-[#1F9345]"></i>
                        <p class="mt-3 text-sm text-gray-500">
                            Đang tải giỏ hàng...
                        </p>
                    </div>

                    <!-- Product list -->
                    <div id="cartItems"
                         class="hidden divide-y divide-gray-100">
                    </div>

                    <!-- Empty state -->
                    <div id="cartEmpty"
                         class="hidden px-6 py-16 text-center">
                        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                            <i class="ph ph-shopping-cart text-4xl"></i>
                        </div>

                        <h2 class="mt-5 text-lg font-bold text-gray-900">
                            Giỏ hàng đang trống
                        </h2>

                        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500">
                            Bạn chưa có sản phẩm nào trong giỏ hàng.
                            Hãy khám phá các sản phẩm chăm sóc nhà cửa từ Caterin nhé.
                        </p>

                        <a href="/shop"
                           class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-[#1F9345] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#18783A]">
                            Khám phá sản phẩm
                            <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>

                    <!-- Error state -->
                    <div id="cartError"
                         class="hidden px-6 py-12 text-center">
                        <i class="ph ph-warning-circle text-3xl text-amber-500"></i>

                        <p class="mt-3 text-sm text-gray-600">
                            Không thể tải thông tin giỏ hàng.
                        </p>

                        <button type="button"
                                id="retryCartButton"
                                class="mt-4 rounded-lg border border-[#1F9345] px-5 py-2 text-sm font-semibold text-[#1F9345] transition hover:bg-[#EAF5E7]">
                            Thử lại
                        </button>
                    </div>
                </div>

                <!-- Shopping note -->
                <div class="mt-5 flex items-start gap-3 rounded-xl border border-[#DCEED8] bg-[#F3FAF0] p-4">
                    <i class="ph ph-leaf mt-0.5 text-xl text-[#1F9345]"></i>

                    <div>
                        <p class="text-sm font-semibold text-gray-800">
                            Chăm sóc nhà cửa an toàn hơn cùng Caterin
                        </p>

                        <p class="mt-1 text-xs leading-5 text-gray-500">
                            Sản phẩm vệ sinh gia đình với hương thơm dễ chịu,
                            hướng đến trải nghiệm sạch sẽ và an tâm mỗi ngày.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Order summary -->
            <aside class="lg:sticky lg:top-24">
                <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
                    <h2 class="text-lg font-bold text-gray-900">
                        Tóm tắt đơn hàng
                    </h2>

                    <div class="mt-5 space-y-4 text-sm">
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-gray-500">
                                Số lượng sản phẩm
                            </span>

                            <span id="summaryQuantity"
                                  class="font-semibold text-gray-900">
                                0
                            </span>
                        </div>

                        <div class="flex items-center justify-between gap-3">
                            <span class="text-gray-500">
                                Tạm tính
                            </span>

                            <span id="cartSubtotal"
                                  class="font-semibold text-gray-900">
                                0₫
                            </span>
                        </div>

                        <div class="flex items-center justify-between gap-3">
                            <span class="text-gray-500">
                                Phí vận chuyển
                            </span>

                            <span class="text-xs text-gray-400">
                                Tính tại bước thanh toán
                            </span>
                        </div>
                    </div>

                    <div class="my-5 border-t border-dashed border-gray-200"></div>

                    <div class="flex items-center justify-between gap-3">
                        <span class="font-bold text-gray-900">
                            Tổng tạm tính
                        </span>

                        <span id="cartTotal"
                              class="text-xl font-bold text-[#1F9345]">
                            0₫
                        </span>
                    </div>

                    <p class="mt-2 text-xs leading-5 text-gray-400">
                        Phí vận chuyển và ưu đãi (nếu có) sẽ được xác nhận
                        ở bước thanh toán.
                    </p>

                    <a href="/checkout"
                       id="checkoutButton"
                       class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-5 py-3.5 text-sm font-bold text-white transition hover:bg-[#18783A]">
                        Tiến hành đặt hàng
                        <i class="ph ph-arrow-right text-lg"></i>
                    </a>

                    <div class="mt-4 flex items-center justify-center gap-2 text-xs text-gray-400">
                        <i class="ph ph-shield-check text-base text-[#1F9345]"></i>
                        Thanh toán an toàn và bảo mật
                    </div>
                </div>

                <!-- Benefits -->
                <div class="mt-4 space-y-3 rounded-2xl border border-gray-100 bg-white p-5">
                    <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                            <i class="ph ph-truck text-lg"></i>
                        </div>

                        <div>
                            <p class="text-sm font-semibold text-gray-800">
                                Giao hàng tận nơi
                            </p>
                            <p class="text-xs text-gray-500">
                                Nhận hàng thuận tiện
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                            <i class="ph ph-headset text-lg"></i>
                        </div>

                        <div>
                            <p class="text-sm font-semibold text-gray-800">
                                Hỗ trợ khách hàng
                            </p>
                            <p class="text-xs text-gray-500">
                                Luôn sẵn sàng hỗ trợ bạn
                            </p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart/cart.js" asp-append-version="true"></script>
}
