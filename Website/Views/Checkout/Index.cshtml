@{
    ViewData["Title"] = "Thanh toán | Caterin";
}

@* ========================= BREADCRUMB ========================= *@
<section class="bg-[#f1f8ee] py-5">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-xl font-bold text-gray-900">Thanh toán</h1>

            <nav aria-label="Breadcrumb">
                <ol class="flex flex-wrap items-center gap-2 text-sm">
                    <li>
                        <a href="/"
                           class="inline-flex items-center gap-2 text-gray-600 transition hover:text-[#1F9345]">
                            <i class="ph ph-house text-base"></i>
                            Trang chủ
                        </a>
                    </li>
                    <li class="text-gray-400">
                        <i class="ph ph-caret-right"></i>
                    </li>
                    <li class="font-medium text-[#1F9345]">Thanh toán</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

@* ========================= CHECKOUT ========================= *@
<section class="py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        @* Coupon notice *@
        <div class="mb-8 flex flex-wrap items-center gap-2 rounded-xl border border-[#dcebd7] bg-[#f8fbf6] px-5 py-4 text-sm text-gray-700">
            <i class="ph ph-ticket text-xl text-[#1F9345]"></i>
            <span>Bạn có mã giảm giá?</span>
            <a href="/cart"
               class="font-semibold text-[#1F9345] underline-offset-4 transition hover:underline">
                Nhấn vào đây để nhập mã
            </a>
        </div>

        <form asp-controller="Checkout" asp-action="PlaceOrder"  method="post">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 gap-8 xl:grid-cols-12 xl:gap-10">

                @* ========================= BILLING DETAILS ========================= *@
                <div class="xl:col-span-7 2xl:col-span-8">
                    <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-7">

                        <div class="mb-7 border-b border-gray-100 pb-5">
                            <h2 class="text-xl font-bold text-gray-900">
                                Thông tin nhận hàng
                            </h2>
                            <p class="mt-2 text-sm text-gray-500">
                                Vui lòng cung cấp thông tin chính xác để Caterin giao hàng đến bạn.
                            </p>
                        </div>

                        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

                            @* Họ và tên *@
                            <div>
                                <label for="firstName"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Họ <span class="text-red-500">*</span>
                                </label>
                                <input id="firstName"
                                       name="FirstName"
                                       type="text"
                                       autocomplete="given-name"
                                       placeholder="Nhập họ"
                                       required
                                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10" />
                            </div>

                            <div>
                                <label for="lastName"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Tên <span class="text-red-500">*</span>
                                </label>
                                <input id="lastName"
                                       name="LastName"
                                       type="text"
                                       autocomplete="family-name"
                                       placeholder="Nhập tên"
                                       required
                                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10" />
                            </div>

                            @* Tên công ty *@
                            <div class="sm:col-span-2">
                                <label for="company"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Tên công ty
                                    <span class="font-normal text-gray-400">(Không bắt buộc)</span>
                                </label>
                                <input id="company"
                                       name="Company"
                                       type="text"
                                       autocomplete="organization"
                                       placeholder="Tên công ty (nếu có)"
                                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10" />
                            </div>

                            @* Địa chỉ *@
                            <div class="sm:col-span-2">
                                <label for="country"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Quốc gia <span class="text-red-500">*</span>
                                </label>
                                <select id="country"
                                        name="Country"
                                        required
                                        class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10">
                                    <option value="VN" selected>Việt Nam</option>
                                </select>
                            </div>

                            <div class="sm:col-span-2">
                                <label for="address"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Địa chỉ nhận hàng <span class="text-red-500">*</span>
                                </label>
                                <input id="address"
                                       name="Address"
                                       type="text"
                                       autocomplete="street-address"
                                       placeholder="Số nhà, tên đường..."
                                       required
                                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10" />
                            </div>

                            <div class="sm:col-span-2">
                                <label for="addressDetail"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Căn hộ, tầng, tòa nhà
                                    <span class="font-normal text-gray-400">(Không bắt buộc)</span>
                                </label>
                                <input id="addressDetail"
                                       name="AddressDetail"
                                       type="text"
                                       autocomplete="address-line-2"
                                       placeholder="Căn hộ, tầng, tòa nhà..."
                                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10" />
                            </div>

                            <div>
                                <label for="province"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Tỉnh / Thành phố <span class="text-red-500">*</span>
                                </label>
                                <select id="province"
                                        name="ProvinceCode"
                                        required
                                        class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10">
                                    <option value="">Chọn tỉnh / thành phố</option>
                                    <option value="1">Thành phố test</option>
                                </select>
                            </div>

                            <div>
                                <label for="ward"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Phường / Xã <span class="text-red-500">*</span>
                                </label>
                                <select id="ward"
                                        name="WardCode"
                                        required
                                        class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10">
                                    <option value="">Chọn phường / xã</option>
                                    <option value="11">Phường test</option>
                                </select>
                            </div>

                            @* Liên hệ *@
                            <div>
                                <label for="phone"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Số điện thoại <span class="text-red-500">*</span>
                                </label>
                                <input id="phone"
                                       name="Phone"
                                       type="tel"
                                       autocomplete="tel"
                                       placeholder="Ví dụ: 09xxxxxxxx"
                                       required
                                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10" />
                            </div>

                            <div>
                                <label for="email"
                                       class="mb-2 block text-sm font-semibold text-gray-700">
                                    Email <span class="text-red-500">*</span>
                                </label>
                                <input id="email"
                                       name="Email"
                                       type="email"
                                       autocomplete="email"
                                       placeholder="example@email.com"
                                       required
                                       class="w-full rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10" />
                            </div>

                        </div>

                        @* Additional Information *@
                        <div class="mt-9 border-t border-gray-100 pt-7">
                            <h3 class="mb-2 text-lg font-bold text-gray-900">
                                Thông tin bổ sung
                            </h3>
                            <p class="mb-5 text-sm text-gray-500">
                                Để lại lời nhắn nếu bạn có yêu cầu đặc biệt về đơn hàng hoặc giao hàng.
                            </p>

                            <label for="orderNotes"
                                   class="mb-2 block text-sm font-semibold text-gray-700">
                                Ghi chú đơn hàng
                            </label>
                            <textarea id="orderNotes"
                                      name="OrderNotes"
                                      rows="4"
                                      placeholder="Ví dụ: Giao hàng ngoài giờ hành chính, vui lòng gọi trước khi giao..."
                                      class="w-full resize-y rounded-xl border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10"></textarea>
                        </div>

                    </div>
                </div>

                @* ========================= ORDER SUMMARY ========================= *@
                <div class="xl:col-span-5 2xl:col-span-4">
                    <div class="xl:sticky xl:top-6">

                        <div class="rounded-2xl bg-gradient-to-r from-[#1F9345] to-[#249e63] px-6 py-5 text-white">
                            <div class="flex items-center gap-3">
                                <i class="ph ph-shopping-bag-open text-2xl"></i>
                                <h2 class="text-xl font-bold">Đơn hàng của bạn</h2>
                            </div>
                            <p class="mt-1 text-sm text-white/80">
                                Kiểm tra sản phẩm trước khi đặt hàng.
                            </p>
                        </div>

                        <div class="mt-4 rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">

                            @* Product heading *@
                            <div class="mb-5 flex items-center justify-between border-b border-gray-100 pb-4">
                                <span class="font-semibold text-gray-900">Sản phẩm</span>
                                <span class="font-semibold text-gray-900">Thành tiền</span>
                            </div>

                            @* Demo product 1 *@
                            <div class="mb-5 flex items-start justify-between gap-4">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium leading-6 text-gray-800">
                                        Nước rửa chén Caterin Hương Cam Quế
                                    </p>
                                    <p class="mt-1 text-xs text-gray-500">
                                        Đơn giá: 125.000 ₫
                                        <span class="mx-1">×</span>
                                        <span class="font-semibold text-gray-700">1</span>
                                    </p>
                                </div>
                                <span class="shrink-0 text-sm font-bold text-gray-900">
                                    125.000 ₫
                                </span>
                            </div>

                            @* Demo product 2 *@
                            <div class="mb-5 flex items-start justify-between gap-4">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium leading-6 text-gray-800">
                                        Nước rửa tay Caterin Hương Sen
                                    </p>
                                    <p class="mt-1 text-xs text-gray-500">
                                        Đơn giá: 125.000 ₫
                                        <span class="mx-1">×</span>
                                        <span class="font-semibold text-gray-700">1</span>
                                    </p>
                                </div>
                                <span class="shrink-0 text-sm font-bold text-gray-900">
                                    125.000 ₫
                                </span>
                            </div>

                            @* Demo product 3 *@
                            <div class="mb-5 flex items-start justify-between gap-4">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium leading-6 text-gray-800">
                                        Nước lau sàn Caterin Hương Lavender
                                    </p>
                                    <p class="mt-1 text-xs text-gray-500">
                                        Đơn giá: 125.000 ₫
                                        <span class="mx-1">×</span>
                                        <span class="font-semibold text-gray-700">1</span>
                                    </p>
                                </div>
                                <span class="shrink-0 text-sm font-bold text-gray-900">
                                    125.000 ₫
                                </span>
                            </div>

                            @* Demo product 4 *@
                            <div class="mb-5 flex items-start justify-between gap-4">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium leading-6 text-gray-800">
                                        Nước rửa tay Caterin Hương Táo Kiwi
                                    </p>
                                    <p class="mt-1 text-xs text-gray-500">
                                        Đơn giá: 125.000 ₫
                                        <span class="mx-1">×</span>
                                        <span class="font-semibold text-gray-700">1</span>
                                    </p>
                                </div>
                                <span class="shrink-0 text-sm font-bold text-gray-900">
                                    125.000 ₫
                                </span>
                            </div>

                            @* Order totals *@
                            <div class="mt-6 space-y-4 border-t border-gray-100 pt-5">
                                <div class="flex items-center justify-between gap-4">
                                    <span class="text-sm text-gray-600">Tạm tính</span>
                                    <span class="text-sm font-semibold text-gray-900">
                                        500.000 ₫
                                    </span>
                                </div>

                                <div class="flex items-center justify-between gap-4">
                                    <span class="text-sm text-gray-600">Phí vận chuyển</span>
                                    <span class="text-sm font-medium text-gray-500">
                                        Tính sau
                                    </span>
                                </div>

                                <div class="flex items-center justify-between gap-4">
                                    <span class="text-sm text-gray-600">Giảm giá</span>
                                    <span class="text-sm font-medium text-gray-500">
                                        0 ₫
                                    </span>
                                </div>

                                <div class="flex items-center justify-between gap-4 border-t border-dashed border-gray-200 pt-5">
                                    <span class="text-base font-bold text-gray-900">Tổng cộng</span>
                                    <span class="text-xl font-bold text-[#1F9345]">
                                        500.000 ₫
                                    </span>
                                </div>
                            </div>

                            @* Payment methods *@
                            <div class="mt-7 border-t border-gray-100 pt-6">
                                <h3 class="mb-4 text-base font-bold text-gray-900">
                                    Phương thức thanh toán
                                </h3>

                                <div class="space-y-3">

                                    <label for="paymentCod"
                                           class="flex cursor-pointer items-start gap-3 rounded-xl border border-[#1F9345] bg-[#f5faf2] p-4 transition">
                                        <input id="paymentCod"
                                               type="radio"
                                               name="PaymentMethod"
                                               value="COD"
                                               checked
                                               class="mt-1 h-4 w-4 shrink-0 accent-[#1F9345]" />
                                        <span class="min-w-0 flex-1">
                                            <span class="flex items-center gap-2 text-sm font-semibold text-gray-900">
                                                <i class="ph ph-truck text-lg text-[#1F9345]"></i>
                                                Thanh toán khi nhận hàng (COD)
                                            </span>
                                            <span class="mt-1 block text-xs leading-5 text-gray-500">
                                                Thanh toán trực tiếp cho đơn vị vận chuyển khi nhận được hàng.
                                            </span>
                                        </span>
                                    </label>

                                    <label for="paymentBank"
                                           class="flex cursor-pointer items-start gap-3 rounded-xl border border-gray-200 p-4 transition hover:border-[#1F9345] hover:bg-[#f8fbf6]">
                                        <input id="paymentBank"
                                               type="radio"
                                               name="PaymentMethod"
                                               value="BankTransfer"
                                               class="mt-1 h-4 w-4 shrink-0 accent-[#1F9345]" />
                                        <span class="min-w-0 flex-1">
                                            <span class="flex items-center gap-2 text-sm font-semibold text-gray-900">
                                                <i class="ph ph-bank text-lg text-[#1F9345]"></i>
                                                Chuyển khoản ngân hàng
                                            </span>
                                            <span class="mt-1 block text-xs leading-5 text-gray-500">
                                                Thông tin chuyển khoản sẽ được cung cấp sau khi xác nhận đơn hàng.
                                            </span>
                                        </span>
                                    </label>

                                </div>
                            </div>

                            @* Privacy notice *@
                            <div class="mt-6 rounded-xl bg-gray-50 p-4">
                                <div class="flex items-start gap-2">
                                    <i class="ph ph-shield-check mt-0.5 text-lg text-[#1F9345]"></i>
                                    <p class="text-xs leading-5 text-gray-500">
                                        Thông tin cá nhân của bạn được sử dụng để xử lý đơn hàng và hỗ trợ trải nghiệm mua sắm.
                                        Xem thêm tại
                                        <a href="/privacy-policy"
                                           class="font-semibold text-[#1F9345] underline-offset-2 hover:underline">
                                            Chính sách bảo mật
                                        </a>
                                        của Caterin.
                                    </p>
                                </div>
                            </div>

                            @* Place order *@
                            <button type="submit"
                                    class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 py-4 text-sm font-bold text-white shadow-sm transition hover:bg-[#18803b] focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20">
                                <i class="ph ph-lock-key text-lg"></i>
                                ĐẶT HÀNG
                                <i class="ph ph-arrow-right text-lg"></i>
                            </button>

                            <p class="mt-3 text-center text-xs text-gray-400">
                                Cảm ơn bạn đã tin tưởng và lựa chọn Caterin.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</section>
