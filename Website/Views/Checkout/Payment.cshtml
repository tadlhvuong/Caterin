@{
    ViewData["Title"] = "Thanh toán đơn hàng | Caterin";
}

<section class="bg-[#f1f8ee] py-5">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-xl font-bold text-gray-900">
                    Thanh toán đơn hàng
                </h1>
                <p class="mt-1 text-sm text-gray-600">
                    Vui lòng kiểm tra lại thông tin đơn hàng trước khi hoàn tất thanh toán.
                </p>
            </div>

            <div class="rounded-xl border border-[#dcebd7] bg-white px-5 py-3">
                <span class="block text-xs text-gray-500">Mã đơn hàng</span>
                <span class="mt-1 block font-bold text-[#1F9345]">
                    #OD24070025
                </span>
            </div>
        </div>
    </div>
</section>

<section class="py-10 lg:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 items-start gap-8 xl:grid-cols-12 xl:gap-10">

            @* ========================= LEFT ========================= *@
            <div class="space-y-6 xl:col-span-7 2xl:col-span-8">

                @* Shipping Information *@
                <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-7">

                    <div class="mb-6 flex items-center justify-between gap-4 border-b border-gray-100 pb-5">
                        <div>
                            <div class="flex items-center gap-2">
                                <i class="ph ph-map-pin text-xl text-[#1F9345]"></i>
                                <h2 class="text-lg font-bold text-gray-900">
                                    Thông tin giao hàng
                                </h2>
                            </div>
                            <p class="mt-1 text-sm text-gray-500">
                                Địa chỉ nhận hàng của bạn
                            </p>
                        </div>

                        <a href="/checkout"
                           class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-[#1F9345] transition hover:text-[#18803b]">
                            <i class="ph ph-pencil-simple"></i>
                            Thay đổi
                        </a>
                    </div>

                    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">

                        <div>
                            <span class="mb-1 block text-sm text-gray-500">
                                Người nhận
                            </span>
                            <div class="font-semibold text-gray-900">
                                Nguyễn Văn A
                            </div>
                        </div>

                        <div>
                            <span class="mb-1 block text-sm text-gray-500">
                                Số điện thoại
                            </span>
                            <div class="font-semibold text-gray-900">
                                0988 888 888
                            </div>
                        </div>

                        <div class="sm:col-span-2">
                            <span class="mb-1 block text-sm text-gray-500">
                                Địa chỉ nhận hàng
                            </span>
                            <div class="flex items-start gap-2 font-semibold leading-6 text-gray-900">
                                <i class="ph ph-map-pin mt-1 shrink-0 text-[#1F9345]"></i>
                                <span>
                                    123 Nguyễn Huệ, Phường Bến Nghé,
                                    Quận 1, TP. Hồ Chí Minh
                                </span>
                            </div>
                        </div>

                    </div>
                </div>

                @* Payment Method *@
                <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-7">

                    <div class="mb-6">
                        <div class="flex items-center gap-2">
                            <i class="ph ph-credit-card text-xl text-[#1F9345]"></i>
                            <h2 class="text-lg font-bold text-gray-900">
                                Phương thức thanh toán
                            </h2>
                        </div>
                        <p class="mt-2 text-sm text-gray-500">
                            Chọn phương thức thanh toán phù hợp với bạn.
                        </p>
                    </div>

                    <div class="space-y-3">

                        @* COD *@
                        <label for="cod"
                               class="flex cursor-pointer items-center gap-4 rounded-xl border border-[#1F9345] bg-[#f5faf2] p-4 transition hover:bg-[#eff8eb]">

                            <input id="cod"
                                   type="radio"
                                   name="PaymentMethod"
                                   value="COD"
                                   checked
                                   class="h-4 w-4 shrink-0 accent-[#1F9345]" />

                            <span class="flex min-w-0 flex-1 items-center justify-between gap-3">
                                <span class="min-w-0">
                                    <span class="block font-semibold text-gray-900">
                                        Thanh toán khi nhận hàng
                                    </span>
                                    <span class="mt-1 block text-sm leading-5 text-gray-500">
                                        Thanh toán bằng tiền mặt khi nhận được hàng.
                                    </span>
                                </span>

                                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-[#1F9345]">
                                    <i class="ph-fill ph-money text-2xl"></i>
                                </span>
                            </span>
                        </label>

                        @* Bank Transfer *@
                        <label for="bank"
                               class="flex cursor-pointer items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-[#1F9345] hover:bg-[#f8fbf6]">

                            <input id="bank"
                                   type="radio"
                                   name="PaymentMethod"
                                   value="BankTransfer"
                                   class="h-4 w-4 shrink-0 accent-[#1F9345]" />

                            <span class="flex min-w-0 flex-1 items-center justify-between gap-3">
                                <span class="min-w-0">
                                    <span class="block font-semibold text-gray-900">
                                        Chuyển khoản ngân hàng
                                    </span>
                                    <span class="mt-1 block text-sm leading-5 text-gray-500">
                                        Thanh toán qua Internet Banking hoặc Mobile Banking.
                                    </span>
                                </span>

                                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#f1f8ee] text-[#1F9345]">
                                    <i class="ph-fill ph-bank text-2xl"></i>
                                </span>
                            </span>
                        </label>

                        @* VNPay *@
                        <label for="vnpay"
                               class="flex cursor-pointer items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-[#1F9345] hover:bg-[#f8fbf6]">

                            <input id="vnpay"
                                   type="radio"
                                   name="PaymentMethod"
                                   value="VNPay"
                                   class="h-4 w-4 shrink-0 accent-[#1F9345]" />

                            <span class="flex min-w-0 flex-1 items-center justify-between gap-3">
                                <span class="min-w-0">
                                    <span class="block font-semibold text-gray-900">
                                        VNPay
                                    </span>
                                    <span class="mt-1 block text-sm leading-5 text-gray-500">
                                        Thanh toán qua ATM, Visa, MasterCard hoặc mã QR.
                                    </span>
                                </span>

                                <span class="flex h-11 min-w-14 shrink-0 items-center justify-center rounded-lg border border-gray-100 bg-white px-2">
                                    <img src="/images/payment/vnpay.png"
                                         class="max-h-8 max-w-full object-contain"
                                         alt="VNPay" />
                                </span>
                            </span>
                        </label>

                        @* MoMo *@
                        <label for="momo"
                               class="flex cursor-pointer items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 transition hover:border-[#1F9345] hover:bg-[#f8fbf6]">

                            <input id="momo"
                                   type="radio"
                                   name="PaymentMethod"
                                   value="MoMo"
                                   class="h-4 w-4 shrink-0 accent-[#1F9345]" />

                            <span class="flex min-w-0 flex-1 items-center justify-between gap-3">
                                <span class="min-w-0">
                                    <span class="block font-semibold text-gray-900">
                                        Ví MoMo
                                    </span>
                                    <span class="mt-1 block text-sm leading-5 text-gray-500">
                                        Thanh toán nhanh chóng bằng ví điện tử MoMo.
                                    </span>
                                </span>

                                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-gray-100 bg-white p-1">
                                    <img src="/images/payment/momo.png"
                                         class="max-h-full max-w-full object-contain"
                                         alt="MoMo" />
                                </span>
                            </span>
                        </label>

                    </div>
                </div>
            </div>

            @* ========================= RIGHT ========================= *@
            <div class="xl:col-span-5 2xl:col-span-4">
                <div class="xl:sticky xl:top-6">

                    @* Order Header *@
                    <div class="rounded-t-2xl bg-gradient-to-r from-[#1F9345] to-[#249e63] px-6 py-5 text-white">
                        <div class="flex items-center gap-3">
                            <i class="ph ph-shopping-bag-open text-2xl"></i>
                            <h2 class="text-xl font-bold">
                                Đơn hàng của bạn
                            </h2>
                        </div>
                        <p class="mt-1 text-sm text-white/80">
                            Kiểm tra lại sản phẩm và tổng thanh toán.
                        </p>
                    </div>

                    <div class="rounded-b-2xl border border-t-0 border-gray-100 bg-white p-5 shadow-sm sm:p-6">

                        @* Product 1 *@
                        <div class="mb-5 flex items-center gap-3 border-b border-gray-100 pb-5">
                            <div class="h-20 w-20 shrink-0 overflow-hidden rounded-xl bg-[#f5f8f3]">
                                <img src="/images/product/product-img1.png"
                                     class="h-full w-full object-contain"
                                     alt="Nước rửa chén Gạo Caterin" />
                            </div>

                            <div class="min-w-0 flex-1">
                                <h3 class="text-sm font-semibold leading-5 text-gray-900">
                                    Nước rửa chén Gạo Caterin
                                </h3>
                                <p class="mt-2 text-xs text-gray-500">
                                    65.000 ₫ × 2
                                </p>
                            </div>

                            <span class="shrink-0 text-sm font-bold text-gray-900">
                                130.000 ₫
                            </span>
                        </div>

                        @* Product 2 *@
                        <div class="mb-5 flex items-center gap-3 border-b border-gray-100 pb-5">
                            <div class="h-20 w-20 shrink-0 overflow-hidden rounded-xl bg-[#f5f8f3]">
                                <img src="/images/product/product-img2.png"
                                     class="h-full w-full object-contain"
                                     alt="Nước rửa tay Gạo Caterin" />
                            </div>

                            <div class="min-w-0 flex-1">
                                <h3 class="text-sm font-semibold leading-5 text-gray-900">
                                    Nước rửa tay Gạo Caterin
                                </h3>
                                <p class="mt-2 text-xs text-gray-500">
                                    89.000 ₫ × 1
                                </p>
                            </div>

                            <span class="shrink-0 text-sm font-bold text-gray-900">
                                89.000 ₫
                            </span>
                        </div>

                        @* Edit cart *@
                        <a href="/cart"
                           class="inline-flex items-center gap-2 text-sm font-semibold text-[#1F9345] transition hover:text-[#18803b]">
                            <i class="ph ph-pencil-simple"></i>
                            Chỉnh sửa giỏ hàng
                        </a>

                        @* Summary *@
                        <div class="mt-6 space-y-4 border-t border-gray-100 pt-6">

                            <div class="flex items-center justify-between gap-4">
                                <span class="text-sm text-gray-600">Tạm tính</span>
                                <span class="text-sm font-semibold text-gray-900">
                                    219.000 ₫
                                </span>
                            </div>

                            <div class="flex items-center justify-between gap-4">
                                <span class="text-sm text-gray-600">Phí vận chuyển</span>
                                <span class="text-sm font-semibold text-[#1F9345]">
                                    Miễn phí
                                </span>
                            </div>

                            <div class="flex items-center justify-between gap-4">
                                <span class="text-sm text-gray-600">Voucher</span>
                                <span class="text-sm font-semibold text-red-500">
                                    -20.000 ₫
                                </span>
                            </div>

                            <div class="flex items-center justify-between gap-4">
                                <span class="text-sm text-gray-600">Thuế VAT</span>
                                <span class="text-sm font-semibold text-gray-900">
                                    0 ₫
                                </span>
                            </div>

                        </div>

                        @* Total *@
                        <div class="mt-6 border-t border-dashed border-gray-200 pt-6">
                            <div class="flex items-center justify-between gap-4">
                                <span class="text-base font-bold text-gray-900">
                                    Tổng thanh toán
                                </span>
                                <span class="text-2xl font-bold text-[#1F9345]">
                                    199.000 ₫
                                </span>
                            </div>
                        </div>

                        @* Security *@
                        <div class="mt-6 rounded-xl bg-[#f5faf2] p-4">
                            <div class="flex items-start gap-3">
                                <i class="ph-fill ph-shield-check mt-0.5 text-xl text-[#1F9345]"></i>
                                <div>
                                    <h3 class="text-sm font-bold text-gray-900">
                                        Thanh toán an toàn
                                    </h3>
                                    <p class="mt-1 text-xs leading-5 text-gray-600">
                                        Caterin luôn chú trọng bảo vệ thông tin khách hàng
                                        trong quá trình đặt hàng và thanh toán.
                                    </p>
                                </div>
                            </div>
                        </div>

                        @* Terms *@
                        <div class="mt-6">
                            <label for="agree"
                                   class="flex cursor-pointer items-start gap-3">
                                <input id="agree"
                                       name="AgreeTerms"
                                       type="checkbox"
                                       required
                                       class="mt-0.5 h-4 w-4 shrink-0 accent-[#1F9345]" />

                                <span class="text-sm leading-6 text-gray-600">
                                    Tôi đã đọc và đồng ý với
                                    <a href="/terms"
                                       class="font-semibold text-[#1F9345] underline-offset-2 hover:underline">
                                        Điều khoản mua hàng
                                    </a>
                                    của Caterin.
                                </span>
                            </label>
                        </div>

                        @* Submit *@
                        <button type="submit"
                                class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 py-4 text-sm font-bold text-white shadow-sm transition hover:bg-[#18803b] focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20">
                            <i class="ph-fill ph-lock-key-open text-lg"></i>
                            THANH TOÁN NGAY
                            <i class="ph ph-arrow-right text-lg"></i>
                        </button>

                        <div class="mt-5 text-center">
                            <a href="/checkout"
                               class="inline-flex items-center gap-2 text-sm font-semibold text-gray-500 transition hover:text-[#1F9345]">
                                <i class="ph ph-arrow-left"></i>
                                Quay lại thông tin giao hàng
                            </a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
