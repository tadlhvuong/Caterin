@{
    ViewData["Title"] = "Theo dõi đơn hàng | Caterin";
}

@{
    // Dữ liệu mẫu giao diện - thay bằng Model khi tích hợp backend
    var hasOrder = true;
}

<div class="min-h-screen bg-[#f8faf8] text-slate-700">

    @* BREADCRUMB *@
    <section class="border-b border-gray-100 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <nav class="flex flex-wrap items-center gap-2 text-sm">
                <a href="/" class="text-gray-500 transition hover:text-[#1F9345]">Trang chủ</a>
                <i class="ph ph-caret-right text-xs text-gray-400"></i>
                <span class="font-medium text-[#1F9345]">Theo dõi đơn hàng</span>
            </nav>
        </div>
    </section>

    @* PAGE HEADER *@
    <section class="relative overflow-hidden bg-gradient-to-br from-[#f0f9ed] via-white to-[#e8f6ed]">
        <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-[#8CC63F]/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-[#1F9345]/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-4 py-12 text-center sm:px-6 sm:py-16 lg:px-8">
            <span class="inline-flex items-center gap-2 rounded-full border border-[#8CC63F]/30 bg-white/80 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#1F9345]">
                <i class="ph-fill ph-package text-base"></i>
                Caterin Order Tracking
            </span>

            <h1 class="mt-5 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
                Theo dõi đơn hàng
            </h1>

            <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-gray-600 sm:text-base">
                Kiểm tra trạng thái đơn hàng và cập nhật hành trình giao sản phẩm
                đến tận tay bạn.
            </p>
        </div>
    </section>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">

        @* SEARCH ORDER *@
        <section class="mx-auto -mt-2 max-w-3xl">
            <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-[0_12px_40px_rgba(31,147,69,0.07)] sm:p-8">
                <div class="mb-6 text-center">
                    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-[#eaf7e9] text-[#1F9345]">
                        <i class="ph ph-magnifying-glass text-2xl"></i>
                    </div>
                    <h2 class="mt-4 text-xl font-bold text-gray-900">Tra cứu đơn hàng</h2>
                    <p class="mt-2 text-sm text-gray-500">
                        Nhập thông tin bên dưới để kiểm tra đơn hàng của bạn.
                    </p>
                </div>

                <form asp-controller="Order" asp-action="Track" method="get" class="space-y-4">
                    <div>
                        <label for="orderCode" class="mb-2 block text-sm font-semibold text-gray-700">
                            Mã đơn hàng
                        </label>
                        <div class="relative">
                            <i class="ph ph-receipt absolute left-4 top-1/2 -translate-y-1/2 text-lg text-gray-400"></i>
                            <input id="orderCode"
                                   name="orderCode"
                                   type="text"
                                   placeholder="Ví dụ: CTN202611110001"
                                   autocomplete="off"
                                   class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50 pl-11 pr-4 text-sm text-gray-800 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />
                        </div>
                    </div>

                    <div>
                        <label for="contact" class="mb-2 block text-sm font-semibold text-gray-700">
                            Số điện thoại hoặc email đặt hàng
                        </label>
                        <div class="relative">
                            <i class="ph ph-user-circle absolute left-4 top-1/2 -translate-y-1/2 text-lg text-gray-400"></i>
                            <input id="contact"
                                   name="contact"
                                   type="text"
                                   placeholder="Nhập số điện thoại hoặc email"
                                   autocomplete="off"
                                   class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50 pl-11 pr-4 text-sm text-gray-800 outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />
                        </div>
                    </div>

                    <button type="submit"
                            class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 text-sm font-semibold text-white shadow-lg shadow-[#1F9345]/20 transition hover:bg-[#187b39] focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20">
                        <i class="ph ph-magnifying-glass text-lg"></i>
                        Tra cứu đơn hàng
                    </button>
                </form>

                <div class="mt-5 flex items-start gap-2 rounded-xl bg-[#f2f9ef] p-3 text-xs leading-5 text-gray-600">
                    <i class="ph-fill ph-shield-check mt-0.5 text-base text-[#1F9345]"></i>
                    <p>Thông tin đơn hàng chỉ được hiển thị khi mã đơn và thông tin liên hệ khớp với đơn hàng đã đặt.</p>
                </div>
            </div>
        </section>

        @if (hasOrder)
        {
            @* ORDER RESULT *@
            <section class="mt-10 space-y-6">

                @* ORDER STATUS HEADER *@
                <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
                    <div class="flex flex-col gap-4 border-b border-gray-100 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
                        <div>
                            <div class="flex flex-wrap items-center gap-3">
                                <h2 class="text-lg font-bold text-gray-900">Đơn hàng #CTN202611110001</h2>
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">
                                    <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                                    Đang giao hàng
                                </span>
                            </div>
                            <p class="mt-2 text-sm text-gray-500">
                                Đặt hàng ngày 11/11/2026 lúc 09:30
                            </p>
                        </div>

                        <div class="flex flex-wrap gap-2">
                            <a href="/contact"
                               class="inline-flex h-10 items-center justify-center gap-2 rounded-lg border border-gray-200 px-4 text-sm font-semibold text-gray-600 transition hover:border-[#1F9345] hover:text-[#1F9345]">
                                <i class="ph ph-headset text-base"></i>
                                Hỗ trợ
                            </a>
                            <button type="button"
                                    onclick="window.print()"
                                    class="inline-flex h-10 items-center justify-center gap-2 rounded-lg bg-[#f0f8ed] px-4 text-sm font-semibold text-[#1F9345] transition hover:bg-[#e3f2df]">
                                <i class="ph ph-printer text-base"></i>
                                In đơn hàng
                            </button>
                        </div>
                    </div>

                    @* TRACKING TIMELINE *@
                    <div class="p-5 sm:p-8">
                        <div class="mb-8">
                            <h3 class="font-bold text-gray-900">Hành trình đơn hàng</h3>
                            <p class="mt-1 text-sm text-gray-500">Theo dõi các mốc xử lý đơn hàng của bạn.</p>
                        </div>

                        <div class="grid grid-cols-2 gap-y-8 sm:grid-cols-4">
                            <div class="relative">
                                <div class="absolute left-10 right-0 top-5 hidden h-0.5 bg-[#1F9345] sm:block"></div>
                                <div class="relative z-10 flex flex-col items-center text-center sm:items-start sm:text-left">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1F9345] text-white ring-4 ring-[#eaf7e9]">
                                        <i class="ph ph-check text-xl"></i>
                                    </div>
                                    <p class="mt-3 text-sm font-bold text-gray-900">Đặt hàng thành công</p>
                                    <p class="mt-1 text-xs text-gray-500">11/11/2026 - 09:30</p>
                                </div>
                            </div>

                            <div class="relative">
                                <div class="absolute left-10 right-0 top-5 hidden h-0.5 bg-[#1F9345] sm:block"></div>
                                <div class="relative z-10 flex flex-col items-center text-center sm:items-start sm:text-left">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1F9345] text-white ring-4 ring-[#eaf7e9]">
                                        <i class="ph ph-package text-xl"></i>
                                    </div>
                                    <p class="mt-3 text-sm font-bold text-gray-900">Đã đóng gói</p>
                                    <p class="mt-1 text-xs text-gray-500">11/11/2026 - 11:15</p>
                                </div>
                            </div>

                            <div class="relative">
                                <div class="absolute left-10 right-0 top-5 hidden h-0.5 bg-gray-200 sm:block"></div>
                                <div class="relative z-10 flex flex-col items-center text-center sm:items-start sm:text-left">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1F9345] text-white ring-4 ring-[#eaf7e9]">
                                        <i class="ph ph-truck text-xl"></i>
                                    </div>
                                    <p class="mt-3 text-sm font-bold text-[#1F9345]">Đang giao hàng</p>
                                    <p class="mt-1 text-xs text-gray-500">11/11/2026 - 14:20</p>
                                </div>
                            </div>

                            <div class="relative">
                                <div class="relative z-10 flex flex-col items-center text-center sm:items-start sm:text-left">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-full border-2 border-gray-200 bg-white text-gray-400">
                                        <i class="ph ph-house-line text-xl"></i>
                                    </div>
                                    <p class="mt-3 text-sm font-semibold text-gray-400">Giao hàng thành công</p>
                                    <p class="mt-1 text-xs text-gray-400">Đang chờ cập nhật</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 flex flex-col gap-3 rounded-xl bg-[#f2f9ef] p-4 sm:flex-row sm:items-center sm:justify-between">
                            <div class="flex items-start gap-3">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-[#1F9345]">
                                    <i class="ph ph-calendar-check text-xl"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-semibold text-gray-900">Dự kiến giao hàng</p>
                                    <p class="mt-1 text-xs text-gray-600">Thời gian dự kiến theo cập nhật vận chuyển</p>
                                </div>
                            </div>
                            <p class="text-base font-bold text-[#1F9345] sm:text-right">12/11/2026</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

                    @* SHIPPING DETAILS *@
                    <div class="space-y-6 lg:col-span-2">

                        <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
                            <div class="mb-5 flex items-center gap-3">
                                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#eaf7e9] text-[#1F9345]">
                                    <i class="ph ph-map-pin-line text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900">Thông tin giao hàng</h3>
                                    <p class="text-xs text-gray-500">Địa chỉ nhận hàng của bạn</p>
                                </div>
                            </div>

                            <div class="space-y-3 text-sm">
                                <div class="flex flex-wrap justify-between gap-2">
                                    <span class="text-gray-500">Người nhận</span>
                                    <span class="font-semibold text-gray-900">Nguyễn Văn An</span>
                                </div>
                                <div class="flex flex-wrap justify-between gap-2">
                                    <span class="text-gray-500">Số điện thoại</span>
                                    <span class="font-semibold text-gray-900">09xx xxx 123</span>
                                </div>
                                <div class="flex flex-wrap justify-between gap-2">
                                    <span class="text-gray-500">Địa chỉ</span>
                                    <span class="max-w-md text-right font-medium text-gray-800">
                                        123 Đường Nguyễn Trãi, Phường 7, Quận 5, TP. Hồ Chí Minh
                                    </span>
                                </div>
                                <div class="flex flex-wrap justify-between gap-2">
                                    <span class="text-gray-500">Ghi chú</span>
                                    <span class="font-medium text-gray-800">Gọi trước khi giao hàng</span>
                                </div>
                            </div>
                        </div>

                        @* CARRIER *@
                        <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
                            <div class="mb-5 flex items-center gap-3">
                                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#eaf7e9] text-[#1F9345]">
                                    <i class="ph ph-truck text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900">Thông tin vận chuyển</h3>
                                    <p class="text-xs text-gray-500">Đơn vị phụ trách giao hàng</p>
                                </div>
                            </div>

                            <div class="flex flex-col gap-4 rounded-xl border border-gray-100 bg-gray-50 p-4 sm:flex-row sm:items-center sm:justify-between">
                                <div>
                                    <p class="text-sm font-semibold text-gray-900">Đơn vị vận chuyển</p>
                                    <p class="mt-1 text-sm text-gray-500">Đang cập nhật</p>
                                </div>
                                <div class="sm:text-right">
                                    <p class="text-xs text-gray-500">Mã vận đơn</p>
                                    <p class="mt-1 font-semibold text-gray-900">Đang cập nhật</p>
                                </div>
                            </div>
                            <p class="mt-3 flex items-start gap-2 text-xs leading-5 text-gray-500">
                                <i class="ph ph-info mt-0.5 text-base text-[#1F9345]"></i>
                                Thông tin vận chuyển sẽ được cập nhật khi đơn hàng được bàn giao cho đơn vị giao hàng.
                            </p>
                        </div>

                        @* PRODUCTS *@
                        <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
                            <div class="mb-5 flex items-center justify-between gap-3">
                                <div>
                                    <h3 class="font-bold text-gray-900">Sản phẩm trong đơn hàng</h3>
                                    <p class="mt-1 text-xs text-gray-500">2 sản phẩm</p>
                                </div>
                                <a href="/shop" class="text-xs font-semibold text-[#1F9345] hover:underline">Tiếp tục mua sắm</a>
                            </div>

                            <div class="divide-y divide-gray-100">
                                <div class="flex gap-4 py-4 first:pt-0">
                                    <div class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-gray-50">
                                        <img src="~/images/product/product-img1.png" alt="Nước rửa tay Caterin hương sen" class="h-full w-full object-contain" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h4 class="text-sm font-semibold text-gray-900">Nước rửa tay Caterin hương sen</h4>
                                        <p class="mt-1 text-xs text-gray-500">Dung tích: 500ml</p>
                                        <p class="mt-2 text-xs text-gray-500">Số lượng: 1</p>
                                    </div>
                                    <p class="shrink-0 text-sm font-bold text-gray-900">89.000đ</p>
                                </div>

                                <div class="flex gap-4 py-4 last:pb-0">
                                    <div class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-gray-50">
                                        <img src="~/images/product/product-img2.png" alt="Nước rửa chén Caterin cam quế" class="h-full w-full object-contain" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <h4 class="text-sm font-semibold text-gray-900">Nước rửa chén Caterin cam quế</h4>
                                        <p class="mt-1 text-xs text-gray-500">Dung tích: 750ml</p>
                                        <p class="mt-2 text-xs text-gray-500">Số lượng: 1</p>
                                    </div>
                                    <p class="shrink-0 text-sm font-bold text-gray-900">99.000đ</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ORDER SUMMARY *@
                    <aside class="space-y-6">
                        <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
                            <h3 class="font-bold text-gray-900">Tóm tắt đơn hàng</h3>

                            <div class="mt-5 space-y-3 text-sm">
                                <div class="flex justify-between gap-3">
                                    <span class="text-gray-500">Tạm tính</span>
                                    <span class="font-medium text-gray-800">188.000đ</span>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <span class="text-gray-500">Phí vận chuyển</span>
                                    <span class="font-medium text-gray-800">20.000đ</span>
                                </div>
                                <div class="flex justify-between gap-3">
                                    <span class="text-gray-500">Giảm giá</span>
                                    <span class="font-medium text-[#1F9345]">-10.000đ</span>
                                </div>
                                <div class="border-t border-dashed border-gray-200 pt-4">
                                    <div class="flex items-center justify-between gap-3">
                                        <span class="font-semibold text-gray-900">Tổng thanh toán</span>
                                        <span class="text-xl font-bold text-[#1F9345]">198.000đ</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-5 rounded-xl bg-gray-50 p-4">
                                <div class="flex items-center gap-2 text-sm font-semibold text-gray-800">
                                    <i class="ph ph-wallet text-lg text-[#1F9345]"></i>
                                    Phương thức thanh toán
                                </div>
                                <p class="mt-2 text-sm text-gray-600">Thanh toán khi nhận hàng (COD)</p>
                                <span class="mt-2 inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700">
                                    Chưa thanh toán
                                </span>
                            </div>
                        </div>

                        <div class="rounded-2xl border border-[#dcefd8] bg-gradient-to-br from-[#f2faef] to-white p-5">
                            <div class="flex items-center gap-3">
                                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-[#1F9345] shadow-sm">
                                    <i class="ph-fill ph-heart text-xl"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-gray-900">Caterin cảm ơn bạn!</h3>
                                    <p class="mt-1 text-xs text-gray-500">An toàn cho mọi nhà</p>
                                </div>
                            </div>
                            <p class="mt-4 text-sm leading-6 text-gray-600">
                                Chúng tôi đang chuẩn bị đơn hàng cẩn thận để sản phẩm sớm đến với gia đình bạn.
                            </p>
                            <a href="/contact"
                               class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-xl border border-[#1F9345]/20 bg-white px-4 py-3 text-sm font-semibold text-[#1F9345] transition hover:bg-[#1F9345] hover:text-white">
                                <i class="ph ph-headset text-lg"></i>
                                Liên hệ Caterin
                            </a>
                        </div>
                    </aside>
                </div>
            </section>
        }
        else
        {
            @* EMPTY / NOT FOUND STATE *@
            <section class="mx-auto mt-10 max-w-2xl rounded-2xl border border-gray-100 bg-white px-6 py-12 text-center shadow-sm">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#f0f8ed] text-[#1F9345]">
                    <i class="ph ph-package text-4xl"></i>
                </div>
                <h2 class="mt-5 text-xl font-bold text-gray-900">Không tìm thấy đơn hàng</h2>
                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500">
                    Vui lòng kiểm tra lại mã đơn hàng và thông tin liên hệ. Nếu cần hỗ trợ, hãy liên hệ với Caterin.
                </p>
                <a href="/contact" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-[#1F9345] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#187b39]">
                    <i class="ph ph-headset"></i>
                    Liên hệ hỗ trợ
                </a>
            </section>
        }

        @* HELP *@
        <section class="mt-10 rounded-2xl border border-gray-100 bg-white p-6 sm:p-8">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-start gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#eaf7e9] text-[#1F9345]">
                        <i class="ph ph-question text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-900">Bạn cần hỗ trợ về đơn hàng?</h3>
                        <p class="mt-1 text-sm leading-6 text-gray-500">
                            Đội ngũ Caterin sẵn sàng hỗ trợ bạn khi cần kiểm tra hoặc cập nhật thông tin giao hàng.
                        </p>
                    </div>
                </div>
                <a href="/contact"
                   class="inline-flex h-11 shrink-0 items-center justify-center gap-2 rounded-xl border border-[#1F9345] px-5 text-sm font-semibold text-[#1F9345] transition hover:bg-[#1F9345] hover:text-white">
                    Liên hệ với chúng tôi
                    <i class="ph ph-arrow-up-right"></i>
                </a>
            </div>
        </section>
    </main>
</div>
