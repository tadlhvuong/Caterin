@* ========================= STATISTICS ========================= *@
<section class="relative isolate overflow-hidden bg-gradient-to-br from-[#16783a] via-[#1F9345] to-[#249e63] py-16 lg:py-20">
    <div class="pointer-events-none absolute -right-20 -top-28 h-80 w-80 rounded-full border border-white/10"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-20 h-96 w-96 rounded-full border border-white/10"></div>
    <div class="pointer-events-none absolute left-1/2 top-0 h-full w-px bg-white/10"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
            @foreach (var item in statistics)
            {
                <div class="text-center">
                    <p class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
