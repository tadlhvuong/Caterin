    var statistics = new[]
    {
        new { Number = "10+", Label = "Năm phát triển" },
        new { Number = "500+", Label = "Đại lý & Nhà phân phối" },
        new { Number = "100K+", Label = "Khách hàng tin dùng" },
        new { Number = "98%", Label = "Khách hàng hài lòng" }
