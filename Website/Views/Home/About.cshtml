        }
    };

    var partners = Enumerable.Range(1, 6);

    var products = new[]
    {
        new {
            Image = "/images/about/handwash.png",
            Name = "Nước rửa tay",
            Alt = "Nước rửa tay Caterin"
        },
        new {
            Image = "/images/about/dishwash.png",
            Name = "Nước rửa chén",
            Alt = "Nước rửa chén Caterin"
        },
        new {
            Image = "/images/about/floor.png",
            Name = "Nước lau sàn",
            Alt = "Nước lau sàn Caterin"
        },
        new {
            Image = "/images/about/glass.png",
            Name = "Sản phẩm khác",
            Alt = "Sản phẩm vệ sinh Caterin"
        }
    };

    var processes = new[]
    {
        new {
            Icon = "ph-magnifying-glass",
            Title = "Nghiên cứu",
            Description = "Nghiên cứu nhu cầu người tiêu dùng và lựa chọn công thức phù hợp."
        },
        new {
            Icon = "ph-flask",
            Title = "Phát triển",
            Description = "Hoàn thiện công thức nhằm đảm bảo hiệu quả làm sạch và an toàn."
        },
        new {
            Icon = "ph-check-circle",
            Title = "Kiểm định",
            Description = "Kiểm tra chất lượng và độ ổn định trước khi sản xuất."
        },
        new {
            Icon = "ph-factory",
            Title = "Sản xuất",
            Description = "Được sản xuất theo quy trình kiểm soát chất lượng."
