@{
    ViewData["Title"] = "Liên hệ Caterin";
}

<div class="overflow-hidden bg-white">

    <!-- BREADCRUMB -->
    <section class="border-b border-emerald-100 bg-[#F3FAF1]">
        <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h1 class="text-lg font-bold text-slate-900">Liên hệ</h1>

                <nav aria-label="Breadcrumb">
                    <ol class="flex items-center gap-2 text-sm">
                        <li>
                            <a asp-controller="Home" asp-action="Index"
                               class="flex items-center gap-2 text-slate-500 transition hover:text-[#1F9345]">
                                <i class="ph ph-house"></i>
                                Trang chủ
                            </a>
                        </li>
                        <li class="text-slate-300">
                            <i class="ph ph-caret-right"></i>
                        </li>
                        <li class="font-semibold text-[#1F9345]" aria-current="page">
                            Liên hệ
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </section>

    <!-- CONTACT HERO -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-[#F3FAF1] via-white to-[#EAF7E9]">
        <div class="pointer-events-none absolute -right-32 -top-32 size-[450px] rounded-full bg-[#8CC63F]/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-40 -left-32 size-[400px] rounded-full bg-[#1F9345]/5 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-4 py-14 text-center sm:px-6 sm:py-20 lg:px-8 lg:py-24">
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-100 bg-white px-4 py-2 text-xs font-bold tracking-wider text-[#1F9345] shadow-sm">
                <span class="size-2 rounded-full bg-[#249e63]"></span>
                CATERIN CUSTOMER CARE
            </span>

            <h2 class="mx-auto mt-6 max-w-3xl text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
                Chúng tôi luôn sẵn sàng
                <span class="text-[#1F9345]">lắng nghe bạn</span>
            </h2>

            <p class="mx-auto mt-5 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base sm:leading-8">
                Bạn cần tư vấn về sản phẩm, đơn hàng hay chính sách hợp tác?
                Hãy liên hệ với Caterin. Đội ngũ của chúng tôi luôn sẵn sàng hỗ trợ bạn.
            </p>

            <a href="#contact-form"
               class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-7 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-700/20 transition hover:-translate-y-1 hover:bg-[#16783B] focus:outline-none focus:ring-4 focus:ring-emerald-500/20">
                Gửi tin nhắn cho chúng tôi
                <i class="ph ph-arrow-down text-lg"></i>
            </a>
        </div>
    </section>

    <!-- CONTACT CONTENT -->
    <section class="py-16 sm:py-20 lg:py-24" id="contact-form">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">

                <!-- CONTACT FORM -->
                <div class="lg:col-span-7">
                    <div class="h-full rounded-3xl border border-slate-100 bg-white p-5 shadow-lg shadow-slate-900/[0.03] sm:p-8 lg:p-10">

                        <div class="mb-8">
                            <span class="text-xs font-bold tracking-[0.18em] text-[#1F9345]">
                                SEND US A MESSAGE
                            </span>

                            <h3 class="mt-3 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
                                Gửi yêu cầu tư vấn
                            </h3>

                            <p class="mt-3 text-sm leading-7 text-slate-500">
                                Vui lòng điền thông tin bên dưới. Caterin sẽ tiếp nhận và phản hồi bạn sớm nhất.
                            </p>
                        </div>

                        <form action="#" method="post">
                            @Html.AntiForgeryToken()

                            <div class="grid gap-x-5 gap-y-5 sm:grid-cols-2">

                                <!-- FULL NAME -->
                                <div>
                                    <label for="name" class="mb-2 block text-sm font-semibold text-slate-700">
                                        Họ và tên <span class="text-rose-500">*</span>
                                    </label>

                                    <input id="name"
                                           name="name"
                                           type="text"
                                           autocomplete="name"
                                           placeholder="Nhập họ và tên"
                                           required
                                           class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                                </div>

                                <!-- EMAIL -->
                                <div>
                                    <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">
                                        Email <span class="text-rose-500">*</span>
                                    </label>

                                    <input id="email"
                                           name="email"
                                           type="email"
                                           autocomplete="email"
                                           placeholder="example@email.com"
                                           required
                                           class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                                </div>

                                <!-- PHONE -->
                                <div>
                                    <label for="phone" class="mb-2 block text-sm font-semibold text-slate-700">
                                        Số điện thoại <span class="text-rose-500">*</span>
                                    </label>

                                    <input id="phone"
                                           name="phone"
                                           type="tel"
                                           autocomplete="tel"
                                           placeholder="Nhập số điện thoại"
                                           required
                                           class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                                </div>

                                <!-- SUBJECT -->
                                <div>
                                    <label for="subject" class="mb-2 block text-sm font-semibold text-slate-700">
                                        Chủ đề <span class="text-rose-500">*</span>
                                    </label>

                                    <div class="relative">
                                        <select id="subject"
                                                name="subject"
                                                required
                                                class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-white px-4 pr-10 text-sm text-slate-700 outline-none transition hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10">
                                            <option value="">Chọn chủ đề liên hệ</option>
                                            <option value="Product">Tư vấn sản phẩm</option>
                                            <option value="Order">Đơn hàng và giao hàng</option>
                                            <option value="Cooperation">Hợp tác kinh doanh</option>
                                            <option value="Complaint">Góp ý và khiếu nại</option>
                                            <option value="Other">Vấn đề khác</option>
                                        </select>

                                        <i class="ph ph-caret-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                                    </div>
                                </div>

                                <!-- MESSAGE -->
                                <div class="sm:col-span-2">
                                    <label for="message" class="mb-2 block text-sm font-semibold text-slate-700">
                                        Nội dung <span class="text-rose-500">*</span>
                                    </label>

                                    <textarea id="message"
                                              name="message"
                                              rows="6"
                                              required
                                              placeholder="Hãy chia sẻ nội dung bạn cần Caterin hỗ trợ..."
                                              class="w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm leading-7 text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10"></textarea>
                                </div>

                            </div>

                            <div class="mt-7 border-t border-slate-100 pt-6">
                                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                                    <p class="flex max-w-sm items-start gap-2 text-xs leading-6 text-slate-400">
                                        <i class="ph ph-shield-check mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                        Thông tin của bạn được bảo mật và chỉ sử dụng để phản hồi yêu cầu.
                                    </p>

                                    <button type="submit"
                                            class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-7 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-700/15 transition hover:-translate-y-0.5 hover:bg-[#16783B] hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-emerald-500/20">
                                        Gửi liên hệ
                                        <i class="ph ph-paper-plane-tilt text-lg"></i>
                                    </button>

                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- CONTACT INFORMATION -->
                <div class="space-y-6 lg:col-span-5">

                    <div class="rounded-3xl bg-gradient-to-br from-[#16783B] to-[#249e63] p-6 text-white shadow-xl shadow-emerald-900/10 sm:p-8">

                        <span class="text-xs font-bold tracking-[0.18em] text-white/70">
                            CONTACT INFORMATION
                        </span>

                        <h3 class="mt-3 text-2xl font-extrabold">
                            Kết nối với Caterin
                        </h3>

                        <p class="mt-3 text-sm leading-7 text-white/80">
                            Đừng ngần ngại liên hệ với chúng tôi khi bạn cần hỗ trợ.
                            Caterin luôn trân trọng mọi ý kiến đóng góp từ khách hàng.
                        </p>

                        <div class="mt-8 space-y-6">

                            <!-- PHONE -->
                            <div class="flex items-start gap-4">
                                <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-white/15 text-2xl">
                                    <i class="ph-fill ph-phone-call"></i>
                                </span>
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-white/70">Hotline tư vấn</p>
                                    <a href="tel:+84931424207"
                                       class="mt-1 inline-block text-lg font-bold transition hover:text-emerald-100">
                                        +84 931 424 207
                                    </a>
                                </div>
                            </div>

                            <!-- EMAIL -->
                            <div class="flex items-start gap-4">
                                <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-white/15 text-2xl">
                                    <i class="ph-fill ph-envelope"></i>
                                </span>
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-white/70">Email hỗ trợ</p>
                                    <a href="mailto:support@caterin.vn"
                                       class="mt-1 inline-block break-all text-base font-bold transition hover:text-emerald-100">
                                        support@caterin.vn
                                    </a>
                                </div>
                            </div>

                            <!-- ADDRESS -->
                            <div class="flex items-start gap-4">
                                <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-white/15 text-2xl">
                                    <i class="ph-fill ph-map-pin"></i>
                                </span>
                                <div class="min-w-0">
                                    <p class="text-xs font-medium text-white/70">Địa chỉ</p>
                                    <p class="mt-1 text-sm font-semibold leading-7">
                                        Địa chỉ kinh doanh Caterin
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- SUPPORT CARDS -->
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">

                        <a href="tel:+84931424207"
                           class="group flex items-center justify-between gap-4 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-emerald-200 hover:shadow-lg">
                            <div class="flex items-center gap-4">
                                <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-2xl text-[#1F9345] transition group-hover:bg-[#1F9345] group-hover:text-white">
                                    <i class="ph-fill ph-headset"></i>
                                </span>
                                <div>
                                    <h4 class="font-bold text-slate-900">Tư vấn trực tiếp</h4>
                                    <p class="mt-1 text-xs text-slate-500">Gọi hotline để được hỗ trợ</p>
                                </div>
                            </div>
                            <i class="ph ph-arrow-up-right text-xl text-slate-400 transition group-hover:text-[#1F9345]"></i>
                        </a>

                        <a href="mailto:support@caterin.vn"
                           class="group flex items-center justify-between gap-4 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:border-emerald-200 hover:shadow-lg">
                            <div class="flex items-center gap-4">
                                <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-2xl text-[#1F9345] transition group-hover:bg-[#1F9345] group-hover:text-white">
                                    <i class="ph-fill ph-envelope-simple"></i>
                                </span>
                                <div>
                                    <h4 class="font-bold text-slate-900">Gửi email</h4>
                                    <p class="mt-1 text-xs text-slate-500">Gửi yêu cầu hỗ trợ qua email</p>
                                </div>
                            </div>
                            <i class="ph ph-arrow-up-right text-xl text-slate-400 transition group-hover:text-[#1F9345]"></i>
                        </a>

                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- MAP -->
    <section class="pb-16 sm:pb-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <span class="text-xs font-bold tracking-[0.18em] text-[#1F9345]">OUR LOCATION</span>
                    <h2 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl">
                        Tìm đường đến Caterin
                    </h2>
                </div>
                <p class="text-sm text-slate-500">
                    Chúng tôi luôn sẵn sàng chào đón bạn.
                </p>
            </div>

            <div class="overflow-hidden rounded-3xl border border-slate-100 bg-slate-50 shadow-sm">
                <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
                    <span class="flex size-16 items-center justify-center rounded-2xl bg-emerald-50 text-3xl text-[#1F9345]">
                        <i class="ph-fill ph-map-pin"></i>
                    </span>
                    <h3 class="mt-5 text-lg font-bold text-slate-900">
                        Địa chỉ Caterin
                    </h3>
                    <p class="mt-2 max-w-md text-sm leading-7 text-slate-500">
                        Cập nhật địa chỉ kinh doanh chính thức để khách hàng có thể tìm đường đến với Caterin.
                    </p>
                </div>
            </div>

        </div>
    </section>

    <!-- SERVICE BENEFITS -->
    <section class="border-y border-slate-100 bg-[#F8FBF7] py-12 sm:py-14">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

                <div class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm">
                    <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-2xl text-[#1F9345]">
                        <i class="ph-fill ph-truck"></i>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900">Giao hàng toàn quốc</h4>
                        <p class="mt-1 text-xs text-slate-500">Hỗ trợ giao hàng tận nơi</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm">
                    <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-2xl text-[#1F9345]">
                        <i class="ph-fill ph-hand-heart"></i>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900">Chất lượng tận tâm</h4>
                        <p class="mt-1 text-xs text-slate-500">Đặt trải nghiệm khách hàng lên đầu</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm">
                    <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-2xl text-[#1F9345]">
                        <i class="ph-fill ph-shield-check"></i>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900">Thanh toán an toàn</h4>
                        <p class="mt-1 text-xs text-slate-500">Hỗ trợ phương thức thanh toán</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm">
                    <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-2xl text-[#1F9345]">
                        <i class="ph-fill ph-chats"></i>
                    </span>
                    <div>
                        <h4 class="text-sm font-bold text-slate-900">Hỗ trợ khách hàng</h4>
                        <p class="mt-1 text-xs text-slate-500">Luôn sẵn sàng giải đáp</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

</div>
