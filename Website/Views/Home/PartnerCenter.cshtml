@{
    ViewData["Title"] = "Trở thành Cộng tác viên Caterin";
}

<div class="overflow-hidden bg-white">
    <!-- HERO -->
    <section class="relative isolate overflow-hidden bg-gradient-to-br from-[#F3FAF1] via-white to-[#EAF7E9]">
        <div class="pointer-events-none absolute -right-32 -top-32 size-[500px] rounded-full bg-[#8CC63F]/10 blur-3xl"></div>
        <div class="pointer-events-none absolute -bottom-40 -left-32 size-[400px] rounded-full bg-[#1F9345]/5 blur-3xl"></div>

        <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2 lg:gap-14 lg:px-8 lg:py-24">

            <div class="max-w-2xl">
                <span class="inline-flex items-center gap-2 rounded-full border border-emerald-100 bg-white/80 px-4 py-2 text-xs font-bold tracking-wider text-[#1F9345] shadow-sm">
                    <span class="size-2 rounded-full bg-[#249e63]"></span>
                    CATERIN PARTNER PROGRAM
                </span>

                <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-[54px]">
                    Cùng Caterin
                    <span class="block text-[#1F9345]">kinh doanh xanh</span>
                    <span class="block">phát triển bền vững</span>
                </h1>

                <p class="mt-6 max-w-xl text-base leading-8 text-slate-600 sm:text-lg">
                    Đồng hành cùng Caterin để kinh doanh các sản phẩm chăm sóc gia đình
                    chất lượng. Không cần nhập hàng, chiết khấu hấp dẫn và được hỗ trợ
                    xuyên suốt quá trình bán hàng.
                </p>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a href="#register"
                       class="inline-flex min-h-14 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-emerald-700/20 transition hover:-translate-y-1 hover:bg-[#16783B] hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-emerald-500/20">
                        Đăng ký trở thành đối tác
                        <i class="ph ph-arrow-right text-lg"></i>
                    </a>

                    <a href="#benefits"
                       class="inline-flex min-h-14 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-7 py-3.5 text-sm font-semibold text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-50 hover:text-[#1F9345]">
                        Tìm hiểu quyền lợi
                        <i class="ph ph-arrow-down text-lg"></i>
                    </a>
                </div>

                <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-500">
                    <span class="flex items-center gap-2">
                        <i class="ph-fill ph-check-circle text-lg text-[#1F9345]"></i>
                        Không bắt buộc nhập hàng
                    </span>
                    <span class="flex items-center gap-2">
                        <i class="ph-fill ph-check-circle text-lg text-[#1F9345]"></i>
                        Hỗ trợ bán hàng
                    </span>
                </div>
            </div>

            <div class="relative mx-auto w-full max-w-xl">
                <div class="absolute inset-5 rounded-[2rem] bg-[#8CC63F]/15 blur-2xl"></div>

                <div class="relative overflow-hidden rounded-[2rem] border border-white bg-white/70 p-3 shadow-2xl shadow-emerald-900/10 backdrop-blur">
                    <img src="@Url.Content("~/images/seller/hero.png")"
                         alt="Chương trình đối tác Caterin"
                         class="h-auto w-full rounded-[1.5rem] object-contain" />
                </div>

                <div class="absolute -bottom-5 left-2 rounded-2xl border border-slate-100 bg-white p-4 shadow-xl sm:-left-7 sm:p-5">
                    <div class="flex items-center gap-3">
                        <div class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                            <i class="ph-fill ph-trend-up text-2xl"></i>
                        </div>
                        <div>
                            <p class="text-xs text-slate-500">Chiết khấu lên đến</p>
                            <p class="text-xl font-extrabold text-[#1F9345]">15%</p>
                        </div>
                    </div>
                </div>

                <div class="absolute -right-1 top-8 rounded-xl border border-slate-100 bg-white px-4 py-3 shadow-lg sm:-right-5">
                    <div class="flex items-center gap-2">
                        <i class="ph-fill ph-seal-check text-xl text-[#1F9345]"></i>
                        <span class="text-xs font-bold text-slate-700">Đối tác Caterin</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BENEFITS -->
    <section id="benefits" class="scroll-mt-24 py-16 sm:py-20 lg:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <div class="mx-auto mb-12 max-w-2xl text-center sm:mb-16">
                <span class="text-xs font-bold tracking-[0.18em] text-[#1F9345]">WHY CATERIN PARTNER</span>
                <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
                    Quyền lợi khi tham gia
                </h2>
                <p class="mt-4 text-sm leading-7 text-slate-500 sm:text-base">
                    Cùng phát triển kinh doanh với những chính sách hỗ trợ thiết thực từ Caterin.
                </p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

                <div class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-emerald-100 hover:shadow-xl hover:shadow-emerald-900/5 sm:p-7">
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-emerald-50 text-[#1F9345] transition group-hover:bg-[#1F9345] group-hover:text-white">
                        <i class="ph-fill ph-money text-3xl"></i>
                    </div>
                    <h3 class="mt-6 text-lg font-bold text-slate-900">Chiết khấu hấp dẫn</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-500">
                        Hoa hồng theo doanh số.
                    </p>
                </div>

                <div class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-emerald-100 hover:shadow-xl hover:shadow-emerald-900/5 sm:p-7">
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-sky-50 text-sky-600 transition group-hover:bg-sky-600 group-hover:text-white">
                        <i class="ph-fill ph-megaphone text-3xl"></i>
                    </div>
                    <h3 class="mt-6 text-lg font-bold text-slate-900">Hỗ trợ Marketing</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-500">
                        Banner, video, hình ảnh.
                    </p>
                </div>

                <div class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-emerald-100 hover:shadow-xl hover:shadow-emerald-900/5 sm:p-7">
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-violet-50 text-violet-600 transition group-hover:bg-violet-600 group-hover:text-white">
                        <i class="ph-fill ph-graduation-cap text-3xl"></i>
                    </div>
                    <h3 class="mt-6 text-lg font-bold text-slate-900">Đào tạo</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-500">
                        Hướng dẫn bán hàng.
                    </p>
                </div>

                <div class="group rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-emerald-100 hover:shadow-xl hover:shadow-emerald-900/5 sm:p-7">
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 transition group-hover:bg-amber-500 group-hover:text-white">
                        <i class="ph-fill ph-headset text-3xl"></i>
                    </div>
                    <h3 class="mt-6 text-lg font-bold text-slate-900">Hỗ trợ 24/7</h3>
                    <p class="mt-3 text-sm leading-7 text-slate-500">
                        Đội ngũ luôn đồng hành.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- COMMISSION LEVELS -->
    <section class="relative overflow-hidden bg-[#F5FAF3] py-16 sm:py-20 lg:py-24">
        <div class="pointer-events-none absolute -right-32 top-0 size-96 rounded-full bg-[#8CC63F]/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <div class="mx-auto mb-12 max-w-2xl text-center">
                <span class="text-xs font-bold tracking-[0.18em] text-[#1F9345]">PARTNER LEVEL</span>
                <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
                    Chính sách chiết khấu
                </h2>
                <p class="mt-4 text-sm leading-7 text-slate-500 sm:text-base">
                    Mức chiết khấu theo từng cấp độ hợp tác với Caterin.
                </p>
            </div>

            <div class="grid gap-5 md:grid-cols-3">

                <div class="rounded-2xl border border-white bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg sm:p-8">
                    <div class="flex items-center justify-between">
                        <span class="rounded-full bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-600">LEVEL 01</span>
                        <i class="ph-fill ph-user text-2xl text-slate-400"></i>
                    </div>
                    <p class="mt-7 text-sm font-medium text-slate-500">Cộng tác viên mới</p>
                    <div class="mt-2 flex items-baseline gap-1">
                        <h3 class="text-5xl font-extrabold tracking-tight text-[#1F9345]">5%</h3>
                        <span class="text-sm font-medium text-slate-400">chiết khấu</span>
                    </div>
                    <div class="mt-7 h-1.5 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full w-1/3 rounded-full bg-[#8CC63F]"></div>
                    </div>
                </div>

                <div class="relative rounded-2xl border border-emerald-200 bg-white p-7 shadow-lg shadow-emerald-900/5 transition hover:-translate-y-1 hover:shadow-xl sm:p-8">
                    <span class="absolute -top-3 right-6 rounded-full bg-[#1F9345] px-3 py-1.5 text-[10px] font-bold tracking-wider text-white shadow-md">
                        PHỔ BIẾN
                    </span>
                    <div class="flex items-center justify-between">
                        <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-[#1F9345]">LEVEL 02</span>
                        <i class="ph-fill ph-storefront text-2xl text-[#1F9345]"></i>
                    </div>
                    <p class="mt-7 text-sm font-medium text-slate-500">Đại lý</p>
                    <div class="mt-2 flex items-baseline gap-1">
                        <h3 class="text-5xl font-extrabold tracking-tight text-[#1F9345]">10%</h3>
                        <span class="text-sm font-medium text-slate-400">chiết khấu</span>
                    </div>
                    <div class="mt-7 h-1.5 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full w-2/3 rounded-full bg-[#1F9345]"></div>
                    </div>
                </div>

                <div class="rounded-2xl border border-white bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg sm:p-8">
                    <div class="flex items-center justify-between">
                        <span class="rounded-full bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700">LEVEL 03</span>
                        <i class="ph-fill ph-crown text-2xl text-amber-500"></i>
                    </div>
                    <p class="mt-7 text-sm font-medium text-slate-500">Nhà phân phối</p>
                    <div class="mt-2 flex items-baseline gap-1">
                        <h3 class="text-5xl font-extrabold tracking-tight text-[#1F9345]">15%</h3>
                        <span class="text-sm font-medium text-slate-400">chiết khấu</span>
                    </div>
                    <div class="mt-7 h-1.5 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full w-full rounded-full bg-gradient-to-r from-[#1F9345] to-[#8CC63F]"></div>
                    </div>
                </div>

            </div>

            <p class="mt-7 text-center text-xs leading-6 text-slate-400">
                Chính sách chiết khấu được áp dụng theo chương trình hợp tác tương ứng.
            </p>
        </div>
    </section>

    <!-- HOW TO START -->
    <section class="py-16 sm:py-20 lg:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

            <div class="mx-auto mb-12 max-w-2xl text-center sm:mb-16">
                <span class="text-xs font-bold tracking-[0.18em] text-[#1F9345]">GETTING STARTED</span>
                <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
                    Bắt đầu chỉ với 4 bước
                </h2>
                <p class="mt-4 text-sm leading-7 text-slate-500 sm:text-base">
                    Quy trình đăng ký đơn giản để bạn nhanh chóng đồng hành cùng Caterin.
                </p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">

                <div class="relative rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
                    <span class="text-5xl font-extrabold tracking-tight text-emerald-100">01</span>
                    <div class="mt-5 flex size-12 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                        <i class="ph-fill ph-user-plus text-2xl"></i>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-slate-900">Đăng ký</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Điền thông tin đăng ký tham gia chương trình.</p>
                </div>

                <div class="relative rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
                    <span class="text-5xl font-extrabold tracking-tight text-emerald-100">02</span>
                    <div class="mt-5 flex size-12 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                        <i class="ph-fill ph-clipboard-text text-2xl"></i>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-slate-900">Xác nhận</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Đội ngũ Caterin tiếp nhận và xác nhận hồ sơ.</p>
                </div>

                <div class="relative rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
                    <span class="text-5xl font-extrabold tracking-tight text-emerald-100">03</span>
                    <div class="mt-5 flex size-12 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                        <i class="ph-fill ph-graduation-cap text-2xl"></i>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-slate-900">Đào tạo</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Được hướng dẫn sản phẩm và kỹ năng bán hàng.</p>
                </div>

                <div class="relative rounded-2xl border border-emerald-100 bg-emerald-50/50 p-6 shadow-sm">
                    <span class="text-5xl font-extrabold tracking-tight text-emerald-200">04</span>
                    <div class="mt-5 flex size-12 items-center justify-center rounded-xl bg-[#1F9345] text-white">
                        <i class="ph-fill ph-rocket-launch text-2xl"></i>
                    </div>
                    <h3 class="mt-5 text-lg font-bold text-slate-900">Bắt đầu bán</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Bắt đầu kinh doanh và phát triển cùng Caterin.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- REGISTER FORM -->
    <section id="register" class="scroll-mt-20 bg-gradient-to-br from-[#F3FAF1] via-[#F8FCF6] to-[#EAF7E9] py-16 sm:py-20 lg:py-24">
        <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

            <div class="overflow-hidden rounded-3xl border border-white bg-white shadow-xl shadow-emerald-900/5">

                <div class="relative overflow-hidden bg-gradient-to-r from-[#16783B] to-[#249e63] px-6 py-9 text-white sm:px-10 sm:py-11">
                    <div class="pointer-events-none absolute -right-10 -top-24 size-64 rounded-full border-[35px] border-white/5"></div>
                    <div class="relative">
                        <span class="text-xs font-bold tracking-[0.18em] text-white/70">JOIN CATERIN</span>
                        <h2 class="mt-3 text-2xl font-extrabold sm:text-3xl">Đăng ký Cộng tác viên</h2>
                        <p class="mt-3 max-w-2xl text-sm leading-7 text-white/80 sm:text-base">
                            Điền thông tin bên dưới. Chúng tôi sẽ liên hệ với bạn trong vòng 24 giờ làm việc.
                        </p>
                    </div>
                </div>

                <div class="p-5 sm:p-8 lg:p-10">

                    <div class="mb-7 flex items-center gap-3 border-b border-slate-100 pb-5">
                        <div class="flex size-10 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                            <i class="ph-fill ph-identification-card text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900">Thông tin cá nhân</h3>
                            <p class="mt-1 text-xs text-slate-400">Các thông tin cần thiết để liên hệ với bạn</p>
                        </div>
                    </div>

                    <div class="grid gap-x-5 gap-y-5 md:grid-cols-2">

                        <div>
                            <label for="partnerName" class="mb-2 block text-sm font-semibold text-slate-700">
                                Họ và tên <span class="text-rose-500">*</span>
                            </label>
                            <input id="partnerName" name="fullName" type="text"
                                   placeholder="Nhập họ và tên"
                                   autocomplete="name"
                                   class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                        </div>

                        <div>
                            <label for="partnerPhone" class="mb-2 block text-sm font-semibold text-slate-700">
                                Số điện thoại <span class="text-rose-500">*</span>
                            </label>
                            <input id="partnerPhone" name="phone" type="tel"
                                   placeholder="Nhập số điện thoại"
                                   autocomplete="tel"
                                   class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                        </div>

                        <div>
                            <label for="partnerEmail" class="mb-2 block text-sm font-semibold text-slate-700">Email</label>
                            <input id="partnerEmail" name="email" type="email"
                                   placeholder="example@email.com"
                                   autocomplete="email"
                                   class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                        </div>

                        <div>
                            <label for="partnerProvince" class="mb-2 block text-sm font-semibold text-slate-700">
                                Tỉnh / Thành phố <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <select id="partnerProvince" name="province"
                                        class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-white px-4 pr-10 text-sm text-slate-700 outline-none transition hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10">
                                    <option value="">Chọn tỉnh / thành phố</option>
                                </select>
                                <i class="ph ph-caret-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                            </div>
                        </div>

                        <div>
                            <label for="partnerJob" class="mb-2 block text-sm font-semibold text-slate-700">Nghề nghiệp</label>
                            <input id="partnerJob" name="occupation" type="text"
                                   placeholder="Ví dụ: Nhân viên văn phòng"
                                   class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                        </div>

                        <div>
                            <label for="partnerProgram" class="mb-2 block text-sm font-semibold text-slate-700">
                                Chương trình hợp tác <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <select id="partnerProgram" name="program"
                                        class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-white px-4 pr-10 text-sm text-slate-700 outline-none transition hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10">
                                    <option value="">Chọn chương trình hợp tác</option>
                                    <option value="Collaborator">Cộng tác viên</option>
                                    <option value="Agent">Đại lý</option>
                                    <option value="Distributor">Nhà phân phối</option>
                                </select>
                                <i class="ph ph-caret-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                            </div>
                        </div>

                        <div class="md:col-span-2">
                            <label for="partnerChannel" class="mb-2 block text-sm font-semibold text-slate-700">
                                Kênh bán hàng <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <select id="partnerChannel" name="salesChannel"
                                        class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-white px-4 pr-10 text-sm text-slate-700 outline-none transition hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10">
                                    <option value="">Chọn kênh bán hàng</option>
                                    <option value="Facebook">Facebook</option>
                                    <option value="Shopee">Shopee</option>
                                    <option value="TikTok">TikTok</option>
                                    <option value="Store">Cửa hàng</option>
                                </select>
                                <i class="ph ph-caret-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                            </div>
                        </div>

                        <div class="md:col-span-2">
                            <label for="partnerIntroduction" class="mb-2 block text-sm font-semibold text-slate-700">
                                Giới thiệu bản thân
                            </label>
                            <textarea id="partnerIntroduction" name="introduction" rows="5"
