@{
    ViewData["Title"] = "Chính sách thanh toán";

    ViewData["PageTitle"] = "Chính sách thanh toán";
    ViewData["PageDescription"] =
        "Caterin cung cấp nhiều phương thức thanh toán an toàn, thuận tiện nhằm mang đến trải nghiệm mua sắm nhanh chóng và minh bạch.";

    ViewData["Breadcrumbs"] = new (string Text, string? Url)[]
    {
        ("Chính sách thanh toán", null)
    };
}

<!-- Page Header -->
<partial name="Components/_PageHeader" />

<section id="shipping" class="bg-gray-50 py-10 sm:py-14">
    <div class="container mx-auto px-4">

        <!-- Payment Highlights -->
        <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-money text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Thanh toán COD</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        Thanh toán khi nhận hàng
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-bank text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Chuyển khoản</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        Chuyển khoản ngân hàng
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-credit-card text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Thẻ thanh toán</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        ATM, Visa, MasterCard
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-qr-code text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Thanh toán điện tử</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        Ví điện tử và QR Code
                    </p>
                </div>
            </div>

        </div>

        <!-- Main Layout -->
        <div class="grid items-start gap-6 lg:grid-cols-[260px_minmax(0,1fr)] xl:gap-8">

            <!-- Sidebar -->
            <aside class="lg:sticky lg:top-24">
                <div class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6">

                    <h2 class="mb-5 flex items-center gap-2 font-bold text-gray-900">
                        <i class="ph ph-list-bullets text-xl text-[#1F9345]"></i>
                        Nội dung
                    </h2>

                    <nav class="space-y-1 text-sm">

                        <a href="#methods"
                           class="block rounded-lg bg-[#F5F9F2] px-3 py-2.5 font-medium text-[#1F9345] transition hover:bg-[#EDF7EA]">
                            1. Phương thức thanh toán
                        </a>

                        <a href="#online"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            2. Thanh toán trực tuyến
                        </a>

                        <a href="#cod"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            3. Thanh toán khi nhận hàng
                        </a>

                        <a href="#security"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            4. Bảo mật thanh toán
                        </a>

                        <a href="#refund"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            5. Hoàn tiền
                        </a>

                        <a href="#contact"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            6. Liên hệ
                        </a>

                    </nav>
                </div>
            </aside>

            <!-- Content -->
            <div class="min-w-0">

                <!-- Update Date -->
                <div class="mb-5">
                    <span class="text-sm font-semibold text-[#1F9345]">
                        Cập nhật: 09/07/2026
                    </span>

                    <h2 class="mt-2 text-xl font-bold tracking-tight text-gray-900 sm:text-2xl">
                        Chính sách thanh toán
                    </h2>
                </div>

                <!-- 1. Payment Methods -->
                <article id="methods"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            01
                        </span>
                        Phương thức thanh toán
                    </h3>

                    <p class="mb-4 text-sm leading-7 text-gray-600">
                        Caterin hỗ trợ các hình thức thanh toán linh hoạt để đáp ứng nhu cầu của khách hàng.
                    </p>

                    <div class="grid gap-3 sm:grid-cols-2">

                        <div class="flex items-center gap-3 rounded-xl border border-gray-200 p-4">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph ph-money text-2xl"></i>
                            </span>
                            <span class="text-sm font-medium text-gray-800">
                                Thanh toán khi nhận hàng (COD)
                            </span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl border border-gray-200 p-4">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph ph-bank text-2xl"></i>
                            </span>
                            <span class="text-sm font-medium text-gray-800">
                                Thanh toán bằng chuyển khoản ngân hàng
                            </span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl border border-gray-200 p-4">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph ph-credit-card text-2xl"></i>
                            </span>
                            <span class="text-sm font-medium text-gray-800">
                                Thanh toán trực tuyến qua cổng thanh toán được hỗ trợ
                            </span>
                        </div>

                        <div class="flex items-center gap-3 rounded-xl border border-gray-200 p-4">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph ph-device-mobile text-2xl"></i>
                            </span>
                            <span class="text-sm font-medium text-gray-800">
                                Ví điện tử (nếu được hỗ trợ)
                            </span>
                        </div>

                    </div>

                </article>

                <!-- 2. Online Payment -->
                <article id="online"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            02
                        </span>
                        Thanh toán trực tuyến
                    </h3>

                    <p class="text-sm leading-7 text-gray-600">
                        Khi lựa chọn thanh toán trực tuyến, khách hàng sẽ được chuyển đến cổng thanh toán an toàn của đối tác để hoàn tất giao dịch.
                    </p>

                    <div class="mt-5 rounded-xl border border-[#DCEBDD] bg-[#F5F9F2] p-5">

                        <h4 class="mb-4 flex items-center gap-2 font-semibold text-gray-900">
                            <i class="ph ph-check-circle text-xl text-[#1F9345]"></i>
                            Các hình thức được hỗ trợ
                        </h4>

                        <ul class="space-y-3 text-sm leading-6 text-gray-700">
                            <li class="flex gap-3">
                                <i class="ph ph-check mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Hỗ trợ thẻ ATM nội địa.</span>
                            </li>
                            <li class="flex gap-3">
                                <i class="ph ph-check mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Hỗ trợ thẻ Visa/MasterCard.</span>
                            </li>
                            <li class="flex gap-3">
                                <i class="ph ph-check mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Hỗ trợ QR Code và Internet Banking (nếu có).</span>
                            </li>
                        </ul>

                    </div>

                </article>

                <!-- 3. COD -->
                <article id="cod"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            03
                        </span>
                        Thanh toán khi nhận hàng (COD)
                    </h3>

                    <p class="mb-4 text-sm leading-7 text-gray-600">
                        Đối với hình thức COD, khách hàng thanh toán trực tiếp cho đơn vị vận chuyển sau khi kiểm tra thông tin đơn hàng.
                    </p>

                    <ul class="space-y-3 text-sm leading-6 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Chuẩn bị đúng số tiền cần thanh toán.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Kiểm tra thông tin người nhận và sản phẩm trước khi thanh toán.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-info mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Một số khu vực có thể không hỗ trợ COD.</span>
                        </li>
                    </ul>

                </article>

                <!-- 4. Security -->
                <article id="security"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            04
                        </span>
                        Bảo mật thanh toán
                    </h3>

                    <p class="mb-4 text-sm leading-7 text-gray-600">
                        Caterin không lưu trữ thông tin thẻ thanh toán của khách hàng trên hệ thống.
                    </p>

                    <ul class="space-y-3 text-sm leading-6 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-shield-check mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Thông tin thanh toán được xử lý thông qua cổng thanh toán bảo mật.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-lock-key mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Dữ liệu truyền tải được mã hóa nhằm đảm bảo an toàn.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-user-check mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Khách hàng chịu trách nhiệm bảo mật thông tin tài khoản và mật khẩu thanh toán.</span>
                        </li>
                    </ul>

                </article>

                <!-- 5. Refund -->
                <article id="refund"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            05
                        </span>
                        Chính sách hoàn tiền
                    </h3>

                    <p class="mb-4 text-sm leading-7 text-gray-600">
                        Trong trường hợp đơn hàng đủ điều kiện hoàn tiền theo Chính sách đổi trả & hoàn tiền, Caterin sẽ tiến hành hoàn tiền theo phương thức phù hợp.
                    </p>

                    <div class="rounded-xl border border-[#DCEBDD] bg-[#F5F9F2] p-5">

                        <ul class="space-y-3 text-sm leading-6 text-gray-700">
                            <li class="flex gap-3">
                                <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Hoàn về tài khoản ngân hàng.</span>
                            </li>
                            <li class="flex gap-3">
                                <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Hoàn về phương thức thanh toán ban đầu (nếu được hỗ trợ).</span>
                            </li>
                            <li class="flex gap-3">
                                <i class="ph ph-clock mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Thời gian xử lý từ 3–7 ngày làm việc sau khi yêu cầu được chấp thuận.</span>
                            </li>
                        </ul>

                    </div>

                </article>

                <!-- 6. Contact -->
                <article id="contact"
                         class="scroll-mt-28 rounded-2xl border border-[#DCEBDD] bg-[#F5F9F2] p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-white text-sm font-bold text-[#1F9345]">
                            06
                        </span>
                        Liên hệ
                    </h3>

                    <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-6">

                        <h4 class="mb-5 font-semibold text-gray-900">
                            Bộ phận Chăm sóc khách hàng Caterin
                        </h4>

                        <div class="space-y-4">

                            <div class="flex items-center gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                    <i class="ph ph-phone text-xl"></i>
                                </span>
                                <div>
                                    <p class="text-xs text-gray-500">Hotline</p>
                                    <p class="mt-1 text-sm font-medium text-gray-900">
                                        1900 xxxx
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                    <i class="ph ph-envelope-simple text-xl"></i>
                                </span>
                                <div>
                                    <p class="text-xs text-gray-500">Email</p>
                                    <p class="mt-1 text-sm font-medium text-gray-900">
                                        support@caterin.vn
                                    </p>
                                </div>
                            </div>

                        </div>

                        <p class="mt-5 border-t border-gray-100 pt-4 text-sm leading-7 text-gray-600">
                            Nếu có bất kỳ thắc mắc nào liên quan đến việc thanh toán, vui lòng liên hệ với chúng tôi để được hỗ trợ.
                        </p>

                    </div>

                </article>

                <!-- Footer -->
                <div class="pt-6 text-center">
                    <p class="text-sm font-medium text-[#1F9345]">
                        Caterin – An toàn cho mọi nhà
                    </p>
                </div>

            </div>
        </div>
    </div>
</section>
