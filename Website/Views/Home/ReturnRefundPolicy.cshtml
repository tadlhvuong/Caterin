@{
    ViewData["Title"] = "Chính sách đổi trả & hoàn tiền";

    ViewData["PageTitle"] = "Chính sách đổi trả & hoàn tiền";
    ViewData["PageDescription"] =
        "Caterin luôn mong muốn mang đến trải nghiệm mua sắm tốt nhất. Nếu sản phẩm gặp sự cố thuộc phạm vi hỗ trợ, chúng tôi sẽ hỗ trợ đổi trả hoặc hoàn tiền theo chính sách dưới đây.";

    ViewData["Breadcrumbs"] = new (string Text, string? Url)[]
    {
        ("Chính sách đổi trả & hoàn tiền", null)
    };
}

<!-- Page Header -->
<partial name="_PageHeader" />

<section id="shipping" class="bg-gray-50 py-10 sm:py-14">
    <div class="container mx-auto px-4">

        <!-- Policy Highlights -->
        <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-car-profile text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Hỗ trợ đổi trả</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        Hỗ trợ khi sản phẩm lỗi hoặc giao sai
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-hand-heart text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Hỗ trợ tận tâm</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        Thông báo trong vòng 48 giờ
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-credit-card text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Hoàn tiền</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        Từ 3–7 ngày làm việc sau khi duyệt
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#1F9345] text-white">
                    <i class="ph-fill ph-chats text-2xl"></i>
                </span>
                <div class="min-w-0">
                    <h3 class="font-semibold text-gray-900">Hỗ trợ khách hàng</h3>
                    <p class="mt-1 text-sm leading-5 text-gray-600">
                        Hotline và Email giờ hành chính
                    </p>
                </div>
            </div>

        </div>

        <!-- Main Layout -->
        <div class="grid items-start gap-6 lg:grid-cols-[260px_minmax(0,1fr)] xl:gap-8">

            <!-- Sidebar -->
            <aside class="lg:sticky lg:top-24">
                <div class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6">

                    <h2 class="mb-5 flex items-center gap-2 font-bold text-gray-900">
                        <i class="ph ph-list-bullets text-xl text-[#1F9345]"></i>
                        Nội dung
                    </h2>

                    <nav class="space-y-1 text-sm">

                        <a href="#condition"
                           class="block rounded-lg bg-[#F5F9F2] px-3 py-2.5 font-medium text-[#1F9345] transition hover:bg-[#EDF7EA]">
                            1. Điều kiện đổi trả
                        </a>

                        <a href="#time"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            2. Thời gian áp dụng
                        </a>

                        <a href="#refund"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            3. Chính sách hoàn tiền
                        </a>

                        <a href="#process"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            4. Quy trình xử lý
                        </a>

                        <a href="#reject"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            5. Trường hợp từ chối
                        </a>

                        <a href="#contact"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            6. Liên hệ hỗ trợ
                        </a>

                    </nav>
                </div>
            </aside>

            <!-- Content -->
            <div class="min-w-0">

                <!-- Update Date -->
                <div class="mb-5">
                    <span class="text-sm font-semibold text-[#1F9345]">
                        Cập nhật: 09/07/2026
                    </span>

                    <h2 class="mt-2 text-xl font-bold tracking-tight text-gray-900 sm:text-2xl">
                        Chính sách đổi trả & hoàn tiền
                    </h2>
                </div>

                <!-- 1. Condition -->
                <article id="condition"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            01
                        </span>
                        Điều kiện đổi trả
                    </h3>

                    <p class="mb-4 text-sm leading-7 text-gray-600">
                        Caterin hỗ trợ đổi trả sản phẩm trong các trường hợp sau:
                    </p>

                    <ul class="space-y-3 text-sm leading-6 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Sản phẩm bị lỗi do nhà sản xuất.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Sản phẩm bị hư hỏng trong quá trình vận chuyển.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Giao sai sản phẩm, sai số lượng hoặc sai dung tích.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Sản phẩm còn nguyên bao bì, chưa qua sử dụng (đối với trường hợp đổi hàng).</span>
                        </li>
                    </ul>

                </article>

                <!-- 2. Time -->
                <article id="time"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            02
                        </span>
                        Thời gian áp dụng
                    </h3>

                    <ul class="space-y-3 text-sm leading-7 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-clock mt-1 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Thông báo trong vòng 48 giờ kể từ khi nhận hàng nếu phát hiện lỗi.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-package mt-1 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Gửi sản phẩm về Caterin theo hướng dẫn của bộ phận chăm sóc khách hàng.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-calendar-x mt-1 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Sau thời gian trên, yêu cầu đổi trả có thể không được chấp nhận.</span>
                        </li>
                    </ul>

                </article>

                <!-- 3. Refund -->
                <article id="refund"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            03
                        </span>
                        Chính sách hoàn tiền
                    </h3>

                    <p class="text-sm leading-7 text-gray-600">
                        Sau khi xác nhận yêu cầu đổi trả hợp lệ, Caterin sẽ tiến hành hoàn tiền theo phương thức thanh toán ban đầu hoặc theo thỏa thuận với khách hàng.
                    </p>

                    <div class="mt-5 rounded-xl border border-[#DCEBDD] bg-[#F5F9F2] p-5">

                        <ul class="space-y-3 text-sm leading-6 text-gray-700">
                            <li class="flex gap-3">
                                <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Thanh toán COD: hoàn tiền qua chuyển khoản ngân hàng.</span>
                            </li>
                            <li class="flex gap-3">
                                <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Thanh toán online: hoàn về phương thức thanh toán ban đầu (nếu hỗ trợ) hoặc chuyển khoản.</span>
                            </li>
                            <li class="flex gap-3">
                                <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                                <span>Thời gian xử lý hoàn tiền: từ 3–7 ngày làm việc sau khi yêu cầu được chấp thuận.</span>
                            </li>
                        </ul>

                    </div>

                </article>

                <!-- 4. Process -->
                <article id="process"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            04
                        </span>
                        Quy trình đổi trả
                    </h3>

                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">

                        <div class="flex h-full flex-col items-center rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <span class="text-2xl font-bold text-[#1F9345]">01</span>
                            <h4 class="mt-2 font-semibold text-gray-900">Liên hệ</h4>
                            <p class="mt-2 text-sm leading-6 text-gray-500">
                                Gửi yêu cầu đổi trả.
                            </p>
                        </div>

                        <div class="flex h-full flex-col items-center rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <span class="text-2xl font-bold text-[#1F9345]">02</span>
                            <h4 class="mt-2 font-semibold text-gray-900">Xác nhận</h4>
                            <p class="mt-2 text-sm leading-6 text-gray-500">
                                Caterin kiểm tra thông tin.
                            </p>
                        </div>

                        <div class="flex h-full flex-col items-center rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <span class="text-2xl font-bold text-[#1F9345]">03</span>
                            <h4 class="mt-2 font-semibold text-gray-900">Gửi hàng</h4>
                            <p class="mt-2 text-sm leading-6 text-gray-500">
                                Khách gửi sản phẩm về.
                            </p>
                        </div>

                        <div class="flex h-full flex-col items-center rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <span class="text-2xl font-bold text-[#1F9345]">04</span>
                            <h4 class="mt-2 font-semibold text-gray-900">Hoàn tất</h4>
                            <p class="mt-2 text-sm leading-6 text-gray-500">
                                Đổi hàng hoặc hoàn tiền.
                            </p>
                        </div>

                    </div>

                </article>

                <!-- 5. Rejection -->
                <article id="reject"
                         class="mb-5 scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-sm font-bold text-[#1F9345]">
                            05
                        </span>
                        Trường hợp không áp dụng
                    </h3>

                    <ul class="space-y-3 text-sm leading-6 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-x-circle mt-0.5 shrink-0 text-lg text-red-500"></i>
                            <span>Sản phẩm đã qua sử dụng không đúng hướng dẫn.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-x-circle mt-0.5 shrink-0 text-lg text-red-500"></i>
                            <span>Sản phẩm bị hư hỏng do tác động từ người sử dụng.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-x-circle mt-0.5 shrink-0 text-lg text-red-500"></i>
                            <span>Thiếu phụ kiện hoặc bao bì do khách hàng làm mất.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-x-circle mt-0.5 shrink-0 text-lg text-red-500"></i>
                            <span>Yêu cầu đổi trả vượt quá thời hạn quy định.</span>
                        </li>
                    </ul>

                </article>

                <!-- 6. Contact -->
                <article id="contact"
                         class="scroll-mt-28 rounded-2xl border border-[#DCEBDD] bg-[#F5F9F2] p-5 sm:p-7">

                    <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-gray-900">
                        <span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-white text-sm font-bold text-[#1F9345]">
                            06
                        </span>
                        Liên hệ hỗ trợ
                    </h3>

                    <div class="rounded-xl border border-gray-200 bg-white p-5 sm:p-6">

                        <h4 class="mb-5 font-semibold text-gray-900">
                            Bộ phận Chăm sóc khách hàng Caterin
                        </h4>

                        <div class="space-y-4">

                            <div class="flex items-center gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                    <i class="ph ph-phone text-xl"></i>
                                </span>
                                <div>
                                    <p class="text-xs text-gray-500">Hotline</p>
                                    <p class="mt-1 text-sm font-medium text-gray-900">1900 xxxx</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                    <i class="ph ph-envelope-simple text-xl"></i>
                                </span>
                                <div>
                                    <p class="text-xs text-gray-500">Email</p>
                                    <p class="mt-1 text-sm font-medium text-gray-900">support@caterin.vn</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                    <i class="ph ph-clock text-xl"></i>
                                </span>
                                <div>
                                    <p class="text-xs text-gray-500">Thời gian làm việc</p>
                                    <p class="mt-1 text-sm font-medium text-gray-900">
                                        08:00 – 17:30 (Thứ 2 đến Thứ 7)
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>

                </article>

                <!-- Footer -->
                <div class="pt-6 text-center">
                    <p class="text-sm font-medium text-[#1F9345]">
                        Caterin – An toàn cho mọi nhà
                    </p>
                </div>

            </div>
        </div>
    </div>
</section>
