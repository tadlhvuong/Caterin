@{
    ViewData["Title"] = "Chính sách giao hàng | Caterin";
    ViewData["PageTitle"] = "Chính sách giao hàng";
    ViewData["PageDescription"] =
        "Caterin cam kết giao hàng nhanh chóng, an toàn và đúng thời gian nhằm mang đến trải nghiệm mua sắm tốt nhất cho khách hàng.";

    ViewData["Breadcrumbs"] = new (string Text, string? Url)[]
    {
        ("Chính sách giao hàng", null)
    };
}

<!-- Page Header -->
<partial name="_PageHeader" />

<section class="bg-gray-50 py-10 sm:py-14"
         id="shipping">

    <div class="container mx-auto px-4">

        <!-- Shipping Highlights -->
        <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                    <i class="ph-fill ph-car-profile text-3xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">
                        Giao hàng toàn quốc
                    </h3>
                    <p class="mt-1 text-sm text-gray-500">
                        Phục vụ khách hàng trên toàn quốc
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                    <i class="ph-fill ph-hand-heart text-3xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">
                        Xử lý nhanh chóng
                    </h3>
                    <p class="mt-1 text-sm text-gray-500">
                        Xử lý đơn trong 24 giờ
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                    <i class="ph-fill ph-package text-3xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">
                        Đóng gói an toàn
                    </h3>
                    <p class="mt-1 text-sm text-gray-500">
                        Bảo vệ sản phẩm khi vận chuyển
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition hover:border-[#B9DDBD] hover:shadow-sm">
                <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                    <i class="ph-fill ph-chats text-3xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">
                        Hỗ trợ khách hàng
                    </h3>
                    <p class="mt-1 text-sm text-gray-500">
                        Hỗ trợ theo dõi đơn hàng
                    </p>
                </div>
            </div>

        </div>

        <!-- Main Content -->
        <div class="grid items-start gap-6 lg:grid-cols-[260px_minmax(0,1fr)] xl:gap-8">

            <!-- Table of Contents -->
            <aside class="lg:sticky lg:top-24">
                <div class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6">

                    <div class="mb-5 flex items-center gap-2">
                        <i class="ph ph-list-bullets text-xl text-[#1F9345]"></i>
                        <h2 class="font-bold text-gray-900">
                            Nội dung chính
                        </h2>
                    </div>

                    <nav class="space-y-1 text-sm">

                        <a href="#scope"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            01. Phạm vi giao hàng
                        </a>

                        <a href="#time"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            02. Thời gian giao hàng
                        </a>

                        <a href="#fee"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            03. Phí vận chuyển
                        </a>

                        <a href="#process"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            04. Quy trình giao hàng
                        </a>

                        <a href="#notice"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            05. Lưu ý khi nhận hàng
                        </a>

                        <a href="#contact"
                           class="block rounded-lg px-3 py-2.5 text-gray-600 transition hover:bg-[#F5F9F2] hover:text-[#1F9345]">
                            06. Liên hệ
                        </a>

                    </nav>
                </div>
            </aside>

            <!-- Policy Content -->
            <div class="min-w-0 space-y-5">

                <!-- Update Information -->
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-gray-200 bg-white px-5 py-4">
                    <div class="flex items-center gap-2 text-sm text-gray-500">
                        <i class="ph ph-calendar-blank text-lg"></i>
                        <span>Cập nhật lần cuối:</span>
                        <span class="font-medium text-gray-800">09/07/2026</span>
                    </div>

                    <span class="rounded-full bg-[#EDF7EA] px-3 py-1 text-xs font-semibold text-[#1F9345]">
                        Chính sách giao hàng
                    </span>
                </div>

                <!-- Section 1 -->
                <article id="scope"
                         class="scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <div class="mb-4 flex items-center gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#EDF7EA] font-bold text-[#1F9345]">
                            01
                        </span>
                        <h2 class="text-lg font-bold text-gray-900 sm:text-xl">
                            Phạm vi giao hàng
                        </h2>
                    </div>

                    <p class="text-sm leading-7 text-gray-600">
                        Caterin cung cấp dịch vụ giao hàng trên toàn quốc thông qua
                        các đơn vị vận chuyển uy tín nhằm đảm bảo sản phẩm được giao
                        đến khách hàng nhanh chóng và an toàn.
                    </p>

                    <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Giao hàng tại tất cả tỉnh, thành phố trên toàn quốc.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Hỗ trợ giao đến nhà, văn phòng hoặc địa chỉ theo yêu cầu.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Một số khu vực đặc biệt có thể phát sinh thời gian giao hàng lâu hơn.</span>
                        </li>
                    </ul>

                </article>

                <!-- Section 2 -->
                <article id="time"
                         class="scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <div class="mb-5 flex items-center gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#EDF7EA] font-bold text-[#1F9345]">
                            02
                        </span>
                        <h2 class="text-lg font-bold text-gray-900 sm:text-xl">
                            Thời gian giao hàng
                        </h2>
                    </div>

                    <p class="mb-5 text-sm leading-7 text-gray-600">
                        Thời gian giao hàng dự kiến được tính kể từ khi đơn hàng
                        được xác nhận và bàn giao cho đơn vị vận chuyển.
                    </p>

                    <div class="overflow-x-auto rounded-xl border border-gray-200">
                        <table class="w-full min-w-[420px] text-left text-sm">

                            <thead class="bg-[#F5F9F2] text-gray-800">
                                <tr>
                                    <th class="px-5 py-4 font-semibold">
                                        Khu vực
                                    </th>
                                    <th class="px-5 py-4 font-semibold">
                                        Thời gian dự kiến
                                    </th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-gray-100 text-gray-600">
                                <tr>
                                    <td class="px-5 py-4 font-medium text-gray-800">
                                        Nội thành
                                    </td>
                                    <td class="px-5 py-4">
                                        1 – 2 ngày làm việc
                                    </td>
                                </tr>
                                <tr>
                                    <td class="px-5 py-4 font-medium text-gray-800">
                                        Ngoại thành
                                    </td>
                                    <td class="px-5 py-4">
                                        2 – 4 ngày làm việc
                                    </td>
                                </tr>
                                <tr>
                                    <td class="px-5 py-4 font-medium text-gray-800">
                                        Các tỉnh thành khác
                                    </td>
                                    <td class="px-5 py-4">
                                        3 – 7 ngày làm việc
                                    </td>
                                </tr>
                            </tbody>

                        </table>
                    </div>

                    <p class="mt-4 text-xs leading-6 text-gray-500">
                        Thời gian trên mang tính dự kiến và có thể thay đổi do điều kiện
                        thời tiết, giao thông hoặc các yếu tố khách quan khác.
                    </p>

                </article>

                <!-- Section 3 -->
                <article id="fee"
                         class="scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <div class="mb-4 flex items-center gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#EDF7EA] font-bold text-[#1F9345]">
                            03
                        </span>
                        <h2 class="text-lg font-bold text-gray-900 sm:text-xl">
                            Phí vận chuyển
                        </h2>
                    </div>

                    <p class="text-sm leading-7 text-gray-600">
                        Phí giao hàng sẽ được tính khi khách hàng tiến hành thanh toán
                        dựa trên các yếu tố:
                    </p>

                    <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Khu vực nhận hàng.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Khối lượng và kích thước đơn hàng.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Chương trình miễn phí vận chuyển (nếu có).</span>
                        </li>
                    </ul>

                    <div class="mt-5 flex gap-3 rounded-xl border border-[#DCEBDD] bg-[#F5F9F2] p-4">
                        <i class="ph-fill ph-info mt-0.5 shrink-0 text-xl text-[#1F9345]"></i>
                        <div>
                            <h3 class="text-sm font-semibold text-[#1F9345]">
                                Lưu ý
                            </h3>
                            <p class="mt-1 text-sm leading-6 text-gray-600">
                                Đối với các chương trình khuyến mại miễn phí vận chuyển,
                                mức hỗ trợ sẽ được hiển thị trực tiếp tại bước thanh toán.
                            </p>
                        </div>
                    </div>

                </article>

                <!-- Section 4 -->
                <article id="process"
                         class="scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <div class="mb-5 flex items-center gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#EDF7EA] font-bold text-[#1F9345]">
                            04
                        </span>
                        <h2 class="text-lg font-bold text-gray-900 sm:text-xl">
                            Quy trình giao hàng
                        </h2>
                    </div>

                    <p class="mb-6 text-sm leading-7 text-gray-600">
                        Đơn hàng tại Caterin được xử lý theo các bước cơ bản sau:
                    </p>

                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">

                        <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph-fill ph-shopping-cart text-2xl"></i>
                            </div>
                            <span class="mt-3 block text-2xl font-bold text-[#1F9345]">01</span>
                            <h3 class="mt-1 text-sm font-semibold text-gray-900">
                                Đặt hàng
                            </h3>
                        </div>

                        <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph-fill ph-clipboard-text text-2xl"></i>
                            </div>
                            <span class="mt-3 block text-2xl font-bold text-[#1F9345]">02</span>
                            <h3 class="mt-1 text-sm font-semibold text-gray-900">
                                Xác nhận
                            </h3>
                        </div>

                        <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph-fill ph-truck text-2xl"></i>
                            </div>
                            <span class="mt-3 block text-2xl font-bold text-[#1F9345]">03</span>
                            <h3 class="mt-1 text-sm font-semibold text-gray-900">
                                Vận chuyển
                            </h3>
                        </div>

                        <div class="rounded-xl border border-gray-200 bg-gray-50 p-4 text-center">
                            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-[#EDF7EA] text-[#1F9345]">
                                <i class="ph-fill ph-package text-2xl"></i>
                            </div>
                            <span class="mt-3 block text-2xl font-bold text-[#1F9345]">04</span>
                            <h3 class="mt-1 text-sm font-semibold text-gray-900">
                                Giao thành công
                            </h3>
                        </div>

                    </div>

                </article>

                <!-- Section 5 -->
                <article id="notice"
                         class="scroll-mt-28 rounded-2xl border border-gray-200 bg-white p-5 sm:p-7">

                    <div class="mb-4 flex items-center gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#EDF7EA] font-bold text-[#1F9345]">
                            05
                        </span>
                        <h2 class="text-lg font-bold text-gray-900 sm:text-xl">
                            Lưu ý khi nhận hàng
                        </h2>
                    </div>

                    <p class="text-sm leading-7 text-gray-600">
                        Để đảm bảo quyền lợi khi nhận hàng, Caterin khuyến khích
                        khách hàng thực hiện các bước kiểm tra sau:
                    </p>

                    <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-600">
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Kiểm tra tình trạng bao bì trước khi nhận.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Đối chiếu đúng số lượng và sản phẩm đã đặt.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Nếu phát hiện sản phẩm bị hư hỏng hoặc giao sai, vui lòng liên hệ Caterin trong vòng 48 giờ.</span>
                        </li>
                        <li class="flex gap-3">
                            <i class="ph ph-check-circle mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>
                            <span>Việc ký nhận đồng nghĩa với việc khách hàng đã kiểm tra tình trạng bên ngoài của đơn hàng.</span>
                        </li>
                    </ul>

                </article>

                <!-- Section 6 -->
                <article id="contact"
                         class="scroll-mt-28 rounded-2xl border border-[#DCEBDD] bg-[#F5F9F2] p-5 sm:p-7">

                    <div class="mb-4 flex items-center gap-3">
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white font-bold text-[#1F9345]">
                            06
                        </span>
                        <h2 class="text-lg font-bold text-gray-900 sm:text-xl">
                            Liên hệ
                        </h2>
                    </div>

                    <p class="text-sm leading-7 text-gray-600">
                        Nếu có bất kỳ thắc mắc nào về việc giao hàng, vui lòng liên hệ
                        với chúng tôi để được hỗ trợ nhanh nhất.
                    </p>

                    <div class="mt-5 rounded-xl border border-[#E2EDE0] bg-white p-5 sm:p-6">

                        <h3 class="font-semibold text-gray-900">
                            Bộ phận Chăm sóc khách hàng Caterin
                        </h3>

                        <div class="mt-5 space-y-4">

                            <div class="flex items-center gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                    <i class="ph ph-phone text-xl"></i>
                                </span>
                                <div>
                                    <p class="text-xs text-gray-500">Hotline</p>
                                    <p class="mt-0.5 text-sm font-medium text-gray-900">
                                        1900 xxxx
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#EDF7EA] text-[#1F9345]">
                                    <i class="ph ph-envelope-simple text-xl"></i>
                                </span>
                                <div>
                                    <p class="text-xs text-gray-500">Email</p>
                                    <p class="mt-0.5 text-sm font-medium text-gray-900">
                                        support@caterin.vn
                                    </p>
                                </div>
                            </div>

                        </div>

                    </div>

                </article>

                <!-- Footer -->
                <div class="py-5 text-center">
                    <p class="text-sm font-medium text-[#1F9345]">
                        Caterin – An toàn cho mọi nhà
                    </p>
                    <p class="mt-1 text-xs text-gray-400">
                        Cảm ơn bạn đã tin tưởng và lựa chọn Caterin.
                    </p>
                </div>

            </div>
        </div>
    </div>
</section>
