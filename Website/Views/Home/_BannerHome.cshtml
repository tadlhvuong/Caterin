@using Shared.Enums.Banner
@using Shared.Responses.Banner
@using Shared.Data.Entities.Marketing
@model IReadOnlyList<BannerResponse>
<style>
    .banner-overlay {
        position: absolute;
        left: var(--desktop-x);
        top: var(--desktop-y);
        width: var(--desktop-width);
        transform: translate(-50%, -50%);
    }

        .banner-overlay img {
            display: block;
            width: 100%;
            height: auto;
            object-fit: contain;
        }

    @@media (max-width: 767px) {
        .banner-overlay

    {
        left: var(--mobile-x);
        top: var(--mobile-y);
        width: var(--mobile-width);
    }

    }

    .home-banner-pagination .home-banner-bullet {
        display: block;
        width: 8px;
        height: 8px;
        border: 0;
        border-radius: 9999px;
        background: #D1D5DB;
        cursor: pointer;
        transition: width 300ms ease, background-color 300ms ease;
    }

    .home-banner-pagination .home-banner-bullet-active {
        width: 32px;
        background: #1F9345;
    }
</style>
@{
    var banners = Model?
        .Where(b => b.Medias?.Any(m =>
            m.MediaType == BannerMediaType.Background &&
            (!string.IsNullOrWhiteSpace(m.DesktopUrl) ||
             !string.IsNullOrWhiteSpace(m.MobileUrl))) == true)
        .OrderBy(b => b.SortOrder)
        .ThenBy(b => b.Id)
        .ToList() ?? new List<BannerResponse>();
}

@if (banners.Count > 0)
{
    <section id="homeBanner" class="group relative isolate -mx-4 xl:-mx-5 -my-8 w-auto overflow-hidden bg-white">
        <div class="swiper home-banner-swiper min-h-[610px] sm:min-h-[650px] lg:min-h-[570px]">
            <div class="swiper-wrapper">

                @for (var i = 0; i < banners.Count; i++)
                {
                    var banner = banners[i];

                    var background = banner.Medias!
                    .First(m => m.MediaType == BannerMediaType.Background);

                    var overlays = banner.Medias!
                    .Where(m => m.MediaType == BannerMediaType.Overlay
                    && (!string.IsNullOrWhiteSpace(m.DesktopUrl)
                    || !string.IsNullOrWhiteSpace(m.MobileUrl)))
                    .OrderBy(m => m.SortOrder)
                    .ToList();

                    var backgroundUrl = background.DesktopUrl
                    ?? background.MobileUrl;

                    <div class="swiper-slide relative isolate grid min-h-[610px] grid-cols-1 content-start gap-2 px-6 pb-20 pt-9 sm:min-h-[650px] sm:px-10 sm:pt-12 lg:min-h-[570px] lg:items-center lg:gap-8 lg:px-16 lg:py-14 @(overlays.Count > 0 ? "lg:grid-cols-2" : "lg:grid-cols-1")">

                        @* Background *@
                        <picture class="absolute inset-0 z-0 overflow-hidden">
                            @if (!string.IsNullOrWhiteSpace(background.MobileUrl))
                            {
                                <source media="(max-width: 767px)"
                                        srcset="@background.MobileUrl" />
                            }

                            <img src="@backgroundUrl"
                                 alt=""
                                 aria-hidden="true"
                                 class="h-full w-full object-cover object-center"
                                 loading="@(i == 0 ? "eager" : "lazy")"
                                 fetchpriority="@(i == 0 ? "high" : "auto")" />
                        </picture>

                        <div class="pointer-events-none absolute inset-0 z-0 bg-white/10"></div>

                        @* Content bên trái *@
                        <div class="relative z-10 mx-auto flex min-h-[450px] w-full max-w-xl flex-col lg:mx-0 lg:min-h-[440px]">

                           @*  @if (i == 0)
                            {
                                <h1 class="text-3xl font-bold leading-tight text-gray-900 sm:text-4xl lg:text-5xl">
                                    @banner.Title
                                </h1>
                            }
                            else
                            {
                                <h2 class="text-3xl font-bold leading-tight text-gray-900 sm:text-4xl lg:text-5xl">
                                    @banner.Title
                                </h2>
                            } *@

                            @if (!string.IsNullOrWhiteSpace(banner.LinkValue))
                            {
                                <a href="@banner.LinkValue"
                                   class="mt-auto inline-flex min-h-12 w-fit items-center justify-center gap-3 rounded-full bg-[#1F9345] px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-[#1F9345]/15 transition duration-300 hover:-translate-y-0.5 hover:bg-[#187C3B] hover:shadow-xl">
                                    Khám phá sản phẩm
                                    <i class="ph ph-arrow-right text-lg"></i>
                                </a>
                            }
                        </div>

                        @* Overlay bên phải *@
                        @if (overlays.Count > 0)
                        {
                            <div class="relative z-10 mx-auto flex h-[260px] w-full max-w-[430px] items-center justify-center sm:h-[310px] lg:h-[440px] lg:max-w-none">

                                @foreach (var overlay in overlays)
                                {
                                    <picture class="banner-overlay absolute"
                                             style="
                                                                --desktop-x: @(overlay.DesktopX)%;
                                                                --desktop-y: @(overlay.DesktopY)%;
                                                                --desktop-width: @(overlay.DesktopWidth)%;
                                                                --mobile-x: @(overlay.MobileX)%;
                                                                --mobile-y: @(overlay.MobileY)%;
                                                                --mobile-width: @(overlay.MobileWidth)%;
                                                             ">

                                        @if (!string.IsNullOrWhiteSpace(overlay.MobileUrl))
                                        {
                                            <source media="(max-width: 767px)"
                                                    srcset="@overlay.MobileUrl" />
                                        }

                                        <img src="@(overlay.DesktopUrl ?? overlay.MobileUrl)"
                                             alt="@overlay.AltText"
                                             class="h-auto w-full object-contain"
                                             loading="lazy" />
                                    </picture>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (banners.Count > 1)
        {
            @* Previous / Next *@
            <div class="pointer-events-none absolute inset-y-0 left-3 right-3 z-30 hidden items-center justify-between sm:flex lg:left-5 lg:right-5">

                <button type="button"
                        class="home-banner-prev pointer-events-auto flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white/90 text-gray-700 shadow-sm backdrop-blur transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white lg:h-11 lg:w-11"
                        aria-label="Banner trước">
                    <i class="ph ph-caret-left text-xl"></i>
                </button>

                <button type="button"
                        class="home-banner-next pointer-events-auto flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white/90 text-gray-700 shadow-sm backdrop-blur transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white lg:h-11 lg:w-11"
                        aria-label="Banner tiếp theo">
                    <i class="ph ph-caret-right text-xl"></i>
                </button>
            </div>

            @* Bottom controls *@
            <div class="absolute bottom-5 left-6 right-6 z-30 flex items-center justify-between sm:left-10 sm:right-10 lg:bottom-7 lg:left-16 lg:right-16">

                <div class="home-banner-pagination flex items-center gap-2"></div>

                <a href="#flash-sale"
                   class="hidden items-center gap-2 text-xs font-semibold text-[#1F9345] transition hover:gap-3 sm:inline-flex">
                    Khám phá ưu đãi
                    <i class="ph ph-arrow-down text-base"></i>
                </a>
            </div>
        }
    </section>
}