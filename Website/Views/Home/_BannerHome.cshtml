
<div class="bg-[#F5F9F2]">
    <div class="container mx-auto px-4">

        <section id="homeBanner"
                 class="group relative isolate overflow-hidden rounded-3xl border border-[#E5EDE1] bg-white shadow-sm">

            <!-- Background -->
            <div class="absolute inset-0 -z-10 overflow-hidden">
                <img src="~/images/Banner/banner1/banner-background.webp"
                     alt=""
                     aria-hidden="true"
                     class="h-full w-full object-cover object-center" />

                <!-- Soft overlay for text readability -->
                <div class="absolute inset-0 bg-white/10"></div>
            </div>
            <!-- Slides -->
            <div class="relative min-h-[610px] sm:min-h-[650px] lg:min-h-[570px]">

                <!-- ==================== SLIDE 1 ==================== -->
                <div data-banner-slide
                     aria-hidden="false"
                     class="absolute inset-0 grid grid-cols-1 content-start gap-2 px-6 pb-20 pt-9
                            opacity-100 transition-all duration-700 ease-out
                            sm:px-10 sm:pt-12
                            lg:grid-cols-2 lg:items-center lg:gap-8 lg:px-16 lg:py-14">

                    <!-- Content -->
                    <div class="relative z-10 mx-auto w-full max-w-xl lg:mx-0">

                        <span class="inline-flex items-center gap-2 rounded-full border border-[#1F9345]/15 bg-[#F2F8EF] px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#1F9345]">
                            <i class="ph-fill ph-leaf text-base"></i>
                            Caterin – An toàn cho mọi nhà
                        </span>

                        <h1 class="mt-5 text-[32px] font-extrabold leading-[1.2] tracking-tight text-gray-900
                                   sm:text-4xl lg:mt-7 lg:text-5xl xl:text-6xl">
                            An toàn
                            <span class="block text-[#1F9345]">cho mọi nhà</span>
                        </h1>

                        <p class="mt-4 max-w-md text-sm leading-7 text-gray-600
                                  sm:text-base sm:leading-8">
                            Chăm sóc không gian sống bằng những sản phẩm làm sạch chất lượng,
                            mang đến sự sạch sẽ và an tâm cho cả gia đình.
                        </p>

                        <!-- Benefits -->
                        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2.5 text-xs font-medium text-gray-600 sm:text-sm">
                            <span class="inline-flex items-center gap-2">
                                <i class="ph-fill ph-check-circle text-base text-[#1F9345]"></i>
                                Sạch sẽ mỗi ngày
                            </span>
                            <span class="inline-flex items-center gap-2">
                                <i class="ph-fill ph-check-circle text-base text-[#1F9345]"></i>
                                Dịu nhẹ cho gia đình
                            </span>
                        </div>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-7 inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#1F9345] px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-[#1F9345]/15 transition duration-300 hover:-translate-y-0.5 hover:bg-[#187C3B] hover:shadow-xl">
                            Khám phá sản phẩm
                            <i class="ph ph-arrow-right text-lg"></i>
                        </a>
                    </div>

                    <!-- Product visual -->
                    <div class="relative mx-auto flex h-[260px] w-full max-w-[430px] items-center justify-center
                                sm:h-[310px]
                                lg:h-[440px] lg:max-w-none">

                        <!-- Decorative circle -->
                        <div class="absolute left-1/2 top-1/2 aspect-square w-[230px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#E7F3E3]
                                    sm:w-[280px] lg:w-[370px]"></div>

                        <div class="absolute left-1/2 top-1/2 aspect-square w-[185px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#1F9345]/10
                                    sm:w-[230px] lg:w-[310px]"></div>

                        <!-- Product image -->
                        <img src="~/images/Banner/banner1/sp.png"
                             alt="Sản phẩm Caterin"
                             class="relative z-10 h-full max-h-[250px] w-auto max-w-[88%] object-contain
                                    drop-shadow-[0_20px_25px_rgba(31,80,40,0.16)]
                                    transition-transform duration-700 group-hover:scale-[1.03]
                                    sm:max-h-[300px]
                                    lg:max-h-[400px]"
                             loading="eager" />

                        <!-- Floating label -->
                        <div class="absolute bottom-5 right-1 z-20 hidden items-center gap-3 rounded-2xl border border-white/80 bg-white/90 px-4 py-3 shadow-lg backdrop-blur-sm sm:flex lg:bottom-8 lg:right-0">
                            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#EAF5E8] text-[#1F9345]">
                                <i class="ph-fill ph-house text-xl"></i>
                            </span>
                            <span>
                                <span class="block text-xs font-bold text-gray-900">Chăm sóc tổ ấm</span>
                                <span class="mt-0.5 block text-[11px] text-gray-500">Sạch lành, an tâm</span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ==================== SLIDE 2 ==================== -->
                <div data-banner-slide
                     aria-hidden="true"
                     class="pointer-events-none absolute inset-0 grid grid-cols-1 content-start gap-2 px-6 pb-20 pt-9
                            translate-x-8 opacity-0 transition-all duration-700 ease-out
                            sm:px-10 sm:pt-12
                            lg:grid-cols-2 lg:items-center lg:gap-8 lg:px-16 lg:py-14">

                    <!-- Content -->
                    <div class="relative z-10 mx-auto w-full max-w-xl lg:mx-0">

                        <span class="inline-flex items-center gap-2 rounded-full border border-[#1F9345]/15 bg-[#F2F8EF] px-4 py-2 text-xs font-bold uppercase tracking-wider text-[#1F9345]">
                            <i class="ph-fill ph-sparkle text-base"></i>
                            Chăm sóc không gian sống
                        </span>

                        <h2 class="mt-5 text-[32px] font-extrabold leading-[1.2] tracking-tight text-gray-900
                                   sm:text-4xl lg:mt-7 lg:text-5xl xl:text-6xl">
                            Giải pháp làm sạch
                            <span class="block text-[#1F9345]">cho mọi gia đình</span>
                        </h2>

                        <p class="mt-4 max-w-md text-sm leading-7 text-gray-600
                                  sm:text-base sm:leading-8">
                            Lựa chọn sản phẩm phù hợp cho từng nhu cầu vệ sinh,
                            giúp không gian sống luôn sạch sẽ và dễ chịu.
                        </p>

                        <!-- Benefits -->
                        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2.5 text-xs font-medium text-gray-600 sm:text-sm">
                            <span class="inline-flex items-center gap-2">
                                <i class="ph-fill ph-check-circle text-base text-[#1F9345]"></i>
                                Đa dạng sản phẩm
                            </span>
                            <span class="inline-flex items-center gap-2">
                                <i class="ph-fill ph-check-circle text-base text-[#1F9345]"></i>
                                Phù hợp nhiều nhu cầu
                            </span>
                        </div>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-7 inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#1F9345] px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-[#1F9345]/15 transition duration-300 hover:-translate-y-0.5 hover:bg-[#187C3B] hover:shadow-xl">
                            Xem sản phẩm
                            <i class="ph ph-arrow-right text-lg"></i>
                        </a>
                    </div>

                    <!-- Product visual -->
                    <div class="relative mx-auto flex h-[260px] w-full max-w-[430px] items-center justify-center
                                sm:h-[310px]
                                lg:h-[440px] lg:max-w-none">

                        <div class="absolute left-1/2 top-1/2 aspect-square w-[230px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#E7F3E3]
                                    sm:w-[280px] lg:w-[370px]"></div>

                        <div class="absolute left-1/2 top-1/2 aspect-square w-[185px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-[#1F9345]/10
                                    sm:w-[230px] lg:w-[310px]"></div>

                        <img src="~/images/Banner/banner1/sp.png"
                             alt="Các sản phẩm làm sạch Caterin"
                             class="relative z-10 h-full max-h-[250px] w-auto max-w-[88%] object-contain
                                    drop-shadow-[0_20px_25px_rgba(31,80,40,0.16)]
                                    transition-transform duration-700 group-hover:scale-[1.03]
                                    sm:max-h-[300px]
                                    lg:max-h-[400px]"
                             loading="lazy" />

                        <div class="absolute bottom-5 right-1 z-20 hidden items-center gap-3 rounded-2xl border border-white/80 bg-white/90 px-4 py-3 shadow-lg backdrop-blur-sm sm:flex lg:bottom-8 lg:right-0">
                            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#EAF5E8] text-[#1F9345]">
                                <i class="ph-fill ph-sparkle text-xl"></i>
                            </span>
                            <span>
                                <span class="block text-xs font-bold text-gray-900">Sạch lành mỗi ngày</span>
                                <span class="mt-0.5 block text-[11px] text-gray-500">Cho tổ ấm thêm an tâm</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Previous / Next -->
            <div class="absolute inset-y-0 left-3 right-3 z-20 hidden items-center justify-between sm:flex lg:left-5 lg:right-5">
                <button type="button"
                        data-banner-prev
                        aria-label="Banner trước"
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white/90 text-gray-700 shadow-sm backdrop-blur transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white lg:h-11 lg:w-11">
                    <i class="ph ph-caret-left text-xl"></i>
                </button>

                <button type="button"
                        data-banner-next
                        aria-label="Banner tiếp theo"
                        class="flex h-10 w-10 items-center justify-center rounded-full border border-gray-200 bg-white/90 text-gray-700 shadow-sm backdrop-blur transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white lg:h-11 lg:w-11">
                    <i class="ph ph-caret-right text-xl"></i>
                </button>
            </div>

            <!-- Bottom controls -->
            <div class="absolute bottom-5 left-6 right-6 z-20 flex items-center justify-between sm:left-10 sm:right-10 lg:bottom-7 lg:left-16 lg:right-16">

                <div class="flex items-center gap-2">
                    <button type="button"
                            data-banner-dot="0"
                            aria-label="Chuyển đến banner 1"
                            aria-current="true"
                            class="h-2 rounded-full bg-[#1F9345] transition-all duration-300 w-8">
                    </button>

                    <button type="button"
                            data-banner-dot="1"
                            aria-label="Chuyển đến banner 2"
                            aria-current="false"
                            class="h-2 w-2 rounded-full bg-gray-300 transition-all duration-300 hover:bg-[#1F9345]">
                    </button>
                </div>

                <a href="#flash-sale"
                   class="hidden items-center gap-2 text-xs font-semibold text-[#1F9345] transition hover:gap-3 sm:inline-flex">
                    Khám phá ưu đãi
                    <i class="ph ph-arrow-down text-base"></i>
                </a>
            </div>
        </section>
    </div>
</div>
