
<div class="bg-[#F5F9F2]">
    <div class="container mx-auto px-4">
        <div id="homeBanner"
             class="group relative isolate min-h-[390px] overflow-hidden rounded-2xl sm:min-h-[440px] lg:min-h-[560px]">

            <!-- Background -->
            <img src="~/images/Banner/banner1/banner-pc.png"
                 alt=""
                 aria-hidden="true"
                 class="absolute inset-0 -z-20 h-full w-full object-cover" />

            <!-- Overlay -->
            <div class="absolute inset-0 -z-10
    bg-gradient-to-b from-[#F5F9F2] via-[#F5F9F2]/95 to-[#F5F9F2]/70
    lg:bg-gradient-to-r lg:from-[#F5F9F2]/95
    lg:via-[#F5F9F2]/85 lg:to-[#F5F9F2]/20">
            </div>
            <!-- Slides -->
            <div class="relative min-h-[390px] sm:min-h-[440px] lg:min-h-[560px]">
                <!-- Slide 1 -->
                <div data-banner-slide
                     aria-hidden="false"
                     class="absolute inset-0 grid grid-cols-1 items-center
            px-5 py-8 opacity-100 transition-all duration-700 ease-out
            sm:px-10 lg:grid-cols-2 lg:px-16 lg:py-12">

                    <!-- Mobile content -->
                    <div class="relative z-10 lg:hidden">
                        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#1F9345]">
                            <i class="ph-fill ph-leaf"></i>
                            Caterin
                        </span>

                        <h2 class="mt-3 max-w-[300px] text-3xl font-extrabold leading-tight tracking-tight text-gray-900">
                            An toàn
                            <span class="text-[#1F9345]">cho mọi nhà</span>
                        </h2>

                        <p class="mt-2 text-sm text-gray-600">
                            Chăm sóc không gian sống mỗi ngày.
                        </p>
                    </div>

                    <!-- Desktop content: giữ nguyên -->
                    <div class="relative z-10 hidden max-w-xl lg:block">
                        <span class="inline-flex items-center gap-2 rounded-full border border-[#1F9345]/15 bg-white/80 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#1F9345] shadow-sm">
                            <i class="ph-fill ph-leaf text-base"></i>
                            Caterin – An toàn cho mọi nhà
                        </span>

                        <h1 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
                            An toàn
                            <span class="text-[#1F9345]">cho mọi nhà</span>
                        </h1>

                        <p class="mt-5 max-w-lg text-base leading-8 text-gray-600">
                            Chăm sóc không gian sống bằng những sản phẩm làm sạch chất lượng,
                            mang đến sự sạch sẽ và an tâm cho cả gia đình.
                        </p>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-8 inline-flex min-h-12 items-center gap-3 rounded-full bg-[#1F9345] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#187C3B]">
                            Khám phá sản phẩm
                            <i class="ph ph-arrow-right text-lg"></i>
                        </a>
                    </div>

                    <!-- Product image -->
                    <div class="pointer-events-none absolute inset-x-0 bottom-[68px] top-[155px]
            flex items-center justify-center
            sm:top-[165px] sm:bottom-[72px]
            lg:relative lg:inset-auto lg:justify-end">
                        <img src="~/images/Banner/banner1/sp.png"
                             alt="Sản phẩm Caterin"
                             class="h-full max-h-[170px] w-auto max-w-[85%] object-contain
                drop-shadow-xl
                sm:max-h-[210px]
                lg:max-h-[440px] lg:max-w-full"
                             loading="eager" />
                    </div>

                    <!-- Mobile CTA -->
                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="absolute bottom-12 left-1/2 z-20
              inline-flex -translate-x-1/2 items-center justify-center
              gap-2 whitespace-nowrap rounded-full bg-[#1F9345]
              px-6 py-3 text-sm font-semibold text-white shadow-lg
              shadow-[#1F9345]/20 transition hover:bg-[#187C3B]
              lg:hidden">
                        Khám phá sản phẩm
                        <i class="ph ph-arrow-right text-lg"></i>
                    </a>
                </div>

                <!-- Slide 2 -->
                <div data-banner-slide
                     aria-hidden="true"
                     class="pointer-events-none absolute inset-0 grid grid-cols-1 items-center px-5 py-8 opacity-0 translate-x-8 transition-all duration-700 ease-out sm:px-10 lg:grid-cols-2 lg:px-16 lg:py-12">

                    <!-- Mobile content -->
                    <div class="relative z-10 lg:hidden">
                        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#1F9345]">
                            <i class="ph-fill ph-leaf"></i>
                            Caterin
                        </span>

                        <h2 class="mt-3 max-w-[300px] text-3xl font-extrabold leading-tight tracking-tight text-gray-900">
                            Giải pháp làm sạch
                            <span class="text-[#1F9345]">cho tổ ấm</span>
                        </h2>

                        <p class="mt-2 text-sm text-gray-600">
                            Sạch dịu nhẹ, chăm sóc từng không gian sống.
                        </p>
                    </div>

                    <!-- Desktop content: giữ nguyên -->
                    <div class="relative z-10 hidden max-w-xl lg:block">
                        <span class="inline-flex items-center gap-2 rounded-full border border-[#1F9345]/15 bg-white/80 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#1F9345] shadow-sm">
                            <i class="ph-fill ph-leaf text-base"></i>
                            Chăm sóc không gian sống
                        </span>

                        <h2 class="mt-6 text-4xl font-extrabold leading-tight tracking-tight text-gray-900 sm:text-5xl lg:text-6xl">
                            Giải pháp làm sạch
                            <span class="text-[#1F9345]">cho mọi gia đình</span>
                        </h2>

                        <p class="mt-5 max-w-lg text-base leading-8 text-gray-600">
                            Lựa chọn sản phẩm phù hợp cho từng nhu cầu vệ sinh,
                            giúp không gian sống luôn sạch sẽ và dễ chịu.
                        </p>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-8 inline-flex min-h-12 items-center gap-3 rounded-full bg-[#1F9345] px-7 py-3 text-sm font-semibold text-white transition hover:bg-[#187C3B]">
                            Khám phá sản phẩm
                            <i class="ph ph-arrow-right text-lg"></i>
                        </a>
                    </div>

                    <!-- Product image -->
                    <div class="pointer-events-none absolute inset-x-0 bottom-[68px] top-[155px]
            flex items-center justify-center
            sm:top-[165px] sm:bottom-[72px]
            lg:relative lg:inset-auto lg:justify-end">
                        <img src="~/images/Banner/banner1/sp.png"
                             alt="Sản phẩm Caterin"
                             class="h-full max-h-[170px] w-auto max-w-[85%] object-contain
                drop-shadow-xl
                sm:max-h-[210px]
                lg:max-h-[440px] lg:max-w-full"
                             loading="eager" />
                    </div>

                    <!-- Mobile CTA -->
                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="absolute bottom-12 left-1/2 z-20 inline-flex -translate-x-1/2 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-[#1F9345] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-[#1F9345]/20 transition hover:bg-[#187C3B] lg:hidden">
                        Xem sản phẩm
                        <i class="ph ph-arrow-right text-lg"></i>
                    </a>
                </div>
            </div>

            <!-- Previous / Next -->
            <div class="absolute inset-x-3 top-1/2 z-20 hidden -translate-y-1/2 items-center justify-between sm:flex lg:inset-x-5">
                <button type="button"
                        data-banner-prev
                        aria-label="Banner trước"
                        class="flex h-11 w-11 items-center justify-center rounded-full border border-white/80 bg-white/90 text-gray-700 shadow-md backdrop-blur transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white">
                    <i class="ph ph-caret-left text-xl"></i>
                </button>

                <button type="button"
                        data-banner-next
                        aria-label="Banner tiếp theo"
                        class="flex h-11 w-11 items-center justify-center rounded-full border border-white/80 bg-white/90 text-gray-700 shadow-md backdrop-blur transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white">
                    <i class="ph ph-caret-right text-xl"></i>
                </button>
            </div>

            <!-- Bottom controls -->
            <div class="absolute bottom-5 left-6 right-6 z-20 flex items-center justify-between sm:left-10 sm:right-10 lg:left-16 lg:right-16">
                <div class="flex items-center gap-2">
                    <button type="button"
                            data-banner-dot="0"
                            aria-label="Chuyển đến banner 1"
                            aria-current="true"
                            class="h-2.5 w-8 rounded-full bg-[#1F9345] transition-all duration-300">
                    </button>
                    <button type="button"
                            data-banner-dot="1"
                            aria-label="Chuyển đến banner 2"
                            aria-current="false"
                            class="h-2.5 w-2.5 rounded-full bg-gray-300 transition-all duration-300 hover:bg-[#1F9345]">
                    </button>
                </div>

                <a href="#flash-sale"
                   class="hidden items-center gap-2 text-xs font-semibold text-[#1F9345] transition hover:gap-3 sm:inline-flex">
                    Khám phá ưu đãi
                    <i class="ph ph-arrow-down text-base"></i>
                </a>
            </div>
        </div>
    </div>
</div>
