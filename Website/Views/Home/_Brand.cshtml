@{
    Layout = null;
}

@{
    var brands = new[]
    {
        new { Name = "Brand 1", Image = "~/images/Demos/brand-img1.png" },
        new { Name = "Brand 2", Image = "~/images/Demos/brand-img2.png" },
        new { Name = "Brand 3", Image = "~/images/Demos/brand-img3.png" },
        new { Name = "Brand 4", Image = "~/images/Demos/brand-img4.png" },
        new { Name = "Brand 5", Image = "~/images/Demos/brand-img5.png" },
        new { Name = "Brand 6", Image = "~/images/Demos/brand-img6.png" },
        new { Name = "Brand 7", Image = "~/images/Demos/brand-img7.png" },
        new { Name = "Brand 8", Image = "~/images/Demos/brand-img8.png" },
        new { Name = "Brand 9", Image = "~/images/Demos/brand-img3.png" }
    };
}

<section id="homeBrands" class="px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-16">
    <div class="mx-auto w-full max-w-[1440px]">
        <div class="overflow-hidden rounded-3xl border border-[#E5EDE2] bg-[#F5F9F2] p-5 sm:p-7 lg:p-9">

            <!-- Heading -->
            <div class="mb-6 flex flex-wrap items-center justify-between gap-4 sm:mb-8">
                <div>
                    <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.16em] text-[#1F9345]">
                        Đối tác thương hiệu
                    </span>
                    <h2 class="text-xl font-bold text-[#183B2A] sm:text-2xl">
                        Thương hiệu nổi bật
                    </h2>
                </div>

                <div class="flex items-center gap-3">
                    <a href="/brands"
                       class="text-sm font-semibold text-[#315B3D] transition hover:text-[#1F9345]">
                        Xem tất cả
                        <i class="ph ph-arrow-right ml-1"></i>
                    </a>

                    <div class="flex items-center gap-2">
                        <button type="button"
                                id="brand-prev"
                                aria-label="Thương hiệu trước"
                                class="flex size-9 items-center justify-center rounded-full border border-[#DCE8D8] bg-white text-lg text-[#315B3D] transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white">
                            <i class="ph ph-caret-left"></i>
                        </button>

                        <button type="button"
                                id="brand-next"
                                aria-label="Thương hiệu tiếp theo"
                                class="flex size-9 items-center justify-center rounded-full border border-[#DCE8D8] bg-white text-lg text-[#315B3D] transition hover:border-[#1F9345] hover:bg-[#1F9345] hover:text-white">
                            <i class="ph ph-caret-right"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Slider -->
            <div id="brand-slider" class="overflow-hidden">
                <div id="brand-track" class="flex items-stretch">
                    @for (var i = 0; i < brands.Length; i++)
                    {
                        var brand = brands[i];

                        <div class="brand-slide min-w-0 shrink-0 px-2">
                            <a href="/brands"
                               class="group flex h-24 items-center justify-center rounded-2xl border border-[#E5EDE2] bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-[#C9DDC3] hover:shadow-md sm:h-28 sm:p-6"
                               aria-label="@brand.Name">

                                <img src="@Url.Content(brand.Image)"
                                     alt="@brand.Name"
                                     loading="lazy"
                                     class="max-h-full max-w-full object-contain opacity-80 grayscale transition duration-300 group-hover:opacity-100 group-hover:grayscale-0" />
                            </a>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>
