@{
    Layout = null;
}

<section id="flash-sale" class="py-8 sm:py-10 lg:py-12">
    <div class="container mx-auto px-4">

        <!-- Flash Sale Container -->
        <div class="overflow-hidden rounded-2xl border border-[#F8E2D9] bg-[#FFF5F0] p-4 shadow-sm sm:rounded-3xl sm:p-6 lg:p-8">

            <!-- Heading -->
            <div class="mb-6 flex flex-wrap items-center justify-between gap-4 sm:mb-8">
                <div>
                    <div class="mb-2 flex items-center gap-2">
                        <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#E94343] text-white shadow-sm shadow-red-200">
                            <i class="ph-fill ph-lightning text-lg"></i>
                        </span>

                        <span class="text-xs font-bold uppercase tracking-[0.15em] text-[#E94343]">
                            Ưu đãi có thời hạn
                        </span>
                    </div>

                    <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl">
                        <span class="text-[#E94343]">Flash</span> Sale
                    </h2>

                    <p class="mt-1 text-xs text-gray-500 sm:text-sm">
                        Những lựa chọn chăm sóc nhà cửa với giá tốt hơn.
                    </p>
                </div>

                <a asp-controller="Shop"
                   asp-action="Index"
                   class="hidden items-center gap-2 text-sm font-semibold text-[#D83D35] transition hover:gap-3 sm:inline-flex">
                    Xem tất cả
                    <i class="ph ph-arrow-right"></i>
                </a>
            </div>

            <!-- Campaign Banner -->
            <div class="mb-6 flex flex-col gap-4 overflow-hidden rounded-2xl bg-gradient-to-r from-[#E94343] via-[#F05243] to-[#FF7043] px-4 py-4 text-white sm:flex-row sm:items-center sm:justify-between sm:px-6">
                <div class="flex min-w-0 items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/15">
                        <i class="ph-fill ph-tag text-xl"></i>
                    </div>

                    <div class="min-w-0">
                        <p class="text-sm font-bold sm:text-base">
                            Ưu đãi đặc biệt từ Caterin
                        </p>
                        <p class="mt-0.5 text-xs text-white/80">
                            Chọn sản phẩm yêu thích và khám phá ưu đãi hiện có.
                        </p>
                    </div>
                </div>

                <div class="flex shrink-0 items-center justify-between gap-3 sm:justify-end">
                    <span class="text-xs font-medium text-white/80">
                        Khám phá ngay
                    </span>

                    <a asp-controller="Shop"
                       asp-action="Index"
                       class="inline-flex items-center gap-2 rounded-full bg-[#FFC857] px-4 py-2.5 text-xs font-bold text-[#71301F] transition hover:bg-white">
                        Mua sắm
                        <i class="ph ph-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">

                <!-- Product 1 -->
                <article class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-[#F5E5DE] bg-white transition duration-300 hover:-translate-y-1 hover:border-[#F2B7A8] hover:shadow-xl hover:shadow-red-900/5 sm:rounded-2xl">

                    <div class="relative aspect-square overflow-hidden bg-[#FFF9F6] p-3 sm:p-5">
                        <span class="absolute left-2.5 top-2.5 z-10 rounded-md bg-[#E94343] px-2 py-1 text-[9px] font-bold text-white sm:left-3 sm:top-3 sm:text-[10px]">
                            FLASH SALE
                        </span>

                        <img src="~/images/Demos/product-two-img1.png"
                             alt="Nước rửa tay hương sen Caterin"
                             class="h-full w-full object-contain transition duration-500 group-hover:scale-105"
                             loading="lazy" />
                    </div>

                    <div class="flex flex-1 flex-col p-3 sm:p-4">
                        <span class="text-[10px] font-semibold uppercase tracking-wide text-[#D83D35] sm:text-xs">
                            Nước rửa tay
                        </span>

                        <h3 class="mt-1 line-clamp-2 min-h-10 text-xs font-semibold leading-5 text-gray-800 sm:min-h-12 sm:text-sm">
                            Nước rửa tay hương sen Caterin
                        </h3>

                        <div class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                            <span class="text-sm font-extrabold text-[#E94343] sm:text-lg">
                                Giá ưu đãi
                            </span>
                        </div>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-[#FFF0E9] px-2 py-2.5 text-[10px] font-bold text-[#D83D35] transition hover:bg-[#E94343] hover:text-white sm:mt-4 sm:text-xs">
                            Khám phá
                            <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- Product 2 -->
                <article class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-[#F5E5DE] bg-white transition duration-300 hover:-translate-y-1 hover:border-[#F2B7A8] hover:shadow-xl hover:shadow-red-900/5 sm:rounded-2xl">

                    <div class="relative aspect-square overflow-hidden bg-[#FFF9F6] p-3 sm:p-5">
                        <span class="absolute left-2.5 top-2.5 z-10 rounded-md bg-[#E94343] px-2 py-1 text-[9px] font-bold text-white sm:left-3 sm:top-3 sm:text-[10px]">
                            FLASH SALE
                        </span>

                        <img src="~/images/Demos/product-two-img2.png"
                             alt="Nước rửa tay hương gạo Caterin"
                             class="h-full w-full object-contain transition duration-500 group-hover:scale-105"
                             loading="lazy" />
                    </div>

                    <div class="flex flex-1 flex-col p-3 sm:p-4">
                        <span class="text-[10px] font-semibold uppercase tracking-wide text-[#D83D35] sm:text-xs">
                            Nước rửa tay
                        </span>

                        <h3 class="mt-1 line-clamp-2 min-h-10 text-xs font-semibold leading-5 text-gray-800 sm:min-h-12 sm:text-sm">
                            Nước rửa tay hương gạo Caterin
                        </h3>

                        <div class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                            <span class="text-sm font-extrabold text-[#E94343] sm:text-lg">
                                Giá ưu đãi
                            </span>
                        </div>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-[#FFF0E9] px-2 py-2.5 text-[10px] font-bold text-[#D83D35] transition hover:bg-[#E94343] hover:text-white sm:mt-4 sm:text-xs">
                            Khám phá
                            <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- Product 3 -->
                <article class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-[#F5E5DE] bg-white transition duration-300 hover:-translate-y-1 hover:border-[#F2B7A8] hover:shadow-xl hover:shadow-red-900/5 sm:rounded-2xl">

                    <div class="relative aspect-square overflow-hidden bg-[#FFF9F6] p-3 sm:p-5">
                        <span class="absolute left-2.5 top-2.5 z-10 rounded-md bg-[#E94343] px-2 py-1 text-[9px] font-bold text-white sm:left-3 sm:top-3 sm:text-[10px]">
                            FLASH SALE
                        </span>

                        <img src="~/images/Demos/product-two-img3.png"
                             alt="Nước rửa chén cam quế Caterin"
                             class="h-full w-full object-contain transition duration-500 group-hover:scale-105"
                             loading="lazy" />
                    </div>

                    <div class="flex flex-1 flex-col p-3 sm:p-4">
                        <span class="text-[10px] font-semibold uppercase tracking-wide text-[#D83D35] sm:text-xs">
                            Nước rửa chén
                        </span>

                        <h3 class="mt-1 line-clamp-2 min-h-10 text-xs font-semibold leading-5 text-gray-800 sm:min-h-12 sm:text-sm">
                            Nước rửa chén cam quế Caterin
                        </h3>

                        <div class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                            <span class="text-sm font-extrabold text-[#E94343] sm:text-lg">
                                Giá ưu đãi
                            </span>
                        </div>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-[#FFF0E9] px-2 py-2.5 text-[10px] font-bold text-[#D83D35] transition hover:bg-[#E94343] hover:text-white sm:mt-4 sm:text-xs">
                            Khám phá
                            <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>
                </article>

                <!-- Product 4 -->
                <article class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-[#F5E5DE] bg-white transition duration-300 hover:-translate-y-1 hover:border-[#F2B7A8] hover:shadow-xl hover:shadow-red-900/5 sm:rounded-2xl">

                    <div class="relative aspect-square overflow-hidden bg-[#FFF9F6] p-3 sm:p-5">
                        <span class="absolute left-2.5 top-2.5 z-10 rounded-md bg-[#E94343] px-2 py-1 text-[9px] font-bold text-white sm:left-3 sm:top-3 sm:text-[10px]">
                            FLASH SALE
                        </span>

                        <img src="~/images/Demos/product-two-img4.png"
                             alt="Nước lau sàn hương lavender Caterin"
                             class="h-full w-full object-contain transition duration-500 group-hover:scale-105"
                             loading="lazy" />
                    </div>

                    <div class="flex flex-1 flex-col p-3 sm:p-4">
                        <span class="text-[10px] font-semibold uppercase tracking-wide text-[#D83D35] sm:text-xs">
                            Nước lau sàn
                        </span>

                        <h3 class="mt-1 line-clamp-2 min-h-10 text-xs font-semibold leading-5 text-gray-800 sm:min-h-12 sm:text-sm">
                            Nước lau sàn hương lavender Caterin
                        </h3>

                        <div class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                            <span class="text-sm font-extrabold text-[#E94343] sm:text-lg">
                                Giá ưu đãi
                            </span>
                        </div>

                        <a asp-controller="Shop"
                           asp-action="Index"
                           class="mt-auto inline-flex w-full items-center justify-center gap-1.5 rounded-lg bg-[#FFF0E9] px-2 py-2.5 text-[10px] font-bold text-[#D83D35] transition hover:bg-[#E94343] hover:text-white sm:mt-4 sm:text-xs">
                            Khám phá
                            <i class="ph ph-arrow-right"></i>
                        </a>
                    </div>
                </article>

            </div>

            <!-- Mobile View All -->
            <div class="mt-6 text-center sm:hidden">
                <a asp-controller="Shop"
                   asp-action="Index"
                   class="inline-flex items-center gap-2 rounded-full border border-[#F2B7A8] bg-white px-5 py-2.5 text-xs font-bold text-[#D83D35] transition hover:bg-[#E94343] hover:text-white">
                    Xem tất cả sản phẩm
                    <i class="ph ph-arrow-right"></i>
                </a>
            </div>

        </div>
    </div>
</section>
