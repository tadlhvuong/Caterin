@{
    Layout = null;
}

<section id="homeNewsletter" class="px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto w-full max-w-[1440px]">

        <div class="relative isolate overflow-hidden rounded-2xl bg-[#1F9345] px-5 py-10 shadow-sm sm:rounded-3xl sm:px-8 sm:py-12 lg:px-12 lg:py-14">

            <!-- Background -->
            <img src="@Url.Content("~/images/Demos/newsletter-bg.png")"
                 alt=""
                 aria-hidden="true"
                 class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover opacity-10" />

            <!-- Decorative overlay -->
            <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-br from-[#1F9345]/10 via-transparent to-[#176F36]/30"></div>

            <div class="relative z-10 grid items-center gap-8 lg:grid-cols-2 lg:gap-6">

                <!-- Content -->
                <div class="mx-auto w-full max-w-2xl text-center lg:mx-0 lg:text-left">

                    <span class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-sm">
                        <i class="ph ph-envelope-simple text-base"></i>
                        Bản tin Caterin
                    </span>

                    <h2 class="text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl lg:text-4xl">
                        Đừng bỏ lỡ ưu đãi hấp dẫn!
                    </h2>

                    <p class="mt-3 text-sm leading-7 text-white/90 sm:text-base">
                        Đăng ký nhận bản tin để cập nhật sản phẩm mới,
                        chương trình ưu đãi và những mẹo chăm sóc nhà cửa hữu ích.
                    </p>

                    <!-- Newsletter Form -->
                    <form id="newsletterForm"
                          action="#"
                          method="post"
                          class="mt-7 flex flex-col gap-2 rounded-2xl border border-white/20 bg-white p-2 shadow-lg sm:flex-row sm:items-center sm:rounded-full">

                        @Html.AntiForgeryToken()

                        <label for="newsletterEmail" class="sr-only">
                            Địa chỉ email
                        </label>

                        <div class="flex min-w-0 flex-1 items-center gap-3 rounded-xl px-3 transition focus-within:bg-[#F5F9F2] sm:rounded-full">

                            <i class="ph ph-envelope text-xl text-[#1F9345]"></i>

                            <input type="email"
                                   id="newsletterEmail"
                                   name="email"
                                   required
                                   autocomplete="email"
                                   inputmode="email"
                                   placeholder="Nhập email của bạn..."
                                   class="w-full min-w-0 border-0 bg-transparent py-3 text-sm text-gray-800 outline-none ring-0 placeholder:text-gray-400 focus:border-0 focus:outline-none focus:ring-0" />
                        </div>

                        <button type="submit"
                                class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-xl bg-[#8CC63F] px-6 py-3 text-sm font-bold text-[#183B2A] shadow-sm transition duration-200 hover:bg-[#A3D65B] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1F9345] focus-visible:ring-offset-2 active:scale-[0.98] sm:w-auto sm:rounded-full">

                            Đăng ký ngay
                            <i class="ph ph-arrow-right text-lg transition-transform group-hover:translate-x-1"></i>
                        </button>
                    </form>

                    <p class="mt-3 flex items-center justify-center gap-1.5 text-xs leading-5 text-white/80 lg:justify-start">
                        <i class="ph-fill ph-shield-check text-sm"></i>
                        Chúng tôi tôn trọng quyền riêng tư và không gửi email làm phiền bạn.
                    </p>
                </div>

                <!-- Illustration -->
                <div class="hidden items-center justify-center lg:flex">
                    <img src="@Url.Content("~/images/Demos/newsletter-img.png")"
                         alt="Đăng ký nhận bản tin Caterin"
                         loading="lazy"
                         class="max-h-[320px] max-w-full object-contain drop-shadow-xl xl:max-h-[360px]" />
                </div>

            </div>
        </div>
    </div>
</section>
