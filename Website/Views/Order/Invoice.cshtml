@using Website.Models.Order
@model OrderDetailsViewModel

@{
    ViewData["Title"] = $"Hóa đơn đơn hàng {Model.OrderCode} | Caterin";
}

<style>
    @@media print {
        @@page {
            size: A4;
            margin: 15mm;
        }

        body {
            background: white !important;
        }

        .no-print {
            display: none !important;
        }

        .invoice-page {
            padding: 0 !important;
            background: white !important;
        }

        .invoice-paper {
            max-width: none !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
        }

        .invoice-table {
            page-break-inside: auto;
        }

            .invoice-table tr {
                page-break-inside: avoid;
            }
    }
</style>

<div class="invoice-page min-h-screen bg-[#f8faf8] px-4 py-8 sm:py-12">

    <div class="no-print mx-auto mb-6 flex max-w-4xl flex-wrap items-center justify-between gap-3">
        <a asp-controller="Order"
           asp-action="Details"
           asp-route-orderCode="@Model.OrderCode"
           class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-[#1F9345]">
            <i class="ph ph-arrow-left text-lg"></i>
            Quay lại đơn hàng
        </a>

        <button type="button"
                onclick="window.print()"
                class="inline-flex items-center gap-2 rounded-xl bg-[#1F9345] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#187b39]">
            <i class="ph ph-printer text-lg"></i>
            In hóa đơn
        </button>
    </div>

    <main class="invoice-paper mx-auto max-w-4xl rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:p-10">

        @* HEADER *@
        <header class="flex flex-col gap-5 border-b border-gray-200 pb-7 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <div class="flex items-center gap-3">
                    <div class="flex size-12 items-center justify-center rounded-xl bg-[#1F9345] text-white">
                        <i class="ph ph-leaf text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-extrabold tracking-wide text-[#1F9345]">
                            CATERIN
                        </h1>
                        <p class="text-xs text-gray-500">
                            An toàn cho mọi nhà
                        </p>
                    </div>
                </div>
            </div>

            <div class="sm:text-right">
                <h2 class="text-2xl font-bold uppercase tracking-wide text-gray-900">
                    Hóa đơn đơn hàng
                </h2>
                <p class="mt-2 text-sm text-gray-500">
                    Mã đơn hàng
                </p>
                <p class="font-bold text-[#1F9345]">
                    @Model.OrderCode
                </p>
            </div>
        </header>

        @* ORDER INFORMATION *@
        <section class="grid grid-cols-1 gap-6 border-b border-gray-200 py-7 sm:grid-cols-2">
            <div>
                <h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-gray-900">
                    Thông tin đơn hàng
                </h3>

                <div class="space-y-2 text-sm">
                    <div class="flex justify-between gap-4">
                        <span class="text-gray-500">Mã đơn hàng</span>
                        <span class="font-semibold text-gray-800">@Model.OrderCode</span>
                    </div>

                    <div class="flex justify-between gap-4">
                        <span class="text-gray-500">Ngày đặt hàng</span>
                        <span class="font-medium text-gray-800">
                            @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>

                    <div class="flex justify-between gap-4">
                        <span class="text-gray-500">Phương thức thanh toán</span>
                        <span class="font-medium text-gray-800">
                            @Model.PaymentMethodLabel
                        </span>
                    </div>

                    <div class="flex justify-between gap-4">
                        <span class="text-gray-500">Trạng thái thanh toán</span>
                        <span class="font-semibold text-gray-800">
                            @Model.PaymentStatusLabel
                        </span>
                    </div>
                </div>
            </div>

            <div>
                <h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-gray-900">
                    Thông tin người nhận
                </h3>

                <div class="space-y-2 text-sm">
                    <div>
                        <p class="text-gray-500">Họ và tên</p>
                        <p class="font-semibold text-gray-800">
                            @Model.RecipientName
                        </p>
                    </div>

                    <div>
                        <p class="text-gray-500">Số điện thoại</p>
                        <p class="font-medium text-gray-800">
                            @Model.PhoneNumber
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <div>
                            <p class="text-gray-500">Email</p>
                            <p class="font-medium text-gray-800">
                                @Model.Email
                            </p>
                        </div>
                    }

                    <div>
                        <p class="text-gray-500">Địa chỉ giao hàng</p>
                        <p class="font-medium leading-6 text-gray-800">
                            @Model.ShippingAddress
                        </p>
                    </div>
                </div>
            </div>
        </section>

        @* ORDER ITEMS *@
        <section class="py-7">
            <h3 class="mb-4 text-sm font-bold uppercase tracking-wide text-gray-900">
                Chi tiết sản phẩm
            </h3>

            <div class="overflow-x-auto">
                <table class="invoice-table w-full min-w-[560px] text-sm">
                    <thead>
                        <tr class="border-y border-gray-200 bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
                            <th class="px-3 py-3 font-semibold">Sản phẩm</th>
                            <th class="px-3 py-3 text-right font-semibold">Đơn giá</th>
                            <th class="px-3 py-3 text-center font-semibold">SL</th>
                            <th class="px-3 py-3 text-right font-semibold">Thành tiền</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100">
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="px-3 py-4">
                                    <p class="font-semibold text-gray-800">
                                        @item.ProductName
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(item.VariantName))
                                    {
                                        <p class="mt-1 text-xs text-gray-500">
                                            @item.VariantName
                                        </p>
                                    }
                                </td>

                                <td class="whitespace-nowrap px-3 py-4 text-right text-gray-600">
                                    @item.UnitPrice.ToString("N0")₫
                                </td>

                                <td class="px-3 py-4 text-center text-gray-600">
                                    @item.Quantity
                                </td>

                                <td class="whitespace-nowrap px-3 py-4 text-right font-semibold text-gray-800">
                                    @item.TotalPrice.ToString("N0")₫
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* TOTAL *@
        <section class="border-t border-gray-200 pt-6">
            <div class="ml-auto max-w-sm space-y-3 text-sm">
                <div class="flex justify-between gap-4">
                    <span class="text-gray-500">Tạm tính</span>
                    <span class="font-medium text-gray-800">
                        @Model.SubTotal.ToString("N0")₫
                    </span>
                </div>

                <div class="flex justify-between gap-4">
                    <span class="text-gray-500">Phí vận chuyển</span>
                    <span class="font-medium text-gray-800">
                        @Model.ShippingFee.ToString("N0")₫
                    </span>
                </div>

                <div class="flex justify-between gap-4">
                    <span class="text-gray-500">Giảm giá</span>
                    <span class="font-medium text-green-600">
                        -@Model.DiscountAmount.ToString("N0")₫
                    </span>
                </div>

                <div class="flex justify-between gap-4 border-t border-dashed border-gray-200 pt-4">
                    <span class="font-bold text-gray-900">Tổng thanh toán</span>
                    <span class="text-xl font-extrabold text-[#1F9345]">
                        @Model.TotalAmount.ToString("N0")₫
                    </span>
                </div>
            </div>
        </section>

        @* FOOTER *@
        <footer class="mt-10 border-t border-gray-200 pt-7 text-center">
            <p class="font-semibold text-gray-800">
                Cảm ơn bạn đã tin tưởng và lựa chọn Caterin!
            </p>

            <p class="mt-2 text-sm text-gray-500">
                An toàn cho mọi nhà
            </p>

            <p class="mt-4 text-xs leading-5 text-gray-400">
                Đây là phiếu xác nhận thông tin đơn hàng được tạo từ hệ thống Caterin.
                Không thay thế hóa đơn điện tử hoặc hóa đơn VAT theo quy định pháp luật.
            </p>
        </footer>

    </main>
</div>
