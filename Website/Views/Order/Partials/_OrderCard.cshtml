@model Website.Models.Order.OrderListItemViewModel

@{
    var statusClasses = Model.Status switch
    {
        "Pending" => "bg-amber-50 text-amber-700 ring-amber-100",
        "Processing" => "bg-blue-50 text-blue-700 ring-blue-100",
        "Shipping" => "bg-indigo-50 text-indigo-700 ring-indigo-100",
        "Completed" => "bg-green-50 text-green-700 ring-green-100",
        "Cancelled" => "bg-red-50 text-red-700 ring-red-100",
        _ => "bg-gray-50 text-gray-600 ring-gray-100"
    };

    var statusIcon = Model.Status switch
    {
        "Pending" => "ph-clock",
        "Processing" => "ph-package",
        "Shipping" => "ph-truck",
        "Completed" => "ph-check-circle",
        "Cancelled" => "ph-x-circle",
        _ => "ph-info"
    };
}

<article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition hover:shadow-md">

    @* ================= CARD HEADER ================= *@
    <div class="flex flex-col justify-between gap-3 border-b border-gray-100 px-5 py-4 sm:flex-row sm:items-center sm:px-6">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <div>
                <p class="text-xs text-gray-400">Mã đơn hàng</p>
                <p class="mt-1 font-bold text-gray-900">
                    @Model.OrderCode
                </p>
            </div>

            <span class="hidden h-8 w-px bg-gray-200 sm:block"></span>

            <div>
                <p class="text-xs text-gray-400">Ngày đặt hàng</p>
                <p class="mt-1 text-sm font-medium text-gray-700">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </p>
            </div>
        </div>

        <span class="inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold ring-1 ring-inset @statusClasses">
            <i class="ph @statusIcon text-base"></i>
            @Model.StatusLabel
        </span>
    </div>

    @* ================= PRODUCT INFO ================= *@
    <div class="flex flex-col gap-5 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="flex min-w-0 items-center gap-4">
            <div class="flex size-20 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-gray-100 bg-gray-50">
                @if (!string.IsNullOrWhiteSpace(Model.FirstProductImage))
                {
                    <img src="@Model.FirstProductImage"
                         alt="@Model.FirstProductName"
                         class="size-full object-cover"
                         loading="lazy" />
                }
                else
                {
                    <i class="ph ph-image text-3xl text-gray-300"></i>
                }
            </div>

            <div class="min-w-0">
                <h3 class="line-clamp-2 font-semibold leading-6 text-gray-900">
                    @(Model.FirstProductName ?? "Sản phẩm Caterin")
                </h3>

                <p class="mt-2 text-sm text-gray-500">
                    @Model.TotalItems sản phẩm
                </p>

                <p class="mt-1 text-xs text-gray-400">
                    @Model.PaymentMethodLabel
                    <span class="mx-1">·</span>
                    @Model.PaymentStatusLabel
                </p>
            </div>
        </div>

        <div class="shrink-0 sm:text-right">
            <p class="text-xs text-gray-500">Tổng thanh toán</p>
            <p class="mt-1 text-xl font-bold text-[#1F9345]">
                @Model.TotalAmount.ToString("N0")đ
            </p>
        </div>
    </div>

    @* ================= CARD ACTIONS ================= *@
    <div class="flex flex-col-reverse gap-3 border-t border-gray-100 bg-gray-50/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <a asp-controller="Order"
           asp-action="Track"
           asp-route-orderCode="@Model.OrderCode"
           class="inline-flex items-center justify-center gap-2 text-sm font-medium text-gray-600 transition hover:text-[#1F9345]">
            <i class="ph ph-map-pin-line text-lg"></i>
            Theo dõi đơn hàng
        </a>

        <div class="flex flex-col gap-2 sm:flex-row">

            @if (Model.CanReview)
            {
                <a asp-controller="Order"
                   asp-action="Review"
                   asp-route-orderCode="@Model.OrderCode"
                   class="inline-flex items-center justify-center gap-2 rounded-full border border-[#1F9345] px-4 py-2 text-sm font-semibold text-[#1F9345] transition hover:bg-green-50">
                    <i class="ph ph-star"></i>
                    Đánh giá sản phẩm
                </a>
            }


            <a asp-controller="Order"
               asp-action="Details"
               asp-route-orderCode="@Model.OrderCode"
               class="inline-flex items-center justify-center gap-2 rounded-full bg-[#1F9345] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-[#187a39]">
                Xem chi tiết
                <i class="ph ph-arrow-right text-base"></i>
            </a>
        </div>
    </div>
</article>
