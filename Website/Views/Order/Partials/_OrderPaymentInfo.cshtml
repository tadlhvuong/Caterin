@using Website.Models.Order
@model OrderDetailsViewModel

@{
    var isPaid = string.Equals(Model.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
    var isFailed = string.Equals(Model.PaymentStatus, "Failed", StringComparison.OrdinalIgnoreCase);
    var isCod = string.Equals(Model.PaymentMethod, "COD", StringComparison.OrdinalIgnoreCase);

    var badgeClass = isPaid
        ? "bg-green-50 text-green-700"
        : isFailed
            ? "bg-red-50 text-red-700"
            : "bg-amber-50 text-amber-700";
}

<div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="font-bold text-gray-900">Thông tin thanh toán</h2>

    <div class="mt-5 space-y-4 text-sm">
        <div class="flex justify-between gap-3">
            <span class="text-gray-500">Phương thức</span>
            <span class="text-right font-medium text-gray-800">
                @Model.PaymentMethodLabel
            </span>
        </div>

        <div class="flex justify-between gap-3">
            <span class="text-gray-500">Trạng thái</span>
            <span class="rounded-full px-3 py-1 text-xs font-semibold @badgeClass">
                @Model.PaymentStatusLabel
            </span>
        </div>

        @if (isPaid)
        {
            <div class="rounded-xl bg-green-50 p-3 text-xs leading-5 text-green-800">
                Thanh toán đã được xác nhận thành công.
            </div>
        }
        else if (isFailed)
        {
            <div class="rounded-xl bg-red-50 p-3 text-xs leading-5 text-red-800">
                Giao dịch không thành công. Vui lòng kiểm tra kết quả thanh toán hoặc liên hệ hỗ trợ.
            </div>
        }
        else if (isCod)
        {
            <div class="rounded-xl bg-amber-50 p-3 text-xs leading-5 text-amber-800">
                Bạn sẽ thanh toán cho nhân viên giao hàng khi nhận được đơn hàng.
            </div>
        }
        else
        {
            <div class="rounded-xl bg-amber-50 p-3 text-xs leading-5 text-amber-800">
                Giao dịch đang được xử lý. Vui lòng chờ hệ thống xác nhận.
            </div>
        }
    </div>
</div>
