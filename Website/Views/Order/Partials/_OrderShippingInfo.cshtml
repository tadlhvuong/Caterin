@using Website.Models.Order
@model OrderDetailsViewModel

<div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm sm:p-6">
    <div class="mb-5 flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#eaf7e9] text-[#1F9345]">
            <i class="ph ph-map-pin-line text-xl"></i>
        </div>
        <div>
            <h2 class="font-bold text-gray-900">Thông tin giao hàng</h2>
            <p class="mt-1 text-xs text-gray-500">Thông tin người nhận và vận chuyển</p>
        </div>
    </div>

    <div class="space-y-3 text-sm">
        <div class="flex flex-wrap justify-between gap-2">
            <span class="text-gray-500">Người nhận</span>
            <span class="font-semibold text-gray-900">@Model.RecipientName</span>
        </div>

        <div class="flex flex-wrap justify-between gap-2">
            <span class="text-gray-500">Số điện thoại</span>
            <span class="font-semibold text-gray-900">@Model.PhoneNumber</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            <div class="flex flex-wrap justify-between gap-2">
                <span class="text-gray-500">Email</span>
                <span class="break-all text-right font-medium text-gray-800">@Model.Email</span>
            </div>
        }

        <div class="flex flex-wrap justify-between gap-2">
            <span class="text-gray-500">Địa chỉ</span>
            <span class="max-w-md text-right font-medium leading-6 text-gray-800">
                @Model.ShippingAddress
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ShippingNote))
        {
            <div class="flex flex-wrap justify-between gap-2">
                <span class="text-gray-500">Ghi chú giao hàng</span>
                <span class="max-w-md text-right text-gray-800">@Model.ShippingNote</span>
            </div>
        }
    </div>

    <div class="mt-5 border-t border-gray-100 pt-5">
        <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-gray-900">
            <i class="ph ph-truck text-lg text-[#1F9345]"></i>
            Thông tin vận chuyển
        </h3>

        <div class="space-y-3 text-sm">
            <div class="flex flex-wrap justify-between gap-2">
                <span class="text-gray-500">Đơn vị vận chuyển</span>
                <span class="font-medium text-gray-800">
                    @(string.IsNullOrWhiteSpace(Model.CarrierName)
                                        ? "Chưa bàn giao"
                                        : Model.CarrierName)
                </span>
            </div>

            <div class="flex flex-wrap justify-between gap-2">
                <span class="text-gray-500">Mã vận đơn</span>
                <span class="font-medium text-gray-800">
                    @(string.IsNullOrWhiteSpace(Model.TrackingNumber)
                                        ? "Chưa có"
                                        : Model.TrackingNumber)
                </span>
            </div>

            <div class="flex flex-wrap justify-between gap-2">
                <span class="text-gray-500">Dự kiến giao</span>
                <span class="font-medium text-gray-800">
                    @(Model.EstimatedDeliveryAt?.ToString("dd/MM/yyyy") ?? "Đang cập nhật")
                </span>
            </div>
        </div>
    </div>
</div>
