@model Website.Models.Order.ReturnRequestHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử yêu cầu đổi trả";

    var statusOptions = new[]
    {
        new { Value = "", Label = "Tất cả yêu cầu" },
        new { Value = "Pending", Label = "Chờ xác nhận" },
        new { Value = "Processing", Label = "Đang xử lý" },
        new { Value = "Approved", Label = "Đã duyệt" },
        new { Value = "Rejected", Label = "Từ chối" },
        new { Value = "Completed", Label = "Hoàn tất" }
    };
}

<section class="bg-[#f7faf7] py-10 lg:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumb -->
        <div class="mb-6 flex flex-wrap items-center gap-2 text-sm text-gray-500">
            <a href="/" class="transition hover:text-[#249e63]">Trang chủ</a>
            <i class="ph ph-caret-right text-xs"></i>
            <a href="/order" class="transition hover:text-[#249e63]">Đơn hàng của tôi</a>
            <i class="ph ph-caret-right text-xs"></i>
            <span class="font-medium text-gray-800">Lịch sử đổi trả</span>
        </div>

        <!-- Header -->
        <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <div>
                <h1 class="text-2xl font-bold text-gray-900 lg:text-3xl">
                    Lịch sử yêu cầu đổi trả
                </h1>
                <p class="mt-2 text-sm text-gray-500">
                    Theo dõi các yêu cầu đổi sản phẩm và hoàn tiền của bạn.
                </p>
            </div>

            <a href="/order"
               class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-700 transition hover:border-[#249e63] hover:text-[#249e63]">
                <i class="ph ph-receipt text-lg"></i>
                Đơn hàng của tôi
            </a>
        </div>

        <!-- Statistics -->
        <div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">

            <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Tổng yêu cầu</span>
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600">
                        <i class="ph ph-files text-xl"></i>
                    </span>
                </div>
                <p class="mt-3 text-2xl font-bold text-gray-900">
                    @Model.TotalRequests
                </p>
            </div>

            <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Chờ xác nhận</span>
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-50 text-amber-600">
                        <i class="ph ph-clock text-xl"></i>
                    </span>
                </div>
                <p class="mt-3 text-2xl font-bold text-amber-600">
                    @Model.PendingRequests
                </p>
            </div>

            <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Đang xử lý</span>
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-50 text-blue-600">
                        <i class="ph ph-arrows-clockwise text-xl"></i>
                    </span>
                </div>
                <p class="mt-3 text-2xl font-bold text-blue-600">
                    @Model.ProcessingRequests
                </p>
            </div>

            <div class="rounded-xl border border-gray-100 bg-white p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500">Đã xử lý</span>
                    <span class="flex h-10 w-10 items-center justify-center rounded-full bg-green-50 text-green-600">
                        <i class="ph ph-check-circle text-xl"></i>
                    </span>
                </div>
                <p class="mt-3 text-2xl font-bold text-green-600">
                    @Model.CompletedRequests
                </p>
            </div>

        </div>

        <!-- Filter -->
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-gray-900">
                Danh sách yêu cầu
            </h2>

            <form method="get"
                  action="/order/return-requests"
                  class="w-full sm:w-auto">
                <select name="status"
                        onchange="this.form.submit()"
                        class="w-full min-w-48 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-700 outline-none transition focus:border-[#249e63] focus:ring-2 focus:ring-[#249e63]/10 sm:w-auto">
                    @foreach (var option in statusOptions)
                    {
                        <option value="@option.Value"
                                selected="@(Model.StatusFilter == option.Value)">
                            @option.Label
                        </option>
                    }
                </select>
            </form>
        </div>

        @if (Model.Requests.Any())
        {
            <div class="space-y-4">
                @foreach (var request in Model.Requests)
                {
                    var badgeClass = request.StatusColor switch
                    {
                        "success" => "bg-green-50 text-green-700",
                        "danger" => "bg-red-50 text-red-700",
                        "info" => "bg-blue-50 text-blue-700",
                        "warning" => "bg-amber-50 text-amber-700",
                        _ => "bg-gray-100 text-gray-700"
                    };

                    <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition hover:shadow-md">

                        <!-- Request header -->
                        <div class="flex flex-col gap-3 border-b border-gray-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="font-bold text-gray-900">
                                        @request.RequestCode
                                    </span>

                                    <span class="rounded-full px-3 py-1 text-xs font-semibold @badgeClass">
                                        @request.StatusLabel
                                    </span>
                                </div>

                                <p class="mt-1 text-xs text-gray-500">
                                    Gửi yêu cầu lúc
                                    @request.RequestedAt.ToString("HH:mm - dd/MM/yyyy")
                                </p>
                            </div>

                            <span class="text-sm font-semibold text-[#249e63]">
                                @request.RequestTypeLabel
                            </span>
                        </div>

                        <!-- Request content -->
                        <div class="grid gap-5 p-5 lg:grid-cols-[1fr_auto] lg:items-center">

                            <div class="flex min-w-0 gap-4">
                                <div class="h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-gray-50">
                                    <img src="@(string.IsNullOrWhiteSpace(request.FirstProductImage)
                                                                                             ? "/images/Default/default-product.png"
                                                                                             : request.FirstProductImage)"
                                 alt="@request.FirstProductName"
                                 class="h-full w-full object-contain"
                                 onerror="this.onerror=null;this.src='/images/Default/default-product.png';" />
                        </div>

                                <div class="min-w-0">
                                    <p class="font-semibold text-gray-900">
                                        @request.FirstProductName
                                    </p>

                            @if (request.TotalItems > 1)
                                    {
                                        <p class="mt-1 text-sm text-gray-500">
                                            Và @(request.TotalItems - 1) sản phẩm khác
                                        </p>
                                    }

                                    <p class="mt-2 text-sm text-gray-500">
                                        Mã đơn hàng:
                                        <a href="/order/details/@Uri.EscapeDataString(request.OrderCode)"
                                           class="font-semibold text-[#249e63] hover:underline">
                                            @request.OrderCode
                                        </a>
                                    </p>

                                    <p class="mt-1 text-sm text-gray-500">
                                        Lý do: @request.ReasonLabel
                                    </p>
                                </div>
                            </div>

                            <div class="flex flex-col gap-3 lg:items-end">
                                @if (request.RequestType == "Refund")
                                {
                                    <div class="text-left lg:text-right">
                                        <p class="text-xs text-gray-500">Giá trị sản phẩm yêu cầu hoàn</p>
                                        <p class="mt-1 text-lg font-bold text-gray-900">
                                            @request.TotalReturnAmount.ToString("N0") đ
                                        </p>
                                    </div>
                                }

                                <a href="/order/return-request/@Uri.EscapeDataString(request.RequestCode)"
                                   class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#249e63] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#18834f]">
                                    Xem chi tiết
                                    <i class="ph ph-arrow-right"></i>
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty state -->
            <div class="rounded-xl border border-gray-100 bg-white px-5 py-16 text-center shadow-sm">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-green-50 text-[#249e63]">
                    <i class="ph ph-package text-4xl"></i>
                </div>

                <h3 class="mt-5 text-lg font-bold text-gray-900">
                    Chưa có yêu cầu đổi trả nào
                </h3>

                <p class="mx-auto mt-2 max-w-md text-sm text-gray-500">
                    @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                    {
                        <text>Không tìm thấy yêu cầu nào phù hợp với trạng thái đã chọn.</text>
                    }
                    else
                    {
                        <text>Các yêu cầu đổi sản phẩm hoặc hoàn tiền của bạn sẽ được hiển thị tại đây.</text>
                    }
                </p>

                <a href="/order"
                   class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-[#249e63] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#18834f]">
                    Xem đơn hàng
                    <i class="ph ph-arrow-right"></i>
                </a>
            </div>
        }

    </div>
</section>
