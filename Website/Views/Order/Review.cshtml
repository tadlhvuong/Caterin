@model Website.Models.Order.ProductReviewViewModel

@{
    ViewData["Title"] = "Đánh giá sản phẩm";
}

<div class="bg-gray-50 py-10 lg:py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

        @* Breadcrumb *@
        <div class="mb-6 flex flex-wrap items-center gap-2 text-sm text-gray-500">
            <a asp-controller="Home"
               asp-action="Index"
               class="transition hover:text-[#1F9345]">
                Trang chủ
            </a>

            <i class="ph ph-caret-right text-xs"></i>

            <a asp-controller="Order"
               asp-action="Index"
               class="transition hover:text-[#1F9345]">
                Đơn hàng của tôi
            </a>

            <i class="ph ph-caret-right text-xs"></i>

            <span class="font-medium text-gray-800">
                Đánh giá sản phẩm
            </span>
        </div>

        @* Header *@
        <div class="mb-8">
            <div class="mb-3 inline-flex size-12 items-center justify-center rounded-2xl bg-green-100 text-[#1F9345]">
                <i class="ph ph-star text-2xl"></i>
            </div>

            <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">
                Đánh giá sản phẩm
            </h1>

            <p class="mt-2 text-sm leading-6 text-gray-500">
                Chia sẻ trải nghiệm của bạn để Caterin phục vụ tốt hơn.
            </p>

            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
                <span class="text-gray-500">
                    Mã đơn hàng:
                    <strong class="text-gray-800">@Model.OrderCode</strong>
                </span>

                <span class="text-gray-500">
                    Ngày đặt:
                    <strong class="text-gray-800">
                        @Model.OrderCreatedAt.ToString("dd/MM/yyyy")
                    </strong>
                </span>
            </div>
        </div>

        @* Validation *@
        <div asp-validation-summary="ModelOnly"
             class="mb-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-600">
        </div>

        <form id="productReviewForm"
              asp-controller="Order"
              asp-action="SubmitReview"
              asp-route-orderCode="@Model.OrderCode"
              method="post">

            @Html.AntiForgeryToken()
            <input type="hidden" name="OrderCode" value="@Model.OrderCode" />
            <div class="space-y-5">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];

                    <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">

                        <div class="flex flex-col gap-5 p-5 sm:flex-row sm:p-6">

                            @* Product *@
                            <div class="flex min-w-0 flex-1 gap-4">
                                <div class="size-24 shrink-0 overflow-hidden rounded-xl bg-gray-50">
                                    <img src="@item.ImageUrl"
                                         alt="@item.ProductName"
                                         class="size-full object-contain"
                                         onerror="this.src='/images/Default/default-product.png'" />
                                </div>

                                <div class="min-w-0 flex-1">
                                    <h2 class="font-semibold leading-6 text-gray-900">
                                        @item.ProductName
                                    </h2>

                                    @if (!string.IsNullOrWhiteSpace(item.VariantName))
                                    {
                                        <p class="mt-1 text-sm text-gray-500">
                                            @item.VariantName
                                        </p>
                                    }

                                    <p class="mt-2 text-sm text-gray-500">
                                        Số lượng:
                                        <span class="font-semibold text-gray-700">
                                            @item.PurchasedQuantity
                                        </span>
                                    </p>

                                    @if (item.IsReviewed)
                                    {
                                        <span class="mt-3 inline-flex items-center gap-1 rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-[#1F9345]">
                                            <i class="ph ph-check-circle"></i>
                                            Đã đánh giá
                                        </span>
                                    }
                                </div>
                            </div>

                            @* Review *@
                            <div class="w-full border-t border-gray-100 pt-5 sm:w-[55%] sm:border-l sm:border-t-0 sm:pl-6 sm:pt-0">

                                @if (item.IsReviewed)
                                {
                                    <p class="text-sm font-semibold text-gray-700">
                                        Đánh giá của bạn
                                    </p>

                                    <div class="mt-2 flex gap-1 text-xl text-amber-400">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <i class="ph @(star <= item.Rating ? "ph-star-fill" : "ph-star")"></i>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Comment))
                                    {
                                        <p class="mt-3 text-sm leading-6 text-gray-600">
                                            @item.Comment
                                        </p>
                                    }
                                }
                                else
                                {
                                    <input type="hidden"
                                            name="Items.Index"
                                            value="@i" />
                                    <input type="hidden"
                                           name="Items[@i].ItemIndex"
                                           value="@item.ItemIndex" />

                                    <p class="text-sm font-semibold text-gray-800">
                                        Chất lượng sản phẩm thế nào?
                                    </p>

                                    <div class="mt-3 flex flex-row-reverse justify-end gap-2">
                                        @for (var star = 5; star >= 1; star--)
                                        {
                                            <input type="radio"
                                                   id="rating_@(i)_@star"
                                                   name="Items[@i].Rating"
                                                   value="@star"
                                                   class="peer sr-only"
                                                   checked="@(item.Rating == star)"
                                                   required />

                                            <label for="rating_@(i)_@star"
                                                   class="cursor-pointer text-2xl text-gray-300 transition hover:text-amber-400 peer-checked:text-amber-400"
                                                   title="@star sao">
                                                <i class="ph ph-star-fill"></i>
                                            </label>
                                        }
                                    </div>

                                    <label for="comment_@i"
                                           class="mt-5 block text-sm font-semibold text-gray-800">
                                        Nhận xét của bạn
                                        <span class="font-normal text-gray-400">
                                            (Không bắt buộc)
                                        </span>
                                    </label>

                                    <textarea id="comment_@i"
                                      name="Items[@i].Comment"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Chia sẻ cảm nhận về sản phẩm..."
                                      class="mt-2 w-full rounded-xl border border-gray-200 px-4 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-[#1F9345] focus:ring-2 focus:ring-green-100">@item.Comment</textarea>

                                    <p class="mt-1 text-right text-xs text-gray-400">
                                        Tối đa 1.000 ký tự
                                    </p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Actions *@
            <div class="mt-8 flex flex-col-reverse justify-between gap-3 sm:flex-row">
                <a asp-controller="Order"
                   asp-action="Details"
                   asp-route-orderCode="@Model.OrderCode"
                   class="inline-flex items-center justify-center gap-2 rounded-full border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-600 transition hover:border-gray-300 hover:bg-gray-50">
                    <i class="ph ph-arrow-left"></i>
                    Quay lại đơn hàng
                </a>

                @if (Model.Items.Any(x => !x.IsReviewed))
                {
                    <button type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-full bg-[#1F9345] px-7 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#187a39]">
                        <i class="ph ph-paper-plane-tilt text-lg"></i>
                        Gửi đánh giá
                    </button>
                }
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script src="~/js/order/product-review.js"
            asp-append-version="true"></script>
}