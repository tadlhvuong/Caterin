@using Website.Models.Order
@model OrderDetailsViewModel

@{



    ViewData["Title"] = "Đặt hàng thành công | Caterin";

    var isCod = string.Equals(Model.PaymentMethod, "COD", StringComparison.OrdinalIgnoreCase);
    var paymentIsPaid = string.Equals(Model.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
}

<div class="min-h-screen bg-[#f8faf8] text-slate-700">

    <section class="border-b border-gray-100 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <nav class="flex items-center gap-2 text-sm">
                <a href="/" class="text-gray-500 hover:text-[#1F9345]">Trang chủ</a>
                <i class="ph ph-caret-right text-xs text-gray-400"></i>
                <span class="font-medium text-[#1F9345]">Đặt hàng thành công</span>
            </nav>
        </div>
    </section>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">

        <section class="relative mx-auto max-w-4xl overflow-hidden rounded-3xl border border-[#dcefd8] bg-gradient-to-br from-[#f0f9ed] via-white to-[#e9f7ed] px-5 py-10 text-center sm:px-10 sm:py-14">
            <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[#8CC63F]/10 blur-3xl"></div>
            <div class="pointer-events-none absolute -bottom-24 -left-20 h-64 w-64 rounded-full bg-[#1F9345]/10 blur-3xl"></div>

            <div class="relative">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#1F9345] text-white shadow-lg shadow-[#1F9345]/20 ring-8 ring-white">
                    <i class="ph-bold ph-check text-4xl"></i>
                </div>

                <span class="mt-7 inline-flex items-center gap-2 rounded-full border border-[#8CC63F]/30 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wider text-[#1F9345]">
                    <i class="ph-fill ph-check-circle"></i>
                    Order Confirmed
                </span>

                <h1 class="mt-5 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
                    Cảm ơn bạn đã đặt hàng!
                </h1>

                <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-gray-600 sm:text-base">
                    Caterin đã tiếp nhận đơn hàng của bạn.
                    Chúng tôi sẽ chuẩn bị sản phẩm và cập nhật hành trình giao hàng trong thời gian sớm nhất.
                </p>

                <div class="mx-auto mt-7 inline-flex flex-col items-center rounded-2xl border border-[#dcefd8] bg-white px-8 py-4 shadow-sm">
                    <span class="text-xs font-medium uppercase tracking-wider text-gray-500">
                        Mã đơn hàng
                    </span>
                    <span class="mt-2 text-xl font-bold tracking-wide text-[#1F9345] sm:text-2xl">
                        @Model.OrderCode
                    </span>
                    <span class="mt-2 text-xs text-gray-400">
                        @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                @if (!isCod && !paymentIsPaid)
                {
                    <div class="mx-auto mt-5 max-w-xl rounded-xl border border-amber-200 bg-amber-50 p-4 text-left">
                        <p class="flex items-center gap-2 text-sm font-semibold text-amber-800">
                            <i class="ph ph-clock text-lg"></i>
                            Đang chờ xác nhận thanh toán
                        </p>
                        <p class="mt-1 text-xs leading-5 text-amber-700">
                            Đơn hàng đã được tạo. Giao dịch thanh toán của bạn chưa được xác nhận hoàn tất.
                        </p>
                    </div>
                }
            </div>
        </section>

        <section class="mx-auto mt-6 max-w-4xl">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <a asp-controller="Order"
                   asp-action="Track"
                   asp-route-orderCode="@Model.OrderCode"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[#1F9345]/20 transition hover:bg-[#187b39]">
                    <i class="ph ph-truck text-xl"></i>
                    Theo dõi đơn hàng
                    <i class="ph ph-arrow-right"></i>
                </a>

                <a href="/shop"
                   class="inline-flex items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-6 py-3.5 text-sm font-semibold text-gray-700 transition hover:border-[#1F9345] hover:text-[#1F9345]">
                    <i class="ph ph-shopping-bag text-xl"></i>
                    Tiếp tục mua sắm
                </a>
            </div>
        </section>

        <section class="mx-auto mt-8 max-w-4xl">
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-5">

                <div class="space-y-6 lg:col-span-3">
                    @await Html.PartialAsync("Partials/_OrderItems", Model)
                    @await Html.PartialAsync("Partials/_OrderShippingInfo", Model)
                </div>

                <aside class="space-y-6 lg:col-span-2">
                    @await Html.PartialAsync("Partials/_OrderSummary", Model)
                    @await Html.PartialAsync("Partials/_OrderPaymentInfo", Model)

                    <div class="rounded-2xl border border-[#dcefd8] bg-gradient-to-br from-[#f2faef] to-white p-5">
                        <div class="flex items-center gap-3">
                            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white text-[#1F9345] shadow-sm">
                                <i class="ph-fill ph-heart text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900">Caterin cảm ơn bạn!</h3>
                                <p class="mt-1 text-xs text-gray-500">An toàn cho mọi nhà</p>
                            </div>
                        </div>
                        <p class="mt-4 text-sm leading-6 text-gray-600">
                            Cảm ơn bạn đã tin tưởng lựa chọn sản phẩm chăm sóc gia đình Caterin.
                        </p>
                    </div>
                </aside>
            </div>
        </section>
    </main>
</div>
