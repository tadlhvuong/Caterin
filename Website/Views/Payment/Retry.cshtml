@model Website.Models.Payment.RetryPaymentViewModel

@{
    ViewData["Title"] = "Thanh toán lại";
}

<section class="min-h-screen bg-gray-50 py-10">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">

        <div class="mb-8">
            <a asp-controller="Order"
               asp-action="Details"
               asp-route-orderCode="@Model.OrderCode"
               class="inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition hover:text-[#1F9345]">
                <i class="ph ph-arrow-left"></i>
                Quay lại đơn hàng
            </a>

            <h1 class="mt-5 text-2xl font-bold text-gray-900">
                Thanh toán đơn hàng
            </h1>

            <p class="mt-2 text-sm text-gray-500">
                Hoàn tất thanh toán để đơn hàng được tiếp tục xử lý.
            </p>
        </div>

        <div class="space-y-6">

            @* ORDER SUMMARY *@
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="text-sm text-gray-500">
                            Mã đơn hàng
                        </p>
                        <p class="mt-1 font-semibold text-gray-900">
                            @Model.OrderCode
                        </p>
                    </div>

                    <span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
                        @Model.PaymentStatusLabel
                    </span>
                </div>

                <div class="my-5 border-t border-dashed border-gray-200"></div>

                <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500">Ngày đặt hàng</span>
                    <span class="font-medium text-gray-800">
                        @Model.OrderCreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                <div class="mt-3 flex items-center justify-between text-sm">
                    <span class="text-gray-500">Phương thức hiện tại</span>
                    <span class="font-medium text-gray-800">
                        @Model.PaymentMethodLabel
                    </span>
                </div>

                <div class="my-5 border-t border-gray-100"></div>

                <div class="flex items-center justify-between">
                    <span class="font-semibold text-gray-900">
                        Tổng thanh toán
                    </span>
                    <span class="text-2xl font-bold text-[#1F9345]">
                        @Model.TotalAmount.ToString("N0")đ
                    </span>
                </div>
            </div>

            @* PAYMENT METHOD *@
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
                <h2 class="text-lg font-bold text-gray-900">
                    Phương thức thanh toán
                </h2>

                <p class="mt-1 text-sm text-gray-500">
                    Chọn phương thức để tiếp tục thanh toán.
                </p>

                <form id="retryPaymentForm"
                      asp-controller="Payment"
                      asp-action="Retry"
                      asp-route-orderCode="@Model.OrderCode"
                      method="post"
                      class="mt-6">

                    @Html.AntiForgeryToken()

                    <div class="space-y-3">
                        @foreach (var method in Model.PaymentMethods)
                        {
                            <label class="flex cursor-pointer items-center gap-4 rounded-xl border border-gray-200 p-4 transition hover:border-[#8CC63F] has-[:checked]:border-[#1F9345] has-[:checked]:bg-green-50/50">

                                <input type="radio"
                                       name="SelectedPaymentMethod"
                                       value="@method.Code"
                                       checked="@(Model.SelectedPaymentMethod == method.Code)"
                                       required
                                       class="h-4 w-4 accent-[#1F9345]" />

                                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-green-50 text-2xl text-[#1F9345]">
                                    <i class="@method.Icon"></i>
                                </span>

                                <span class="min-w-0 flex-1">
                                    <span class="block font-semibold text-gray-900">
                                        @method.Name
                                    </span>
                                    <span class="mt-1 block text-sm text-gray-500">
                                        @method.Description
                                    </span>
                                </span>
                            </label>
                        }
                    </div>

                    <button type="submit"
                            class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-5 py-3.5 font-semibold text-white transition hover:bg-[#187a39] disabled:cursor-not-allowed disabled:opacity-60">
                        <i class="ph ph-lock-key text-lg"></i>
                        Tiếp tục thanh toán
                    </button>

                    <p class="mt-4 text-center text-xs text-gray-400">
                        Thông tin thanh toán được xử lý an toàn.
                    </p>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/payment/retry-payment.js"
            asp-append-version="true"></script>
}
