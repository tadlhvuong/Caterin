@{
    ViewData["Title"] = "Thông tin tài khoản";

    var tab = ViewBag.Tab as string ?? "personal";

    var url = tab switch
    {
        "orders" => "orders",
        "addresses" => "addresses",
        "password" => "change-password",
        "connections" => "connections",
        _ => "personal-info"
    };
}

@section Styles {
    <style>
        .account-menu {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 24px;
            color: #555;
            transition: .25s;
        }

            .account-menu:hover {
                background: #F7F8FA;
                color: var(--main-600);
            }

            .account-menu.active {
                background: #EEF9F0;
                color: var(--main-600);
                font-weight: 600;
                border-left: 3px solid var(--main-600);
            }

            .account-menu i {
                font-size: 20px;
                width: 22px;
            }

        #profile-content[aria-busy="true"] {
            opacity: .6;
            pointer-events: none;
            transition: opacity .15s;
        }
    </style>
}

<section class="account py-80">
    <div class="container container-lg">
        <div class="row g-4">
            <partial name="_ProfileSidebar" />

            <div id="profile-content"
                 data-initial-tab="@tab"
                 data-initial-url="/profile/@url"
                 class="2xl:w-9/12 xl:w-8/12 flex-grow-0 flex-shrink-0 basis-auto">
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/profile/profile-tabs.js" asp-append-version="true"></script>

    <script>
        document.querySelector('#logout-form')?.addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = this;

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    credentials: 'same-origin',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    throw new Error('Không thể đăng xuất. Vui lòng thử lại.');
                }

                const result = await response.json();

                if (result.success) {
                    window.dispatchEvent(new CustomEvent('caterin:customer-logout'));
                    window.location.href = result.returnUrl;
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Thông báo',
                    text: error.message || 'Đã xảy ra lỗi khi đăng xuất.',
                    confirmButtonText: 'Đóng'
                });
            }
        });

        @if (TempData["Success"] != null)
        {
                <text>
                    document.addEventListener('DOMContentLoaded', function () {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"])),
                            confirmButtonText: 'Đóng'
                        });
                    });
                </text>
        }

        @if (TempData["Error"] != null)
        {
                <text>
                    document.addEventListener('DOMContentLoaded', function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thông báo',
                            text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"])),
                            confirmButtonText: 'Đóng'
                        });
                    });
                </text>
        }
    </script>
}