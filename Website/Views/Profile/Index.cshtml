@{
    ViewData["Title"] = "Thông tin tài khoản";

    var tab = ViewBag.Tab as string ?? "personal";

    var url = tab switch
    {
        "orders" => "orders",
        "addresses" => "addresses",
        "password" => "change-password",
        "connections" => "connections",
        _ => "personal-info"
    };
}

<section class="py-8 sm:py-10 lg:py-14 xl:py-16">
    <div class="mx-auto w-full max-w-[1440px] px-4 sm:px-5 lg:px-6">
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:gap-6 xl:gap-8">

            <partial name="_ProfileSidebar" />

            <div id="profile-content"
                 data-initial-tab="@tab"
                 data-initial-url="/profile/@url"
                 aria-live="polite"
                 class="min-w-0 lg:col-span-8 2xl:col-span-9">
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/profile/profile-tabs.js" asp-append-version="true"></script>
    <script src="~/js/profile/profile-page.js" asp-append-version="true"></script>
    <script>
        // Success message.
        @if (TempData["Success"] != null)
        {
                <text>
                    document.addEventListener('DOMContentLoaded', function () {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"])),
                            confirmButtonText: 'Đóng'
                        });
                    });
                </text>
        }

        // Error message.
        @if (TempData["Error"] != null)
        {
                <text>
                    document.addEventListener('DOMContentLoaded', function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Thông báo',
                            text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"])),
                            confirmButtonText: 'Đóng'
                        });
                    });
                </text>
        }
    </script>
}
