@{
    ViewData["Title"] = "Thanh toán đối tác";
}

<div class="min-h-screen bg-slate-50/70 py-8 sm:py-10">
    <div class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">

        <!-- Page heading -->
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
                <div class="mb-2 flex items-center gap-2 text-sm font-medium text-[#1F9345]">
                    <i class="ph ph-wallet text-lg"></i>
                    Đối tác Caterin
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                    Thanh toán & hoa hồng
                </h1>
                <p class="mt-2 text-sm text-slate-500 sm:text-base">
                    Theo dõi số dư, quản lý yêu cầu và lịch sử thanh toán của bạn.
                </p>
            </div>

            <span class="inline-flex w-fit items-center gap-2 rounded-full border border-emerald-100 bg-emerald-50 px-3.5 py-2 text-xs font-semibold text-[#1F9345]">
                <span class="size-2 rounded-full bg-[#249e63]"></span>
                Tài khoản đang hoạt động
            </span>
        </div>

        <!-- Balance hero -->
        <section class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-br from-[#16783B] via-[#1F9345] to-[#8CC63F] shadow-xl shadow-emerald-900/10">
            <div class="pointer-events-none absolute -right-20 -top-32 size-96 rounded-full border-[50px] border-white/5"></div>
            <div class="pointer-events-none absolute -bottom-40 right-1/3 size-80 rounded-full bg-white/5 blur-3xl"></div>

            <div class="relative grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-center lg:p-10">
                <div>
                    <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-semibold tracking-wide text-white backdrop-blur">
                        <i class="ph-fill ph-seal-check text-base"></i>
                        PARTNER PAYMENT
                    </span>

                    <p class="mt-7 text-sm font-medium text-white/75">
                        Số dư có thể yêu cầu thanh toán
                    </p>

                    <div class="mt-2 flex flex-wrap items-baseline gap-2">
                        <h2 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
                            5.280.000đ
                        </h2>
                        <span class="text-sm font-medium text-white/70">VND</span>
                    </div>

                    <p class="mt-3 max-w-lg text-sm leading-6 text-white/75">
                        Số dư khả dụng từ hoa hồng đã được xác nhận. Bạn có thể gửi yêu cầu thanh toán theo chu kỳ.
                    </p>

                    <a href="#withdrawal-request"
                       class="mt-7 inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-bold text-[#1F9345] shadow-lg shadow-black/10 transition hover:-translate-y-0.5 hover:bg-emerald-50 focus:outline-none focus:ring-4 focus:ring-white/30">
                        <i class="ph-fill ph-wallet text-xl"></i>
                        Yêu cầu thanh toán
                        <i class="ph ph-arrow-up-right text-base"></i>
                    </a>
                </div>

                <div class="rounded-2xl border border-white/20 bg-white/10 p-5 text-white shadow-lg backdrop-blur-md sm:p-6">
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-sm text-white/75">Thông tin thanh toán</span>
                        <i class="ph ph-calendar-check text-2xl text-white/80"></i>
                    </div>

                    <div class="mt-5 space-y-4">
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-sm text-white/70">Thanh toán tiếp theo</span>
                            <strong class="text-sm font-semibold">01/08/2026</strong>
                        </div>
                        <div class="h-px bg-white/15"></div>
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-sm text-white/70">Chu kỳ</span>
                            <strong class="text-sm font-semibold">Hàng tháng</strong>
                        </div>
                        <div class="h-px bg-white/15"></div>
                        <div class="flex items-center justify-between gap-3">
                            <span class="text-sm text-white/70">Trạng thái</span>
                            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-300/20 px-3 py-1 text-xs font-semibold text-white">
                                <span class="size-1.5 rounded-full bg-emerald-300"></span>
                                Active
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Summary cards -->
        <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-center justify-between">
                    <div class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                        <i class="ph-fill ph-wallet text-2xl"></i>
                    </div>
                    <span class="text-xs font-medium text-emerald-600">Khả dụng</span>
                </div>
                <p class="mt-5 text-sm font-medium text-slate-500">Có thể rút</p>
                <h3 class="mt-1 text-2xl font-bold tracking-tight text-slate-900">5.280.000đ</h3>
            </div>

            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-center justify-between">
                    <div class="flex size-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                        <i class="ph-fill ph-clock-countdown text-2xl"></i>
                    </div>
                    <span class="text-xs font-medium text-amber-600">Chờ xử lý</span>
                </div>
                <p class="mt-5 text-sm font-medium text-slate-500">Đang xử lý</p>
                <h3 class="mt-1 text-2xl font-bold tracking-tight text-slate-900">1.200.000đ</h3>
            </div>

            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-center justify-between">
                    <div class="flex size-11 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                        <i class="ph-fill ph-check-circle text-2xl"></i>
                    </div>
                    <span class="text-xs font-medium text-sky-600">Thành công</span>
                </div>
                <p class="mt-5 text-sm font-medium text-slate-500">Đã thanh toán</p>
                <h3 class="mt-1 text-2xl font-bold tracking-tight text-slate-900">18.600.000đ</h3>
            </div>

            <div class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                <div class="flex items-center justify-between">
                    <div class="flex size-11 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                        <i class="ph-fill ph-receipt text-2xl"></i>
                    </div>
                    <span class="text-xs font-medium text-violet-600">Tất cả</span>
                </div>
                <p class="mt-5 text-sm font-medium text-slate-500">Tổng lượt thanh toán</p>
                <h3 class="mt-1 text-2xl font-bold tracking-tight text-slate-900">15</h3>
            </div>
        </section>

        <!-- Bank account -->
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
            <div class="flex flex-col gap-4 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
                <div class="flex items-center gap-3">
                    <div class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                        <i class="ph-fill ph-bank text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-900">Tài khoản nhận tiền</h3>
                        <p class="mt-0.5 text-xs text-slate-500">Thông tin ngân hàng dùng để nhận thanh toán</p>
                    </div>
                </div>

                <button type="button"
                        class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-[#1F9345] hover:bg-emerald-50 hover:text-[#1F9345]">
                    <i class="ph ph-pencil-simple text-base"></i>
                    Đổi tài khoản
                </button>
            </div>

            <div class="grid gap-5 p-5 sm:grid-cols-2 sm:p-7">
                <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Ngân hàng</p>
                    <div class="mt-2 flex items-center gap-3">
                        <div class="flex size-10 items-center justify-center rounded-lg bg-emerald-50 text-[#1F9345]">
                            <i class="ph-fill ph-bank text-xl"></i>
                        </div>
                        <p class="font-semibold text-slate-800">Vietcombank</p>
                    </div>
                </div>

                <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Chủ tài khoản</p>
                    <p class="mt-3 font-semibold text-slate-800">NGUYEN VAN A</p>
                </div>

                <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Số tài khoản</p>
                    <p class="mt-3 font-semibold tracking-wider text-slate-800">**** **** 9876</p>
                </div>

                <div>
                    <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Chi nhánh</p>
                    <p class="mt-3 font-semibold text-slate-800">TP.HCM</p>
                </div>
            </div>
        </section>

        <!-- Withdrawal request -->
        <section id="withdrawal-request" class="scroll-mt-24 overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
            <div class="border-b border-slate-100 px-5 py-5 sm:px-7">
                <div class="flex items-center gap-3">
                    <div class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                        <i class="ph-fill ph-money text-2xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-900">Yêu cầu thanh toán</h3>
                        <p class="mt-0.5 text-xs text-slate-500">Điền thông tin để gửi yêu cầu rút tiền</p>
                    </div>
                </div>
            </div>

            <div class="space-y-5 p-5 sm:p-7">
                <div class="grid gap-5 md:grid-cols-2">
                    <div>
                        <label for="withdrawAmount" class="mb-2 block text-sm font-semibold text-slate-700">
                            Số tiền yêu cầu <span class="text-rose-500">*</span>
                        </label>
                        <div class="relative">
                            <input id="withdrawAmount"
                                   name="amount"
                                   type="number"
                                   min="1"
                                   placeholder="Nhập số tiền"
                                   class="h-12 w-full rounded-xl border border-slate-200 bg-white px-4 pr-14 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10" />
                            <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-sm font-semibold text-slate-400">VND</span>
                        </div>
                        <p class="mt-2 text-xs text-slate-400">Số dư khả dụng: 5.280.000đ</p>
                    </div>

                    <div>
                        <label for="withdrawMethod" class="mb-2 block text-sm font-semibold text-slate-700">
                            Phương thức thanh toán
                        </label>
                        <div class="relative">
                            <select id="withdrawMethod"
                                    name="method"
                                    class="h-12 w-full appearance-none rounded-xl border border-slate-200 bg-white px-4 pr-10 text-sm text-slate-800 outline-none transition hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10">
                                <option value="bank">Chuyển khoản ngân hàng</option>
                            </select>
                            <i class="ph ph-caret-down pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        </div>
                    </div>
                </div>

                <div>
                    <label for="withdrawNote" class="mb-2 block text-sm font-semibold text-slate-700">Ghi chú</label>
                    <textarea id="withdrawNote"
                              name="note"
                              rows="4"
                              placeholder="Nhập ghi chú nếu có..."
                              class="w-full resize-y rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-[#249e63] focus:ring-4 focus:ring-emerald-500/10"></textarea>
                </div>

                <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
                    <p class="flex items-start gap-2 text-xs leading-5 text-slate-400">
                        <i class="ph ph-info mt-0.5 shrink-0 text-base"></i>
                        Yêu cầu sẽ được kiểm tra trước khi thực hiện thanh toán.
                    </p>
                    <button type="button"
                            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-700/15 transition hover:-translate-y-0.5 hover:bg-[#16783B] hover:shadow-xl focus:outline-none focus:ring-4 focus:ring-emerald-500/20">
                        <i class="ph-fill ph-paper-plane-tilt text-lg"></i>
                        Gửi yêu cầu
                    </button>
                </div>
            </div>
        </section>

        <!-- Payment history -->
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
            <div class="flex flex-col gap-3 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7">
                <div>
                    <h3 class="font-bold text-slate-900">Lịch sử thanh toán</h3>
                    <p class="mt-1 text-xs text-slate-500">Theo dõi các giao dịch thanh toán trước đây</p>
                </div>
                <button type="button" class="inline-flex items-center gap-2 self-start rounded-lg px-3 py-2 text-sm font-semibold text-[#1F9345] transition hover:bg-emerald-50">
                    <i class="ph ph-download-simple text-base"></i>
                    Xuất báo cáo
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[720px] text-left text-sm">
                    <thead class="bg-slate-50/80 text-xs uppercase tracking-wide text-slate-500">
                        <tr>
                            <th class="px-6 py-4 font-semibold">Mã giao dịch</th>
                            <th class="px-6 py-4 font-semibold">Ngày thanh toán</th>
                            <th class="px-6 py-4 font-semibold">Số tiền</th>
                            <th class="px-6 py-4 font-semibold">Ngân hàng</th>
                            <th class="px-6 py-4 font-semibold">Trạng thái</th>
                            <th class="px-6 py-4 text-right font-semibold">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="transition hover:bg-slate-50/70">
                            <td class="whitespace-nowrap px-6 py-4 font-semibold text-slate-800">WD0001</td>
                            <td class="whitespace-nowrap px-6 py-4 text-slate-500">01/07/2026</td>
                            <td class="whitespace-nowrap px-6 py-4 font-bold text-slate-900">3.500.000đ</td>
                            <td class="whitespace-nowrap px-6 py-4 text-slate-600">Vietcombank</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-700">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    Hoàn thành
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-6 py-4 text-right">
                                <a href="#" class="inline-flex items-center gap-1 rounded-lg px-3 py-2 text-xs font-semibold text-[#1F9345] transition hover:bg-emerald-50">
                                    Chi tiết <i class="ph ph-arrow-up-right"></i>
                                </a>
                            </td>
                        </tr>

                        <tr class="transition hover:bg-slate-50/70">
                            <td class="whitespace-nowrap px-6 py-4 font-semibold text-slate-800">WD0002</td>
                            <td class="whitespace-nowrap px-6 py-4 text-slate-500">01/08/2026</td>
                            <td class="whitespace-nowrap px-6 py-4 font-bold text-slate-900">2.500.000đ</td>
                            <td class="whitespace-nowrap px-6 py-4 text-slate-600">Vietinbank</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    Đang xử lý
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-6 py-4 text-right">
                                <a href="#" class="inline-flex items-center gap-1 rounded-lg px-3 py-2 text-xs font-semibold text-[#1F9345] transition hover:bg-emerald-50">
                                    Chi tiết <i class="ph ph-arrow-up-right"></i>
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="flex flex-col gap-2 border-t border-slate-100 px-5 py-4 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-7">
                <span>Hiển thị 2 giao dịch mẫu</span>
                <span>Dữ liệu thanh toán được cập nhật theo hệ thống</span>
            </div>
        </section>

        <!-- Payment schedule -->
        <section class="rounded-2xl border border-slate-200/80 bg-white p-5 shadow-sm sm:p-7">
            <div class="flex items-center gap-3">
                <div class="flex size-11 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                    <i class="ph-fill ph-calendar-check text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900">Lịch thanh toán</h3>
                    <p class="mt-1 text-xs text-slate-500">Quy trình thanh toán định kỳ của đối tác</p>
                </div>
            </div>

            <div class="mt-7 grid gap-6 sm:grid-cols-2">
                <div class="flex gap-4">
                    <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-[#1F9345]">
                        <i class="ph-fill ph-calendar-check text-xl"></i>
                    </div>
                    <div>
                        <h4 class="font-semibold text-slate-800">Ngày 01 hàng tháng</h4>
                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Hệ thống tự động thanh toán tất cả yêu cầu đã duyệt.
                        </p>
                    </div>
                </div>

                <div class="flex gap-4">
                    <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-sky-50 text-sky-600">
                        <i class="ph-fill ph-bank text-xl"></i>
                    </div>
                    <div>
                        <h4 class="font-semibold text-slate-800">1–3 ngày làm việc</h4>
                        <p class="mt-1 text-sm leading-6 text-slate-500">
                            Tiền sẽ được chuyển vào tài khoản ngân hàng đã đăng ký.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Payment progress -->
        <section class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
            <div class="flex flex-col gap-4 border-b border-slate-100 p-5 sm:flex-row sm:items-start sm:justify-between sm:p-7">
                <div>
                    <span class="text-xs font-bold tracking-[0.15em] text-[#1F9345]">PAYMENT PROGRESS</span>
                    <h3 class="mt-2 text-xl font-bold tracking-tight text-slate-900">
                        Tiến trình thanh toán tháng 07/2026
                    </h3>
                    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                        Hệ thống đang đối soát các đơn hàng để chuẩn bị thanh toán hoa hồng.
                    </p>
                </div>
                <span class="inline-flex w-fit items-center gap-2 rounded-full bg-amber-50 px-3.5 py-2 text-xs font-semibold text-amber-700">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Đang xử lý
                </span>
            </div>

            <div class="grid gap-8 p-5 sm:p-7 lg:grid-cols-[1fr_320px]">
                <!-- Progress information -->
                <div>
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-sm font-semibold text-slate-700">Tiến độ xác minh</span>
                        <span class="text-sm font-bold text-[#1F9345]">75%</span>
                    </div>

                    <div class="mt-3 h-3 overflow-hidden rounded-full bg-slate-100">
                        <div class="h-full w-3/4 rounded-full bg-gradient-to-r from-[#1F9345] to-[#8CC63F]"></div>
                    </div>

                    <div class="mt-7 grid grid-cols-1 gap-3 sm:grid-cols-3">
                        <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-4">
                            <div class="flex items-center gap-2 text-slate-400">
                                <i class="ph-fill ph-package text-xl"></i>
                                <span class="text-xs font-medium">Đơn hàng phát sinh</span>
                            </div>
                            <p class="mt-3 text-2xl font-bold text-slate-900">62</p>
                        </div>

                        <div class="rounded-xl border border-emerald-100 bg-emerald-50/50 p-4">
                            <div class="flex items-center gap-2 text-emerald-600">
                                <i class="ph-fill ph-check-circle text-xl"></i>
                                <span class="text-xs font-medium">Đã xác minh</span>
                            </div>
                            <p class="mt-3 text-2xl font-bold text-slate-900">48</p>
                        </div>

                        <div class="rounded-xl border border-amber-100 bg-amber-50/50 p-4">
                            <div class="flex items-center gap-2 text-amber-600">
                                <i class="ph-fill ph-clock-countdown text-xl"></i>
                                <span class="text-xs font-medium">Đang chờ</span>
                            </div>
                            <p class="mt-3 text-2xl font-bold text-slate-900">14</p>
                        </div>
                    </div>
                </div>

                <!-- Estimated payment -->
                <aside class="rounded-2xl border border-emerald-100 bg-gradient-to-br from-[#F4FBF3] to-white p-5 sm:p-6">
                    <div class="text-center">
