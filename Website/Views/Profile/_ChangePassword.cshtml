@using Shared.DTOs.Profile
@model ProfilePasswordViewModel

<style>
    .profile-password {
        max-width: 620px;
    }

        .profile-password .password-header {
            margin-bottom: 28px;
        }

            .profile-password .password-header h4 {
                font-size: 22px;
                font-weight: 600;
                color: #222;
                margin-bottom: 8px;
            }

            .profile-password .password-header p {
                color: #777;
                line-height: 1.7;
                font-size: 14px;
            }

        .profile-password .password-field {
            margin-bottom: 22px;
        }

        .profile-password .form-label {
            display: block;
            font-weight: 500;
            font-size: 14px;
            color: #333;
            margin-bottom: 9px;
        }

        .profile-password .form-control {
            width: 100%;
            min-height: 48px;
            padding: 12px 15px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #333;
            font-size: 14px;
            transition: border-color .2s, box-shadow .2s;
        }

            .profile-password .form-control:focus {
                border-color: #1f9345;
                outline: none;
                box-shadow: 0 0 0 3px rgba(31, 147, 69, .10);
            }

            .profile-password .form-control::placeholder {
                color: #aaa;
            }

        .profile-password .text-danger {
            display: block;
            font-size: 12px;
            margin-top: 6px;
        }

        .profile-password .validation-summary-errors {
            padding: 12px 16px;
            margin-bottom: 20px;
            border-radius: 8px;
            background: #fff4f4;
            border: 1px solid #f5d0d0;
            color: #c62828;
            font-size: 13px;
        }

        .profile-password .password-requirements {
            padding: 16px 18px;
            background: #f7faf7;
            border: 1px solid #e6f0e7;
            border-radius: 8px;
            margin-bottom: 24px;
        }

            .profile-password .password-requirements p {
                color: #333;
                font-weight: 600;
                margin-bottom: 10px;
            }

            .profile-password .password-requirements ul {
                padding-left: 20px;
                margin: 0;
                color: #777;
                font-size: 13px;
                line-height: 1.9;
            }

        .profile-password .password-submit {
            min-width: 180px;
            min-height: 46px;
            padding: 11px 24px;
            border: none;
            border-radius: 8px;
            background: #1f9345;
            color: #fff;
            font-weight: 600;
            transition: background .2s, transform .2s;
        }

            .profile-password .password-submit:hover {
                background: #187b39;
            }

            .profile-password .password-submit:disabled {
                opacity: .65;
                cursor: not-allowed;
            }

    @@media (max-width: 576px) {
        .profile-password .password-submit {
            width: 100%;
        }
    }
</style>

<div class="profile-password">
    <div class="password-header">
        <h4>
            @(Model.HasPassword ? "Đổi mật khẩu" : "Tạo mật khẩu")
        </h4>

        <p>
            @if (Model.HasPassword)
            {
                <span>
                    Cập nhật mật khẩu đăng nhập cho tài khoản Caterin của bạn.
                </span>
            }
            else
            {
                <span>
                    Tạo mật khẩu để bạn có thể đăng nhập Caterin bằng email
                    và mật khẩu, ngoài các tài khoản Google hoặc Facebook đã kết nối.
                </span>
            }
        </p>
    </div>

    <form method="post" action="/profile/change-password">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="password-validation-summary">
        </div>

        @if (Model.HasPassword)
        {
            <div class="password-field">
                <label asp-for="CurrentPassword" class="form-label">
                    Mật khẩu hiện tại
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       class="form-control"
                       autocomplete="current-password"
                       placeholder="Nhập mật khẩu hiện tại" />

                <span asp-validation-for="CurrentPassword"
                      class="text-danger">
                </span>
            </div>
        }

        <div class="password-field">
            <label asp-for="NewPassword" class="form-label">
                @(Model.HasPassword ? "Mật khẩu mới" : "Mật khẩu")
            </label>

            <input asp-for="NewPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="Nhập mật khẩu mới" />

            <span asp-validation-for="NewPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="password-field">
            <label asp-for="ConfirmPassword" class="form-label">
                Xác nhận mật khẩu
            </label>

            <input asp-for="ConfirmPassword"
                   type="password"
                   class="form-control"
                   autocomplete="new-password"
                   placeholder="Nhập lại mật khẩu" />

            <span asp-validation-for="ConfirmPassword"
                  class="text-danger">
            </span>
        </div>

        <div class="password-requirements">
            <p>
                <i class="ti ti-shield-check me-1"></i>
                Yêu cầu mật khẩu
            </p>

            <ul>
                <li>Tối thiểu 12 ký tự.</li>
                <li>Có ít nhất 4 ký tự khác nhau.</li>
                <li>Có chữ thường và chữ hoa.</li>
                <li>Có ít nhất một chữ số.</li>
                <li>Không bắt buộc ký tự đặc biệt.</li>
            </ul>
        </div>

        <button type="submit" class="password-submit">
            <i class="ti ti-lock me-1"></i>
            @(Model.HasPassword ? "Cập nhật mật khẩu" : "Tạo mật khẩu")
        </button>
    </form>
</div>