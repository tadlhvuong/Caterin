@using Shared.DTOs.Profile
@model ProfilePasswordViewModel

@{
    Layout = null;
}

<div class="overflow-hidden rounded-2xl border border-gray-100 bg-white">

    <!-- Header -->
    <div class="border-b border-gray-100 px-5 py-5 sm:px-7 sm:py-6">
        <div class="flex items-center gap-3">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#F1F8EF] text-[#1F9345]">
                <i class="ph ph-lock-key text-2xl"></i>
            </div>

            <div class="min-w-0">
                <h2 class="text-lg font-semibold tracking-tight text-gray-900 sm:text-xl">
                    @(Model.HasPassword ? "Đổi mật khẩu" : "Tạo mật khẩu")
                </h2>

                <p class="mt-1 text-sm leading-5 text-gray-500">
                    @if (Model.HasPassword)
                    {
                        <span>Cập nhật mật khẩu đăng nhập cho tài khoản Caterin của bạn.</span>
                    }
                    else
                    {
                        <span>
                            Tạo mật khẩu để đăng nhập bằng email và mật khẩu,
                            ngoài các tài khoản Google hoặc Facebook đã kết nối.
                        </span>
                    }
                </p>
            </div>
        </div>
    </div>

    <form method="post" action="/profile/change-password" class="p-5 sm:p-7">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="mb-6 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-600">
        </div>

        <div class="max-w-2xl space-y-5">

            <!-- Current password -->
            @if (Model.HasPassword)
            {
                <div>
                    <label asp-for="CurrentPassword"
                           class="mb-2 block text-sm font-medium text-gray-700">
                        Mật khẩu hiện tại
                    </label>

                    <div class="relative">
                        <input asp-for="CurrentPassword"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Nhập mật khẩu hiện tại"
                               data-password-input
                               class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 pr-12 text-sm text-gray-900 outline-none transition-all placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />

                        <button type="button"
                                data-password-toggle
                                aria-label="Hiện mật khẩu"
                                aria-pressed="false"
                                class="absolute right-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700">
                            <i class="ph ph-eye text-lg"></i>
                        </button>
                    </div>

                    <span asp-validation-for="CurrentPassword"
                          class="mt-1.5 block text-xs text-red-500">
                    </span>
                </div>
            }

            <!-- New password -->
            <div>
                <label asp-for="NewPassword"
                       class="mb-2 block text-sm font-medium text-gray-700">
                    @(Model.HasPassword ? "Mật khẩu mới" : "Mật khẩu")
                </label>

                <div class="relative">
                    <input asp-for="NewPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Nhập mật khẩu mới"
                           data-password-input
                           class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 pr-12 text-sm text-gray-900 outline-none transition-all placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />

                    <button type="button"
                            data-password-toggle
                            aria-label="Hiện mật khẩu"
                            aria-pressed="false"
                            class="absolute right-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700">
                        <i class="ph ph-eye text-lg"></i>
                    </button>
                </div>

                <span asp-validation-for="NewPassword"
                      class="mt-1.5 block text-xs text-red-500">
                </span>
            </div>

            <!-- Confirm password -->
            <div>
                <label asp-for="ConfirmPassword"
                       class="mb-2 block text-sm font-medium text-gray-700">
                    Xác nhận mật khẩu
                </label>

                <div class="relative">
                    <input asp-for="ConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           placeholder="Nhập lại mật khẩu"
                           data-password-input
                           class="h-12 w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 pr-12 text-sm text-gray-900 outline-none transition-all placeholder:text-gray-400 hover:border-gray-300 focus:border-[#1F9345] focus:bg-white focus:ring-4 focus:ring-[#1F9345]/10" />

                    <button type="button"
                            data-password-toggle
                            aria-label="Hiện mật khẩu"
                            aria-pressed="false"
                            class="absolute right-3 top-1/2 flex size-9 -translate-y-1/2 items-center justify-center rounded-lg text-gray-400 transition-colors hover:bg-gray-100 hover:text-gray-700">
                        <i class="ph ph-eye text-lg"></i>
                    </button>
                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="mt-1.5 block text-xs text-red-500">
                </span>
            </div>

            <!-- Password requirements -->
            <div class="rounded-xl border border-[#E4EFDF] bg-[#F7FAF5] p-4 sm:p-5">
                <div class="mb-3 flex items-center gap-2">
                    <i class="ph ph-shield-check text-xl text-[#1F9345]"></i>
                    <h3 class="text-sm font-semibold text-gray-800">
                        Yêu cầu mật khẩu
                    </h3>
                </div>

                <ul class="grid grid-cols-1 gap-x-5 gap-y-2 text-[13px] leading-5 text-gray-600 sm:grid-cols-2">
                    <li class="flex items-start gap-2">
                        <i class="ph ph-check-circle mt-0.5 shrink-0 text-[#1F9345]"></i>
                        Tối thiểu 12 ký tự.
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="ph ph-check-circle mt-0.5 shrink-0 text-[#1F9345]"></i>
                        Có ít nhất 4 ký tự khác nhau.
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="ph ph-check-circle mt-0.5 shrink-0 text-[#1F9345]"></i>
                        Có chữ thường và chữ hoa.
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="ph ph-check-circle mt-0.5 shrink-0 text-[#1F9345]"></i>
                        Có ít nhất một chữ số.
                    </li>
                    <li class="flex items-start gap-2 sm:col-span-2">
                        <i class="ph ph-info mt-0.5 shrink-0 text-gray-400"></i>
                        Không bắt buộc sử dụng ký tự đặc biệt.
                    </li>
                </ul>
            </div>

        </div>

        <!-- Footer -->
        <div class="mt-7 flex flex-col-reverse gap-4 border-t border-gray-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs leading-5 text-gray-400">
                <i class="ph ph-lock-key mr-1"></i>
                Mật khẩu của bạn được bảo mật.
            </p>

            <button type="submit"
                    class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 text-sm font-semibold text-white shadow-sm shadow-[#1F9345]/15 transition-all hover:bg-[#187A39] hover:shadow-md active:scale-[0.98] focus:outline-none focus:ring-4 focus:ring-[#1F9345]/20">
                <i class="ph ph-floppy-disk-back text-lg"></i>
                @(Model.HasPassword ? "Cập nhật mật khẩu" : "Tạo mật khẩu")
            </button>
        </div>

    </form>
</div>

<script>
    (() => {
        'use strict';

        const container = document.currentScript?.previousElementSibling;
        if (!container || container.dataset.passwordReady === 'true') return;

        container.dataset.passwordReady = 'true';

        container.addEventListener('click', event => {
            const button = event.target.closest('[data-password-toggle]');
            if (!button || !container.contains(button)) return;

            const wrapper = button.parentElement;
            const input = wrapper?.querySelector('[data-password-input]');
            const icon = button.querySelector('i');

            if (!input) return;

            const isVisible = input.type === 'text';

            input.type = isVisible ? 'password' : 'text';
            button.setAttribute('aria-pressed', String(!isVisible));
            button.setAttribute(
                'aria-label',
                isVisible ? 'Hiện mật khẩu' : 'Ẩn mật khẩu'
            );

            if (icon) {
                icon.classList.toggle('ph-eye', isVisible);
                icon.classList.toggle('ph-eye-slash', !isVisible);
            }
        });
    })();
</script>
