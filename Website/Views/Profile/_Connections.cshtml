@using Shared.DTOs.Profile
@model ConnectionsViewModel

@{
    Layout = null;

    string GetProviderIcon(string? provider, string? icon)
    {
        if (!string.IsNullOrWhiteSpace(icon))
            return icon;

        return provider?.ToLowerInvariant() switch
        {
            "google" => "ph ph-google-logo",
            "facebook" => "ph ph-facebook-logo",
            "microsoft" => "ph ph-microsoft-logo",
            "apple" => "ph ph-apple-logo",
            "github" => "ph ph-github-logo",
            _ => "ph ph-link"
        };
    }
}

<div class="overflow-hidden rounded-2xl border border-gray-100 bg-white">

    <!-- Header -->
    <div class="border-b border-gray-100 px-5 py-5 sm:px-7 sm:py-6">
        <div class="flex items-center gap-3">
            <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#F1F8EF] text-[#1F9345]">
                <i class="ph ph-link text-2xl"></i>
            </div>

            <div class="min-w-0">
                <h2 class="text-lg font-semibold tracking-tight text-gray-900 sm:text-xl">
                    Kết nối tài khoản
                </h2>

                <p class="mt-1 text-sm leading-5 text-gray-500">
                    Quản lý các tài khoản bên ngoài được liên kết với Caterin.
                </p>
            </div>
        </div>
    </div>

    <!-- Connections -->
    <div class="p-5 sm:p-7">

        <div class="mb-5">
            <h3 class="text-sm font-semibold text-gray-800">
                Tài khoản liên kết
            </h3>
            <p class="mt-1 text-xs leading-5 text-gray-500">
                Kết nối tài khoản để đăng nhập nhanh chóng và thuận tiện hơn.
            </p>
        </div>

        @if (Model.Connections != null && Model.Connections.Any())
        {
            <div class="space-y-3">

                @foreach (var connection in Model.Connections)
                {
                    <div class="flex flex-col gap-4 rounded-xl border border-gray-100 bg-white p-4 transition-colors hover:border-gray-200 sm:flex-row sm:items-center sm:justify-between sm:p-5">

                        <!-- Provider information -->
                        <div class="flex min-w-0 items-center gap-3.5">

                            <div class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-gray-200 bg-white text-2xl text-gray-700">
                                <i class="@GetProviderIcon(connection.Provider, connection.Icon)"></i>
                            </div>

                            <div class="min-w-0">
                                <h4 class="truncate text-sm font-semibold text-gray-900">
                                    @connection.DisplayName
                                </h4>

                                @if (connection.IsConnected)
                                {
                                    <div class="mt-1.5 inline-flex items-center gap-1.5 text-xs font-medium text-[#1F9345]">
                                        <span class="size-1.5 rounded-full bg-[#1F9345]"></span>
                                        Đã kết nối
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-1.5 inline-flex items-center gap-1.5 text-xs font-medium text-gray-400">
                                        <span class="size-1.5 rounded-full bg-gray-300"></span>
                                        Chưa kết nối
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Action -->
                        <div class="shrink-0">
                            @if (connection.IsConnected)
                            {
                                <form method="post"
                                      action="/profile/connections/@connection.Provider/disconnect">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="inline-flex h-10 w-full items-center justify-center gap-2 rounded-lg border border-red-100 bg-red-50 px-4 text-sm font-medium text-red-600 transition-colors hover:border-red-200 hover:bg-red-100 sm:w-auto">
                                        <i class="ph ph-link-break text-base"></i>
                                        Ngắt kết nối
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post"
                                      action="/profile/connections/@connection.Provider/connect">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="inline-flex h-10 w-full items-center justify-center gap-2 rounded-lg bg-[#1F9345] px-5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#187A39] sm:w-auto">
                                        <i class="ph ph-link text-base"></i>
                                        Kết nối
                                    </button>
                                </form>
                            }
                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- Empty state -->
            <div class="rounded-xl border border-dashed border-gray-200 px-5 py-12 text-center">
                <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-gray-50 text-gray-400">
                    <i class="ph ph-link-break text-2xl"></i>
                </div>

                <h3 class="mt-4 text-sm font-semibold text-gray-800">
                    Chưa có tài khoản liên kết
                </h3>

                <p class="mx-auto mt-1 max-w-sm text-xs leading-5 text-gray-500">
                    Hiện chưa có nhà cung cấp tài khoản nào khả dụng.
                </p>
            </div>
        }

        <!-- Information -->
        <div class="mt-6 flex items-start gap-2.5 rounded-xl border border-[#E4EFDF] bg-[#F7FAF5] p-4">
            <i class="ph ph-info mt-0.5 shrink-0 text-lg text-[#1F9345]"></i>

            <p class="text-xs leading-5 text-gray-600">
                Khi ngắt kết nối, bạn sẽ không thể sử dụng tài khoản bên ngoài đó
                để đăng nhập Caterin. Hãy đảm bảo bạn vẫn có phương thức đăng nhập
                khác trước khi thực hiện.
            </p>
        </div>

    </div>
</div>
