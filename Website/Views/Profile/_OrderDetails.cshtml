@{
    Layout = null;
}

<div class="space-y-5 sm:space-y-6">

    <!-- Order header -->
    <div class="rounded-2xl border border-gray-100 bg-white p-5 sm:p-7">

        <a asp-action="Orders"
           class="mb-5 inline-flex items-center gap-2 text-sm font-medium text-gray-500 transition-colors hover:text-[#1F9345]">
            <i class="ph ph-arrow-left text-base"></i>
            Quay lại đơn hàng
        </a>

        <div class="flex flex-wrap items-start justify-between gap-4">

            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wider text-gray-400">
                    Chi tiết đơn hàng
                </p>

                <h2 class="mt-2 text-xl font-bold tracking-tight text-gray-900 sm:text-2xl">
                    #CT240700012
                </h2>

                <p class="mt-2 flex items-center gap-1.5 text-sm text-gray-500">
                    <i class="ph ph-calendar-blank"></i>
                    Đặt ngày 09/07/2026
                </p>
            </div>

            <span class="inline-flex items-center gap-2 rounded-full bg-green-50 px-4 py-2 text-xs font-semibold text-green-700">
                <span class="size-1.5 rounded-full bg-green-500"></span>
                Đã giao
            </span>

        </div>
    </div>

    <!-- Shipping information -->
    <section class="rounded-2xl border border-gray-100 bg-white p-5 sm:p-7">

        <div class="mb-6 flex items-center gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#F1F8EF] text-[#1F9345]">
                <i class="ph ph-map-pin text-xl"></i>
            </div>

            <div>
                <h3 class="text-base font-semibold text-gray-900">
                    Thông tin giao hàng
                </h3>
                <p class="mt-0.5 text-xs text-gray-500">
                    Thông tin người nhận và phương thức thanh toán
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">

            <div>
                <p class="mb-1.5 text-xs text-gray-400">
                    Người nhận
                </p>
                <p class="text-sm font-semibold text-gray-800">
                    Nguyễn Văn A
                </p>
            </div>

            <div>
                <p class="mb-1.5 text-xs text-gray-400">
                    Điện thoại
                </p>
                <p class="text-sm font-semibold text-gray-800">
                    0988888888
                </p>
            </div>

            <div>
                <p class="mb-1.5 text-xs text-gray-400">
                    Thanh toán
                </p>
                <p class="text-sm font-semibold text-gray-800">
                    COD
                </p>
            </div>

            <div class="border-t border-gray-100 pt-5 sm:col-span-2 lg:col-span-3">
                <p class="mb-1.5 text-xs text-gray-400">
                    Địa chỉ giao hàng
                </p>

                <p class="flex items-start gap-2 text-sm font-medium leading-6 text-gray-800">
                    <i class="ph ph-map-pin mt-0.5 shrink-0 text-base text-[#1F9345]"></i>
                    123 Nguyễn Huệ, Quận 1, TP.HCM
                </p>
            </div>

        </div>
    </section>

    <!-- Order progress -->
    <section class="rounded-2xl border border-gray-100 bg-white p-5 sm:p-7">

        <div class="mb-7 flex items-center gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#F1F8EF] text-[#1F9345]">
                <i class="ph ph-package text-xl"></i>
            </div>

            <div>
                <h3 class="text-base font-semibold text-gray-900">
                    Trạng thái đơn hàng
                </h3>
                <p class="mt-0.5 text-xs text-gray-500">
                    Theo dõi tiến trình xử lý đơn hàng
                </p>
            </div>
        </div>

        <div class="relative px-1 sm:px-3">

            <!-- Progress line -->
            <div class="absolute left-[12.5%] right-[12.5%] top-5 h-[3px] rounded-full bg-gray-100">
                <div class="h-full w-full rounded-full bg-[#1F9345]"></div>
            </div>

            <!-- Steps -->
            <div class="relative grid grid-cols-4">

                <div class="flex flex-col items-center text-center">
                    <div class="z-10 flex size-10 items-center justify-center rounded-full bg-[#1F9345] text-white shadow-sm shadow-[#1F9345]/20">
                        <i class="ph-fill ph-check-circle text-xl"></i>
                    </div>

                    <span class="mt-3 text-[11px] font-semibold text-[#1F9345] sm:text-sm">
                        Đặt hàng
                    </span>
                </div>

                <div class="flex flex-col items-center text-center">
                    <div class="z-10 flex size-10 items-center justify-center rounded-full bg-[#1F9345] text-white shadow-sm shadow-[#1F9345]/20">
                        <i class="ph-fill ph-package text-xl"></i>
                    </div>

                    <span class="mt-3 text-[11px] font-semibold text-[#1F9345] sm:text-sm">
                        Xác nhận
                    </span>
                </div>

                <div class="flex flex-col items-center text-center">
                    <div class="z-10 flex size-10 items-center justify-center rounded-full bg-[#1F9345] text-white shadow-sm shadow-[#1F9345]/20">
                        <i class="ph-fill ph-truck text-xl"></i>
                    </div>

                    <span class="mt-3 text-[11px] font-semibold text-[#1F9345] sm:text-sm">
                        Đang giao
                    </span>
                </div>

                <div class="flex flex-col items-center text-center">
                    <div class="z-10 flex size-10 items-center justify-center rounded-full bg-[#1F9345] text-white shadow-sm shadow-[#1F9345]/20">
                        <i class="ph-fill ph-house text-xl"></i>
                    </div>

                    <span class="mt-3 text-[11px] font-semibold text-[#1F9345] sm:text-sm">
                        Đã giao
                    </span>
                </div>

            </div>
        </div>
    </section>

    <!-- Products -->
    <section class="rounded-2xl border border-gray-100 bg-white p-5 sm:p-7">

        <div class="mb-6 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#F1F8EF] text-[#1F9345]">
                    <i class="ph ph-shopping-bag text-xl"></i>
                </div>

                <div>
                    <h3 class="text-base font-semibold text-gray-900">
                        Sản phẩm
                    </h3>
                    <p class="mt-0.5 text-xs text-gray-500">
                        Sản phẩm trong đơn hàng
                    </p>
                </div>
            </div>

            <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-500">
                1 sản phẩm
            </span>
        </div>

        <div class="flex flex-wrap items-center gap-3 border-t border-gray-100 pt-5 sm:flex-nowrap sm:gap-4">

            <div class="size-20 shrink-0 overflow-hidden rounded-xl border border-gray-100 bg-gray-50 sm:size-24">
                <img src="/images/product/product-img1.png"
                     class="size-full object-cover"
                     alt="Nước rửa chén Gạo Caterin"
                     loading="lazy">
            </div>

            <div class="min-w-0 flex-1">
                <h4 class="text-sm font-semibold leading-5 text-gray-900 sm:text-base">
                    Nước rửa chén Gạo Caterin
                </h4>

                <p class="mt-1.5 text-xs text-gray-500">
                    Dung tích: 950ml
                </p>

                <p class="mt-1 text-xs text-gray-500">
                    Đơn giá: 65.000đ
                </p>
            </div>

            <div class="flex w-full items-center justify-between border-t border-gray-100 pt-3 sm:w-auto sm:flex-col sm:items-end sm:border-0 sm:pt-0">
                <span class="text-xs text-gray-400 sm:mb-1">
                    Số lượng: x2
                </span>

                <span class="text-sm font-bold text-gray-900">
                    130.000đ
                </span>
            </div>

        </div>
    </section>

    <!-- Payment summary -->
    <section class="rounded-2xl border border-gray-100 bg-white p-5 sm:p-7">

        <div class="mb-6 flex items-center gap-3">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#F1F8EF] text-[#1F9345]">
                <i class="ph ph-receipt text-xl"></i>
            </div>

            <div>
                <h3 class="text-base font-semibold text-gray-900">
                    Thanh toán
                </h3>
                <p class="mt-0.5 text-xs text-gray-500">
                    Chi tiết chi phí đơn hàng
                </p>
            </div>
        </div>

        <div class="max-w-xl space-y-4">

            <div class="flex items-center justify-between gap-4 text-sm">
                <span class="text-gray-500">Tạm tính</span>
                <span class="font-medium text-gray-800">219.000đ</span>
            </div>

            <div class="flex items-center justify-between gap-4 text-sm">
                <span class="text-gray-500">Phí vận chuyển</span>
                <span class="font-medium text-gray-800">25.000đ</span>
            </div>

            <div class="flex items-center justify-between gap-4 text-sm">
                <span class="text-gray-500">Voucher</span>
                <span class="font-medium text-red-600">-20.000đ</span>
            </div>

        </div>

        <div class="mt-6 border-t border-dashed border-gray-200 pt-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <p class="text-sm font-semibold text-gray-900">
                        Tổng thanh toán
                    </p>
                    <p class="mt-1 text-xs text-gray-400">
                        Đã bao gồm phí vận chuyển và ưu đãi
                    </p>
                </div>

                <p class="text-xl font-bold tracking-tight text-[#1F9345] sm:text-2xl">
                    224.000đ
                </p>
            </div>
        </div>

    </section>

    <!-- Actions -->
    <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-between">

        <a href="#"
           class="inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-5 text-sm font-medium text-gray-600 transition-colors hover:border-[#1F9345] hover:text-[#1F9345]">
            <i class="ph ph-download-simple text-lg"></i>
            Tải hóa đơn
        </a>

        <div class="grid grid-cols-2 gap-3 sm:flex sm:items-center">

            <button type="button"
                    class="inline-flex h-11 items-center justify-center rounded-xl border border-gray-200 bg-white px-5 text-sm font-semibold text-gray-700 transition-colors hover:border-[#1F9345] hover:text-[#1F9345]">
                Mua lại
            </button>

            <button type="button"
                    class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#187A39]">
                <i class="ph ph-headset text-lg"></i>
                Liên hệ hỗ trợ
            </button>
        </div>
    </div>
</div>
