@{
    Layout = null;

    var displayName = ViewBag.DisplayName as string ?? "Tài khoản";
    var email = ViewBag.Email as string ?? string.Empty;
    var avatarUrl = ViewBag.AvatarUrl as string
                    ?? Url.Content("~/images/Default/default-user.png");
    var hasPassword = ViewBag.HasPassword is bool value && value;
}

<style>
    #profile-content {
        transition: opacity .15s ease;
    }

        #profile-content.profile-loading {
            opacity: .45;
            pointer-events: none;
        }
        </style>

<div class="2xl:w-3/12 xl:w-4/12 flex-grow-0 flex-shrink-0 basis-auto">
    <div class="border border-gray-100 rounded-16 overflow-hidden">
        <div class="bg-main-50 text-center py-40">
            <img src="@avatarUrl"
                 class="rounded-circle mb-20"
                 width="90"
                 height="90"
                 alt="Avatar">

            <h5 class="mb-8">@displayName</h5>

            <span class="text-gray-500">@email</span>
        </div>

        <div class="py-16">
            <button type="button"
                    class="account-menu"
                    data-url="/profile/personal-info"
                    data-tab="personal">
                <i class="ph ph-user"></i>
                Hồ sơ
            </button>

            <button type="button"
                    class="account-menu"
                    data-url="/profile/orders"
                    data-tab="orders">
                <i class="ph ph-shopping-bag"></i>
                Đơn hàng
            </button>

            <button type="button"
                    class="account-menu"
                    data-url="/profile/addresses"
                    data-tab="addresses">
                <i class="ph ph-map-pin"></i>
                Địa chỉ
            </button>

            <button type="button"
                    class="account-menu"
                    data-url="/profile/change-password"
                    data-tab="password">
                <i class="ph ph-lock-key"></i>
                @(hasPassword ? "Đổi mật khẩu" : "Tạo mật khẩu")
            </button>

            <button type="button"
                    class="account-menu"
                    data-url="/profile/connections"
                    data-tab="connections">
                <i class="ph ph-link"></i>
                Kết nối tài khoản
            </button>

            <form id="logout-form"
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="account-menu text-danger-600">
                    <i class="ph ph-sign-out"></i>
                    Đăng xuất
                </button>
            </form>
        </div>
    </div>
</div>