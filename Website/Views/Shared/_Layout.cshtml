@using Shared.Interfaces.AuthServices
@inject IPermissionService PermissionService
@{
    var canAccessAdmin = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        var versionClaim = User.FindFirst("permission_version")?.Value;

        if (!string.IsNullOrEmpty(userId)
            && long.TryParse(versionClaim, out var permissionVersion))
        {
            var snapshot = await PermissionService
                .GetUserPermissionSnapshotAsync(userId, permissionVersion);

            var dashboardPermissionId = await PermissionService
                .GetPermissionIdAsync("system.admin.access");

            canAccessAdmin = snapshot.IsRoot
                || (dashboardPermissionId.HasValue
                    && snapshot.PermissionIds.Contains(dashboardPermissionId.Value));
        }
    }
}
