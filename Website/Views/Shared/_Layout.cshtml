                              class="chat-status-badge"
                              data-status="open"
                              hidden>
                        </span>

                        <button type="button"
                                id="chatClose"
                                aria-label="Đóng chat"
                                class="chat-close flex size-9 shrink-0 items-center justify-center rounded-full text-white transition hover:bg-white/15">

                            <svg viewBox="0 0 24 24" fill="none" class="size-5">
                                <path d="M6 6L18 18M18 6L6 18"
                                      stroke="currentColor"
                                      stroke-width="1.8"
                                      stroke-linecap="round" />
                            </svg>

                        </button>
                    </div>
                </header>

                <!-- PREVIOUS CONVERSATION -->
                <div id="chatHistoryLoader" hidden class="shrink-0 border-b border-slate-100 px-4 py-2 [hidden]:!hidden">
                    <button type="button"
                            id="loadPreviousConversationBtn"
                            class="flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-50 px-3 py-2 text-xs font-medium text-[#249e63] transition hover:bg-emerald-100">
                        <i class="ph ph-clock-counter-clockwise"></i>
                        <span>Xem cuộc trò chuyện trước</span>
                    </button>
                </div>


                <!-- QUICK REPLIES -->
                <section class="quick-replies shrink-0 border-b border-slate-100 px-4 py-4 [hidden]:!hidden"
                         aria-label="Gợi ý tin nhắn">

                    <div class="welcome-message mb-4 flex items-start gap-3 rounded-xl bg-emerald-50 p-3">

                        <div class="welcome-icon flex size-9 shrink-0 items-center justify-center rounded-full bg-white text-[#249e63]">
                            <i class="ph ph-shield-check text-xl"></i>
                        </div>

                        <div class="welcome-message-content min-w-0">
                            <strong class="text-sm font-bold text-slate-800">
                                Xin chào 👋
                            </strong>
                            <p class="mt-1 text-xs leading-5 text-slate-600">
                                Caterin rất vui được hỗ trợ bạn.
                                Bạn cần tư vấn sản phẩm hay đơn hàng?
                            </p>
                        </div>
                    </div>

                    <div class="quick-replies-options flex flex-wrap gap-2">
                        <button type="button" data-message="Tư vấn sản phẩm"
                                class="rounded-full border border-emerald-200 px-3 py-2 text-xs text-[#249e63] transition hover:bg-emerald-50">
                            🧴 Tư vấn sản phẩm
                        </button>
                        <button type="button" data-message="Kiểm tra đơn hàng"
                                class="rounded-full border border-emerald-200 px-3 py-2 text-xs text-[#249e63] transition hover:bg-emerald-50">
                            📦 Kiểm tra đơn hàng
                        </button>
                        <button type="button" data-message="Tư vấn combo"
                                class="rounded-full border border-emerald-200 px-3 py-2 text-xs text-[#249e63] transition hover:bg-emerald-50">
                            🏠 Tư vấn combo
                        </button>
                        <button type="button" data-message="Chính sách giao hàng"
                                class="rounded-full border border-emerald-200 px-3 py-2 text-xs text-[#249e63] transition hover:bg-emerald-50">
                            🚚 Chính sách giao hàng
                        </button>
                    </div>
                </section>


                <!-- CHAT HISTORY -->
                <div id="chatBody"
                     class="chat-body min-h-0 flex-1 overflow-y-auto overscroll-contain bg-[#f8faf9] px-3 py-4"
                     role="log"
                     aria-live="polite"
                     aria-relevant="additions text"
                     aria-label="Tin nhắn">
                </div>

                <!-- INVALID SESSION -->
                <section id="chatSessionReset"
                         class="chat-session-reset shrink-0 border-t border-red-100 bg-red-50 p-3 [hidden]:!hidden"
                         hidden
                         aria-live="polite">

                    <div class="chat-session-reset-content flex items-center gap-3">

                        <div class="chat-session-reset-icon flex size-9 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-500">
                            <i class="ph ph-warning-circle text-xl"></i>
                        </div>

                        <div class="chat-session-reset-text min-w-0 flex-1">
                            <strong class="block text-xs font-bold text-slate-800">
                                Phiên trò chuyện không hợp lệ
                            </strong>
                            <span class="chat-session-reset-description mt-1 block text-xs leading-5 text-slate-600">
                                Phiên trò chuyện hiện tại không còn hợp lệ.
                                Vui lòng bắt đầu lại để tiếp tục.
                            </span>
                        </div>

                        <button type="button"
                                id="resetChatBox"
                                class="shrink-0 rounded-lg bg-[#249e63] px-3 py-2 text-xs font-semibold text-white hover:bg-[#18834f]">
                            Bắt đầu lại
                        </button>
                    </div>
                </section>

                <!-- TYPING INDICATOR -->
                <div id="typing"
                     class="typing shrink-0 items-center gap-2 px-4 py-2 [hidden]:!hidden"
                     hidden
                     aria-live="polite">

                    <div class="typing-avatar flex size-7 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-[#249e63]">
                        C
                    </div>

                    <div class="typing-bubble flex items-center gap-1 rounded-full bg-white px-3 py-2 shadow-sm">
                        <span class="size-1.5 rounded-full bg-slate-400"></span>
                        <span class="size-1.5 rounded-full bg-slate-400"></span>
                        <span class="size-1.5 rounded-full bg-slate-400"></span>
                    </div>

                    <span class="typing-text text-[11px] text-slate-400">
                        Đang nhập
                    </span>
                </div>

                <!-- COMPOSER -->
                <footer class="chat-footer shrink-0 border-t border-slate-100 bg-white p-3">

                    <div class="chat-footer-content">

                        <!-- ATTACHMENT PREVIEW -->
                        <div id="chatAttachmentPreview"
                             class="chat-attachment-preview mb-2 [hidden]:!hidden"
                             hidden>
                            <div id="chatAttachmentList"
                                 class="chat-attachment-list flex flex-wrap gap-2">
                            </div>
                        </div>

                        <!-- INPUT ROW -->
                        <div class="chat-input-row flex items-center gap-2">

                            <div class="chat-input-wrapper flex min-w-0 flex-1 items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-3">

                                <button type="button"
                                        id="attachmentBtn"
                                        aria-label="Đính kèm tệp"
                                        class="input-action flex size-8 shrink-0 items-center justify-center text-slate-500 transition hover:text-[#249e63]">
                                    <i class="ph ph-paperclip text-xl"></i>
                                </button>

                                <input type="file"
                                       id="chatFileInput"
                                       hidden
                                       multiple
                                       tabindex="-1" />

                                <input type="text"
                                       id="chatInput"
                                       placeholder="Nhập tin nhắn..."
                                       autocomplete="off"
                                       aria-label="Nhập tin nhắn"
                                       class="chat-input min-w-0 flex-1 bg-transparent py-3 text-sm text-slate-800 outline-none placeholder:text-slate-400" />

                                <button type="button"
                                        id="emojiBtn"
                                        aria-label="Chọn biểu tượng cảm xúc"
                                        class="emoji-btn flex size-8 shrink-0 items-center justify-center text-lg">
                                    😊
                                </button>
                            </div>

                            <button type="button"
                                    id="sendBtn"
                                    aria-label="Gửi tin nhắn"
                                    class="send-btn flex size-11 shrink-0 items-center justify-center rounded-full bg-[#249e63] text-white transition hover:bg-[#18834f]">
                                <i class="ph ph-paper-plane-tilt text-xl"></i>
                            </button>

                        </div>
                    </div>
                </footer>


                <!-- POWERED -->
                <div class="chat-powered flex shrink-0 items-center justify-center gap-1 border-t border-slate-100 bg-white py-2 text-[10px] text-slate-400">
                    <span>Được hỗ trợ bởi</span>
                    <strong class="font-semibold text-[#249e63]">
                        Caterin Việt nam
                    </strong>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@phosphor-icons/web@2.1.2"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@7.0.0/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@14.4.0/swiper-bundle.min.js" defer></script>

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@@11"></script>
    <script src="~/admin/assets/js/customize/toast-setting.js"></script>
    <script src="~/admin/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.min.js"></script>

    <script src="~/js/common/cart.js" asp-append-version="true"></script>

    <script src="~/js/common/wishlist.js" asp-append-version="true"></script>

    <script src="~/js/common/product-actions.js" asp-append-version="true"></script>

    <script src="~/js/core/chat.js"></script>
    <script src="~/js/core/site.js"></script>
    @* <script defer="defer" src="~/js/app.bundle.js" asp-append-version="true"></script> *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
