@using Website.Models.Shop
@model ShopIndexViewModel

@{
    ViewData["Title"] = "Cửa hàng | Caterin";
}

<section class="bg-[#F5F9F2] py-8">
    <div class="container mx-auto px-4">
        <nav class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
            <a href="/" class="transition hover:text-[#1F9345]">Trang chủ</a>
            <i class="ph ph-caret-right text-xs"></i>
            <span class="font-medium text-[#1F9345]">Cửa hàng</span>
        </nav>

        <div class="mt-4">
            <h1 class="text-2xl font-bold text-gray-900 md:text-3xl">
                Sản phẩm Caterin
            </h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">
                Chăm sóc ngôi nhà sạch lành với các sản phẩm vệ sinh gia đình
                an toàn và tiện lợi.
            </p>
        </div>
    </div>
</section>

<section class="py-10 md:py-14">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

            <!-- Sidebar -->
            <aside class="lg:col-span-3">
                <partial name="_ShopSidebar" model="Model" />
            </aside>

            <!-- Product content -->
            <div class="min-w-0 lg:col-span-9">
                <div id="shopResultsContainer">
                    <partial name="_ShopProductResults" model="Model" />
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Service benefits -->
<section class="mb-10">
    <div class="container mx-auto px-4">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            <div class="flex items-center gap-4 rounded-xl border border-gray-100 bg-white p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                    <i class="ph ph-truck text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">Giao hàng tiện lợi</h3>
                    <p class="mt-1 text-xs text-gray-500">Giao hàng đến tận nhà</p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-xl border border-gray-100 bg-white p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                    <i class="ph ph-seal-check text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">Chất lượng đảm bảo</h3>
                    <p class="mt-1 text-xs text-gray-500">Chăm sóc nhà cửa mỗi ngày</p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-xl border border-gray-100 bg-white p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                    <i class="ph ph-shield-check text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">Thanh toán an toàn</h3>
                    <p class="mt-1 text-xs text-gray-500">Thông tin được bảo vệ</p>
                </div>
            </div>

            <div class="flex items-center gap-4 rounded-xl border border-gray-100 bg-white p-5">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                    <i class="ph ph-headset text-2xl"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-gray-900">Hỗ trợ khách hàng</h3>
                    <p class="mt-1 text-xs text-gray-500">Luôn sẵn sàng hỗ trợ</p>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/shop/shop.js" asp-append-version="true"></script>
}
