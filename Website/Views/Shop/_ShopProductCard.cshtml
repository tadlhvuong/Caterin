@using Website.Models.Shop
@model ShopProductViewModel

@{
    var badgeClass = Model.BadgeColor switch
    {
        "success" => "bg-[#EAF5E7] text-[#1F9345]",
        "danger" => "bg-red-50 text-red-600",
        "warning" => "bg-amber-50 text-amber-600",
        "info" => "bg-blue-50 text-blue-600",
        _ => "bg-gray-100 text-gray-600"
    };
}

<article class="shop-product-card group flex min-w-0 flex-col overflow-hidden rounded-xl border border-gray-100 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg"
         data-product-card
         data-product-name="@Model.Name"
         data-product-price="@Model.Price"
         data-product-image="@Url.Content(Model.ImageUrl)"
         data-product-slug="@Model.Slug">
    <!-- Product image -->
    <div class="shop-product-image relative aspect-square overflow-hidden bg-[#F7F9F5]">

        <a href="/product/@Model.Slug"
           class="flex h-full w-full items-center justify-center p-4"
           aria-label="Xem @Model.Name">

            <img src="@Url.Content(Model.ImageUrl)"
                 alt="@Model.Name"
                 loading="lazy"
                 class="h-full w-full object-contain transition duration-500 group-hover:scale-105" />
        </a>

        @if (!string.IsNullOrWhiteSpace(Model.Badge))
        {
            <span class="absolute left-3 top-3 rounded-full px-2.5 py-1 text-[10px] font-semibold @badgeClass">
                @Model.Badge
            </span>
        }

        @if (Model.DiscountPercent > 0)
        {
            <span class="absolute right-3 top-3 rounded-full bg-red-500 px-2 py-1 text-[10px] font-semibold text-white">
                -@Model.DiscountPercent%
            </span>
        }

        <button type="button"
                class="absolute bottom-3 right-3 flex h-9 w-9 items-center justify-center rounded-full bg-white text-gray-600 shadow-sm transition hover:bg-[#1F9345] hover:text-white"
                aria-label="Thêm @Model.Name vào danh sách yêu thích"
                aria-pressed="false"
                data-wishlist-product-id="@Model.Id">
            <i class="ph ph-heart text-lg"></i>
        </button>
    </div>

    <!-- Product information -->
    <div class="shop-product-content flex flex-1 flex-col p-3 sm:p-4">

        <p class="mb-1 text-[11px] font-medium text-[#1F9345]">
            @Model.CategoryName
        </p>

        <h3 class="line-clamp-2 min-h-10 text-sm font-semibold leading-5 text-gray-900 transition group-hover:text-[#1F9345] sm:text-base">
            <a href="/product/@Model.Slug">
                @Model.Name
            </a>
        </h3>

        <div class="mt-2 flex flex-wrap items-center gap-1.5">
            <span class="text-amber-400">
                <i class="ph-fill ph-star"></i>
            </span>

            <span class="text-xs font-semibold text-gray-700">
                @Model.Rating.ToString("0.0")
            </span>

            <span class="text-xs text-gray-400">
                (@Model.ReviewCount đánh giá)
            </span>
        </div>

        <p class="mt-2 text-xs text-gray-500">
            Dung tích: <span class="font-medium text-gray-700">@Model.Volume</span>
        </p>

        <div class="mt-3 flex flex-wrap items-baseline gap-2">
            <span class="text-base font-bold text-[#1F9345] sm:text-lg">
                @Model.Price.ToString("N0")đ
            </span>

            @if (Model.OriginalPrice.HasValue && Model.OriginalPrice.Value > Model.Price)
            {
                <span class="text-xs text-gray-400 line-through">
                    @Model.OriginalPrice.Value.ToString("N0")đ
                </span>
            }
        </div>

        <div class="mt-auto pt-4">
            <button type="button"
                    data-add-to-cart
                    data-product-id="@Model.Id"
                    class="flex w-full items-center justify-center gap-2 rounded-lg border border-[#1F9345] px-3 py-2.5 text-xs font-semibold text-[#1F9345] transition hover:bg-[#1F9345] hover:text-white sm:text-sm">
                <i class="ph ph-shopping-cart-simple text-base"></i>
                Thêm vào giỏ
            </button>
        </div>
    </div>
</article>