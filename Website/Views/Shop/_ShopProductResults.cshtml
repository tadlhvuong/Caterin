@using Website.Models.Shop
@model ShopIndexViewModel

@{
    var sortOptions = new Dictionary<string, string>
    {
        ["featured"] = "Nổi bật",
        ["popular"] = "Bán chạy",
        ["latest"] = "Mới nhất",
        ["price-asc"] = "Giá tăng dần",
        ["price-desc"] = "Giá giảm dần",
        ["rating"] = "Đánh giá cao"
    };
}

<!-- Toolbar -->
<div class="mb-6 flex flex-col gap-4 rounded-xl border border-gray-100 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between">

    <p class="text-sm text-gray-600">
        Hiển thị
        <span class="font-semibold text-gray-900">
            @Model.StartItem–@Model.EndItem
        </span>
        trong tổng số
        <span class="font-semibold text-gray-900">
            @Model.TotalProducts
        </span>
        sản phẩm
    </p>

    <div class="flex flex-wrap items-center gap-3">
        <form asp-controller="Shop"
              asp-action="Index"
              method="get"
              data-shop-sort-form
              class="flex items-center gap-2">

            <input type="hidden" name="keyword" value="@Model.Keyword" />
            <input type="hidden" name="category" value="@Model.Category" />
            <input type="hidden" name="minPrice" value="@Model.MinPrice" />
            <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
            <input type="hidden" name="rating" value="@Model.Rating" />
            <input type="hidden" name="volume" value="@Model.Volume" />

            <label for="sortBy" class="whitespace-nowrap text-sm text-gray-500">
                Sắp xếp:
            </label>

            <select id="sortBy"
                    name="sortBy"
                    class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 outline-none transition focus:border-[#1F9345] focus:ring-2 focus:ring-[#1F9345]/10">
                @foreach (var option in sortOptions)
                {
                    <option value="@option.Key"
                            selected="@(Model.SortBy == option.Key)">
                        @option.Value
                    </option>
                }
            </select>
        </form>

        <div class="hidden items-center gap-1 border-l border-gray-200 pl-3 sm:flex">
            <button type="button"
                    id="gridViewButton"
                    aria-label="Hiển thị dạng lưới"
                    aria-pressed="true"
                    class="view-toggle rounded-lg bg-[#1F9345] p-2 text-white transition">
                <i class="ph ph-squares-four text-lg"></i>
            </button>

            <button type="button"
                    id="listViewButton"
                    aria-label="Hiển thị dạng danh sách"
                    aria-pressed="false"
                    class="view-toggle rounded-lg p-2 text-gray-500 transition hover:bg-gray-100">
                <i class="ph ph-list text-lg"></i>
            </button>
        </div>
    </div>
</div>

<!-- Products -->
@if (Model.Products.Any())
{
    <div id="shopProductGrid"
         class="grid grid-cols-2 gap-4 sm:grid-cols-2 md:gap-5 xl:grid-cols-3">

        @foreach (var product in Model.Products)
        {
            <partial name="_ShopProductCard" model="product" />
        }
    </div>

    <partial name="_ShopPagination" model="Model" />
}
else
{
    <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-6 py-16 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
            <i class="ph ph-magnifying-glass text-3xl"></i>
        </div>

        <h2 class="mt-5 text-lg font-semibold text-gray-900">
            Không tìm thấy sản phẩm
        </h2>

        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500">
            Không có sản phẩm phù hợp với điều kiện tìm kiếm.
            Bạn hãy thử thay đổi bộ lọc nhé.
        </p>

        <a asp-controller="Shop"
           asp-action="Index"
           data-clear-shop-filter
           class="mt-6 inline-flex items-center justify-center rounded-lg bg-[#1F9345] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#18783A]">
            Xem tất cả sản phẩm
        </a>
    </div>
}