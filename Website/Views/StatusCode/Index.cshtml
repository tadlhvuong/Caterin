@model int

@{
    Layout = null;

    var statusCode = Model;

    var statusMessage = statusCode switch
    {
        400 => "Bad request: The request cannot be fulfilled due to bad syntax",
        403 => "Forbidden",
        404 => "Page not found",
        405 => "This page isn’t working! If the problem continues, contact the site owner.",
        408 => "The server timed out waiting for the request",
        500 => "Internal Server Error - server was unable to finish processing the request",
        _ => "That’s odd... Something we didn't expect happened"
    };

    var (icon, iconColor, badgeColor) = statusCode switch
    {
        403 => ("ph-shield-warning", "text-amber-600", "bg-amber-50 text-amber-700 border-amber-100"),
        404 => ("ph-magnifying-glass", "text-gray-500", "bg-gray-100 text-gray-700 border-gray-200"),
        500 => ("ph-warning-circle", "text-red-600", "bg-red-50 text-red-700 border-red-100"),
        _ => ("ph-warning-octagon", "text-red-600", "bg-red-50 text-red-700 border-red-100")
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />

    <title>Error @statusCode | Caterin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@phosphor-icons/web@2.1.2/src/regular/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   
</head>

<body class="min-h-screen bg-[#FAFCF9] text-gray-900 antialiased">

    <main class="flex min-h-screen items-center justify-center px-4 py-12 sm:px-6">
        <div class="w-full max-w-2xl">

            <!-- Brand -->
            <div class="mb-8 text-center">
                <a href="/"
                   class="inline-flex items-center gap-2 text-2xl font-bold tracking-tight text-[#1F9345]">
                    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#1F9345] text-white">
                        <i class="ph-fill ph-leaf text-2xl"></i>
                    </span>
                    Caterin
                </a>
            </div>

            <!-- Error card -->
            <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">

                <div class="px-5 py-10 text-center sm:px-10 sm:py-14">

                    <!-- Error icon -->
                    <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-gray-50">
                        <i class="ph-fill @icon text-5xl"></i>
                    </div>

                    <!-- Status badge -->
                    <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold @badgeColor">
                        HTTP ERROR @statusCode
                    </span>

                    <!-- Error code -->
                    <h1 class="mt-5 text-6xl font-extrabold tracking-tight text-gray-900 sm:text-7xl">
                        @statusCode
                    </h1>

                    <!-- Message -->
                    <h2 class="mt-5 text-xl font-bold text-gray-900 sm:text-2xl">
                        @statusMessage
                    </h2>

                    <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-gray-500 sm:text-base">
                        Đã xảy ra sự cố khi xử lý yêu cầu của bạn.
                        Vui lòng thử lại hoặc quay về trang chủ.
                    </p>

                    <!-- Actions -->
                    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                        <a href="/"
                           class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#1F9345] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#187A39] focus:outline-none focus:ring-4 focus:ring-green-100">
                            <i class="ph ph-house text-lg"></i>
                            Go to home
                        </a>

                        <button type="button"
                                onclick="window.history.back()"
                                class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-700 transition hover:border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-4 focus:ring-gray-100">
                            <i class="ph ph-arrow-left text-lg"></i>
                            Go back
                        </button>
                    </div>
                </div>

                <!-- Footer -->
                <div class="border-t border-gray-100 bg-[#F7FAF6] px-5 py-4 text-center">
                    <p class="text-xs text-gray-500 sm:text-sm">
                        Caterin – An toàn cho mọi nhà
                    </p>
                </div>
            </section>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@phosphor-icons/web@2.1.2"></script>
    <script src="~/js/core/site.js"></script>
</body>
</html>
