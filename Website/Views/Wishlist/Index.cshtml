@using Website.Models.Wishlist
@model WishlistIndexViewModel

@{
    ViewData["Title"] = "Sản phẩm yêu thích | Caterin";
}

<!-- Breadcrumb -->
<section class="bg-[#F5F9F2] py-8">
    <div class="container mx-auto px-4">
        <nav class="flex items-center gap-2 text-sm text-gray-500">
            <a href="/" class="hover:text-[#1F9345]">Trang chủ</a>
            <i class="ph ph-caret-right text-xs"></i>
            <span class="font-medium text-[#1F9345]">Sản phẩm yêu thích</span>
        </nav>

        <h1 class="mt-4 text-2xl font-bold text-gray-900 md:text-3xl">
            Sản phẩm yêu thích
        </h1>

        <p class="mt-2 text-sm text-gray-600">
            Lưu lại những sản phẩm bạn yêu thích và mua sắm bất cứ khi nào.
        </p>
    </div>
</section>

<section class="py-10 md:py-14">
    <div class="container mx-auto px-4">

        <!-- Wishlist heading -->
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-bold text-gray-900">
                    Danh sách của tôi
                </h2>

                <p class="mt-1 text-sm text-gray-500">
                    <span id="wishlistTotal">@Model.TotalItems</span>
                    sản phẩm yêu thích
                </p>
            </div>

            <a href="/shop"
               class="inline-flex items-center gap-2 text-sm font-semibold text-[#1F9345] hover:underline">
                Tiếp tục mua sắm
                <i class="ph ph-arrow-right"></i>
            </a>
        </div>

        @if (Model.Items.Count > 0)
        {
            <div id="wishlistGrid"
                 class="grid grid-cols-2 gap-4 sm:grid-cols-2 md:gap-5 xl:grid-cols-4">

                @foreach (var item in Model.Items)
                {
                    <article class="wishlist-product-card group flex min-w-0 flex-col overflow-hidden rounded-xl border border-gray-100 bg-white transition hover:-translate-y-1 hover:shadow-lg"
                             data-product-card
                             data-product-name="@item.Name"
                             data-product-price="@item.Price"
                             data-product-image="@Url.Content(item.ImageUrl)"
                             data-product-slug="@item.Slug"
                             data-wishlist-card-id="@item.Id">

                        <!-- Image -->
                        <div class="relative aspect-square overflow-hidden bg-[#F7F9F5]">

                            <a href="/product/@item.Slug"
                               class="flex h-full w-full items-center justify-center p-4">

                                <img src="@Url.Content(item.ImageUrl)"
                                     alt="@item.Name"
                                     loading="lazy"
                                     class="h-full w-full object-contain transition duration-500 group-hover:scale-105" />
                            </a>

                            <!-- Remove wishlist -->
                            <button type="button"
                                    data-wishlist-product-id="@item.Id"
                                    aria-label="Xóa @item.Name khỏi yêu thích"
                                    aria-pressed="true"
                                    class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-white text-red-500 shadow-sm transition hover:bg-red-50">
                                <i class="ph-fill ph-heart text-lg"></i>
                            </button>

                            @if (!item.IsAvailable)
                            {
                                <span class="absolute bottom-3 left-3 rounded-full bg-gray-800/80 px-3 py-1 text-xs font-medium text-white">
                                    Tạm hết hàng
                                </span>
                            }
                        </div>

                        <!-- Content -->
                        <div class="flex flex-1 flex-col p-3 sm:p-4">

                            <p class="mb-1 text-[11px] font-medium text-[#1F9345]">
                                @item.CategoryName
                            </p>

                            <h3 class="line-clamp-2 min-h-10 text-sm font-semibold leading-5 text-gray-900 transition group-hover:text-[#1F9345] sm:text-base">
                                <a href="/product/@item.Slug">
                                    @item.Name
                                </a>
                            </h3>

                            <div class="mt-2 flex items-center gap-1.5 text-xs">
                                <span class="text-amber-400">
                                    <i class="ph-fill ph-star"></i>
                                </span>

                                <span class="font-semibold text-gray-700">
                                    @item.Rating.ToString("0.0")
                                </span>

                                <span class="text-gray-400">
                                    (@item.ReviewCount)
                                </span>
                            </div>

                            <p class="mt-2 text-xs text-gray-500">
                                Dung tích:
                                <span class="font-medium text-gray-700">
                                    @item.Volume
                                </span>
                            </p>

                            <div class="mt-3 flex flex-wrap items-baseline gap-2">
                                <span class="text-base font-bold text-[#1F9345]">
                                    @item.Price.ToString("N0")đ
                                </span>

                                @if (item.OriginalPrice.HasValue &&
                                                        item.OriginalPrice.Value > item.Price)
                                {
                                    <span class="text-xs text-gray-400 line-through">
                                        @item.OriginalPrice.Value.ToString("N0")đ
                                    </span>
                                }
                            </div>

                            <div class="mt-auto pt-4">
                                @if (item.IsAvailable)
                                {
                                    <button type="button"
                                            data-add-to-cart
                                            data-product-id="@item.Id"
                                            class="flex w-full items-center justify-center gap-2 rounded-lg bg-[#1F9345] px-3 py-2.5 text-xs font-semibold text-white transition hover:bg-[#18783A] sm:text-sm">
                                        <i class="ph ph-shopping-cart-simple text-base"></i>
                                        Thêm vào giỏ
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            disabled
                                            class="flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-lg bg-gray-100 px-3 py-2.5 text-xs font-semibold text-gray-400 sm:text-sm">
                                        Tạm hết hàng
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
            <div id="wishlistEmpty"
                 class="@(Model.Items.Count == 0 ? "" : "hidden") rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-6 py-16 text-center">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                    <i class="ph ph-heart text-4xl"></i>
                </div>

                <h2 class="mt-5 text-lg font-bold text-gray-900">
                    Danh sách yêu thích đang trống
                </h2>

                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500">
                    Hãy khám phá các sản phẩm Caterin và lưu lại những sản phẩm
                    bạn muốn mua sau nhé.
                </p>

                <a href="/shop"
                   class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-[#1F9345] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#18783A]">
                    Khám phá sản phẩm
                    <i class="ph ph-arrow-right"></i>
                </a>
            </div>
        }
        else
        {
            <!-- Empty state -->
            <div id="wishlistEmpty"
                 class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-6 py-16 text-center">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#EAF5E7] text-[#1F9345]">
                    <i class="ph ph-heart text-4xl"></i>
                </div>

                <h2 class="mt-5 text-lg font-bold text-gray-900">
                    Danh sách yêu thích đang trống
                </h2>

                <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500">
                    Hãy khám phá các sản phẩm Caterin và lưu lại những sản phẩm
                    bạn muốn mua sau nhé.
                </p>

                <a href="/shop"
                   class="mt-6 inline-flex items-center justify-center gap-2 rounded-lg bg-[#1F9345] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#18783A]">
                    Khám phá sản phẩm
                    <i class="ph ph-arrow-right"></i>
                </a>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/shop/wishlist-page.js" asp-append-version="true"></script>
}